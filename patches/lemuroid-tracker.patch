@@ -0,0 +1,107 @@
+package com.swordfish.lemuroid.app.mobile.feature.runs
+
+import android.content.Context
+import org.json.JSONObject
+import java.io.File
+
+/** One saved SMZ3 run. [gameId] points at the ROM in the Lemuroid library; the summary is refreshed while the run is played. */
+data class Run(
+    val slot: Int,
+    val name: String,
+    val gameId: Int,
+    val createdAt: Long,
+    val lastPlayedAt: Long = 0,
+    val playTimeMs: Long = 0,
+    val game: Int = 0,
+    val zeldaCleared: Int = 0,
+    val zeldaTotal: Int = 0,
+    val metroidCleared: Int = 0,
+    val metroidTotal: Int = 0,
+    val logic: String = "Normal",
+    val keysanity: Boolean = false,
+    val romPath: String = "",
+    val seed: String = "",
+    val settings: String = "{}",
+    /** "all": the whole map is shown with the missing items; "discovered": only the parts and items found so far. */
+    val mapMode: String = "all",
+)
+
+/** Four run slots, each a small JSON file in the app's private storage. */
+object RunStore {
+    const val SLOTS = 4
+
+    /** Slot of the run being played; the tracker (which runs in the game process) writes its progress into it. */
+    fun setActiveSlot(context: Context, slot: Int?) {
+        val f = File(File(context.filesDir, "runs").apply { mkdirs() }, "active")
+        if (slot == null) f.delete() else f.writeText(slot.toString())
+    }
+
+    fun activeSlot(context: Context): Int? =
+        File(File(context.filesDir, "runs"), "active").takeIf { it.exists() }?.readText()?.trim()?.toIntOrNull()
+
+    private fun file(context: Context, slot: Int) = File(File(context.filesDir, "runs").apply { mkdirs() }, "slot$slot.json")
+
+    fun load(context: Context, slot: Int): Run? {
+        val f = file(context, slot)
+        if (!f.exists()) return null
+        return runCatching {
+            JSONObject(f.readText()).let {
+                Run(
+                    slot = slot,
+                    name = it.getString("name"),
+                    gameId = it.getInt("gameId"),
+                    createdAt = it.getLong("createdAt"),
+                    lastPlayedAt = it.optLong("lastPlayedAt"),
+                    playTimeMs = it.optLong("playTimeMs"),
+                    game = it.optInt("game"),
+                    zeldaCleared = it.optInt("zeldaCleared"),
+                    zeldaTotal = it.optInt("zeldaTotal"),
+                    metroidCleared = it.optInt("metroidCleared"),
+                    metroidTotal = it.optInt("metroidTotal"),
+                    logic = it.optString("logic", "Normal"),
+                    keysanity = it.optBoolean("keysanity"),
+                    romPath = it.optString("romPath"),
+                    seed = it.optString("seed"),
+                    settings = it.optString("settings", "{}"),
+                    mapMode = it.optString("mapMode", "all"),
+                )
+            }
+        }.getOrNull()
+    }
+
+    fun loadAll(context: Context): List<Run?> = (0 until SLOTS).map { load(context, it) }
+
+    @Synchronized
+    fun save(context: Context, run: Run) {
+        val json = JSONObject()
+            .put("name", run.name).put("gameId", run.gameId).put("createdAt", run.createdAt)
+            .put("lastPlayedAt", run.lastPlayedAt).put("playTimeMs", run.playTimeMs).put("game", run.game)
+            .put("zeldaCleared", run.zeldaCleared).put("zeldaTotal", run.zeldaTotal)
+            .put("metroidCleared", run.metroidCleared).put("metroidTotal", run.metroidTotal)
+            .put("logic", run.logic).put("keysanity", run.keysanity)
+            .put("romPath", run.romPath).put("seed", run.seed).put("settings", run.settings).put("mapMode", run.mapMode)
+        file(context, run.slot).writeText(json.toString())
+    }
+
+    fun discoveryFile(context: Context, slot: Int) = File(File(context.filesDir, "runs").apply { mkdirs() }, "slot$slot.disc.json")
+
+    private fun romDir(context: Context) = File(context.filesDir, "runs").apply { mkdirs() }
+
+    /** The slot's ROM: the file named in its run (see [romName]) or, for runs made before stable names, the slot file. */
+    fun romFile(context: Context, slot: Int): File {
+        val path = load(context, slot)?.romPath.orEmpty()
+        return if (path.isNotEmpty()) File(path) else File(romDir(context), "smz3_run_$slot.sfc")
+    }
+
+    /** The stable ROM name is computed by the shared C code (core/ui) so every device agrees on it. */
+    fun romName(seed: String, settingsJson: String) = com.swordfish.lemuroid.app.shared.game.viewmodel.Smz3Native.romName(settingsJson, seed)
+
+    fun newRomFile(context: Context, seed: String, settingsJson: String) = File(romDir(context), romName(seed, settingsJson))
+
+    fun delete(context: Context, slot: Int) {
+        val rom = romFile(context, slot)
+        file(context, slot).delete()
+        rom.delete()
+        discoveryFile(context, slot).delete()
+    }
+}
