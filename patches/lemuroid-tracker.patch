+++ b/lemuroid-app/src/main/java/com/swordfish/lemuroid/app/shared/game/viewmodel/Smz3Help.kt
@@ -0,0 +1,107 @@
+package com.swordfish.lemuroid.app.shared.game.viewmodel
+
+import android.content.Context
+import com.swordfish.lemuroid.app.mobile.feature.runs.RunGenerator
+import com.swordfish.lemuroid.app.mobile.feature.runs.RunStore
+import org.json.JSONArray
+import org.json.JSONObject
+import java.io.File
+
+/** What the player may see and ask for in the current run: set when the run is created ("helpMode"). */
+data class HelpInfo(
+    /** "all": hint tiles, remaining checks on the map and unlimited hints; "limited": only what is asked for; "none". */
+    val mode: String = "all",
+    val total: Int = 0,
+    val used: Int = 0,
+    /** Hints already given, oldest first. */
+    val hints: List<String> = emptyList(),
+    /** Tracker location indices whose pending check was revealed on request. */
+    val revealed: Set<Int> = emptySet(),
+) {
+    val left get() = if (mode == "limited") (total - used).coerceAtLeast(0) else Int.MAX_VALUE
+    val canAsk get() = mode == "all" || (mode == "limited" && used < total)
+
+    /** Pending checks may be drawn: null shows all of them, otherwise only the revealed ones. */
+    val visibleChecks: Set<Int>? get() = if (mode == "all") null else revealed
+}
+
+/** Hints and reveals the player asked for, kept next to the run so they survive restarts. */
+object Smz3Help {
+    private var slot: Int? = null
+    private var info = HelpInfo()
+    private var texts: Array<String?>? = null
+
+    @Synchronized
+    fun current(): HelpInfo = info
+
+    private fun file(context: Context, slot: Int) = File(File(context.filesDir, "runs").apply { mkdirs() }, "slot$slot.help.json")
+
+    /** Loads the run's help mode and what was already asked. */
+    @Synchronized
+    fun select(context: Context, slotNow: Int?) {
+        if (slotNow == slot) return
+        slot = slotNow
+        texts = null
+        info = HelpInfo()
+        val run = slotNow?.let { RunStore.load(context, it) } ?: return
+        val s = runCatching { JSONObject(run.settings.ifBlank { "{}" }) }.getOrDefault(JSONObject())
+        var next = HelpInfo(mode = s.optString("helpMode", "all"), total = s.optInt("helpCount", 3))
+        runCatching {
+            val saved = JSONObject(file(context, slotNow).readText())
+            val hints = saved.optJSONArray("hints") ?: JSONArray()
+            val revealed = saved.optJSONArray("revealed") ?: JSONArray()
+            next = next.copy(
+                used = saved.optInt("used"),
+                hints = List(hints.length()) { hints.getString(it) },
+                revealed = (0 until revealed.length()).map { revealed.getInt(it) }.toSet(),
+            )
+        }
+        info = next
+    }
+
+    private fun persist(context: Context) {
+        val s = slot ?: return
+        val json = JSONObject().put("used", info.used).put("hints", JSONArray(info.hints)).put("revealed", JSONArray(info.revealed.toList()))
+        file(context, s).writeText(json.toString())
+    }
+
+    private val textsLock = Any()
+
+    /** The 15 hints of the run (a few seconds of native work the first time). Never call this while holding the state lock. */
+    private fun hintTexts(context: Context, s: Int): Array<String?>? = synchronized(textsLock) {
+        texts?.let { return it }
+        val run = RunStore.load(context, s) ?: return null
+        val settings = JSONObject(run.settings.ifBlank { "{}" })
+        val (names, values) = RunGenerator.logicNames(settings)
+        val start = System.currentTimeMillis()
+        Smz3Native.helpTexts(RunGenerator.nativeParams(settings, run.seed.toIntOrNull() ?: 0), names, values, RunGenerator.plandoBytes(settings)).also {
+            texts = it
+            timber.log.Timber.i("SMZ3 help hints ready in ${System.currentTimeMillis() - start} ms")
+        }
+    }
+
+    /** The next hint, or null when none may be asked (no helps left, or all 15 were given). Slow the first time: call off the main thread. */
+    fun askHint(context: Context): String? {
+        val (s, next) = synchronized(this) {
+            val s = slot ?: return null
+            if (!info.canAsk || info.hints.size >= 15) return null
+            s to info.hints.size
+        }
+        val text = hintTexts(context, s)?.getOrNull(next)?.takeIf { it.isNotBlank() } ?: return null
+        synchronized(this) {
+            if (slot != s || info.hints.size != next || !info.canAsk) return null
+            info = info.copy(used = if (info.mode == "limited") info.used + 1 else info.used, hints = info.hints + text)
+            persist(context)
+        }
+        return text
+    }
+
+    /** Shows the pending checks of one region on the map and in the list; costs one help in the limited mode. */
+    @Synchronized
+    fun reveal(context: Context, locations: List<Int>): Boolean {
+        if (!info.canAsk) return false
+        info = info.copy(used = if (info.mode == "limited") info.used + 1 else info.used, revealed = info.revealed + locations)
+        persist(context)
+        return true
+    }
+}
diff --git a/lemuroid-app/src/main/java/com/swordfish/lemuroid/app/shared/game/viewmodel/Smz3Hotkeys.kt b/lemuroid-app/src/main/java/com/swordfish/lemuroid/app/shared/game/viewmodel/Smz3Hotkeys.kt
