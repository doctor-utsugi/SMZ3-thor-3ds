+package com.swordfish.lemuroid.app.shared.game.viewmodel
+
+import android.graphics.Color
+import android.graphics.Typeface
+
+/** Look of the bottom screen. It follows the game being played: Zelda parchment-and-gold, Super Metroid visor. */
+internal class Smz3Theme(
+    val background: Int,
+    val panel: Int,
+    val accent: Int,
+    val text: Int,
+    val dim: Int,
+    val bar: Int,
+    val tabSelected: Int,
+    val pending: Int,
+    val done: Int,
+    val typeface: Typeface,
+    val title: String,
+) {
+    companion object {
+        val ZELDA = Smz3Theme(
+            background = Color.parseColor("#14231A"),
+            panel = Color.parseColor("#1F3A24"),
+            accent = Color.parseColor("#E8C14A"),
+            text = Color.parseColor("#F3EBC8"),
+            dim = Color.parseColor("#A8A27A"),
+            bar = Color.parseColor("#5BBF6A"),
+            tabSelected = Color.parseColor("#2B4A30"),
+            pending = Color.parseColor("#FFD54A"),
+            done = Color.parseColor("#7BE08A"),
+            typeface = Typeface.create(Typeface.SERIF, Typeface.BOLD),
+            title = "HYRULE",
+        )
+
+        val METROID = Smz3Theme(
+            background = Color.parseColor("#05080C"),
+            panel = Color.parseColor("#0C1A24"),
+            accent = Color.parseColor("#FF9A1F"),
+            text = Color.parseColor("#D8F6FF"),
+            dim = Color.parseColor("#5E8DA0"),
+            bar = Color.parseColor("#19D3C5"),
+            tabSelected = Color.parseColor("#13303F"),
+            pending = Color.parseColor("#FF9A1F"),
+            done = Color.parseColor("#19D3C5"),
+            typeface = Typeface.create(Typeface.MONOSPACE, Typeface.BOLD),
+            title = "ZEBES",
+        )
+
+        fun forGame(game: Int, fallback: Smz3Theme) = when (game) {
+            1 -> ZELDA
+            2 -> METROID
+            else -> fallback
+        }
+    }
+}
diff --git a/lemuroid-app/src/main/java/com/swordfish/lemuroid/app/shared/game/viewmodel/Smz3Tracker.kt b/lemuroid-app/src/main/java/com/swordfish/lemuroid/app/shared/game/viewmodel/Smz3Tracker.kt
new file mode 100644
index 0000000..e618586
--- /dev/null
+++ b/lemuroid-app/src/main/java/com/swordfish/lemuroid/app/shared/game/viewmodel/Smz3Tracker.kt
@@ -0,0 +1,225 @@
+package com.swordfish.lemuroid.app.shared.game.viewmodel
+
+import android.app.Presentation
+import android.content.Context
+import android.graphics.Color
+import android.hardware.display.DisplayManager
+import android.os.Bundle
+import android.os.Handler
+import android.os.Looper
+import android.os.SystemClock
+import android.view.Display
+import android.view.Gravity
+import android.view.ViewGroup
+import android.widget.LinearLayout
+import android.widget.ProgressBar
+import android.widget.TextView
+import com.swordfish.lemuroid.app.mobile.feature.runs.RunGenerator
+import com.swordfish.lemuroid.app.mobile.feature.runs.RunKeys
+import com.swordfish.lemuroid.app.mobile.feature.runs.RunLogic
+import com.swordfish.lemuroid.app.mobile.feature.runs.RunStore
+import com.swordfish.libretrodroid.GLRetroView
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.isActive
+import kotlinx.coroutines.launch
+import timber.log.Timber
+
+data class Smz3Snapshot(
+    val game: Int,
+    val started: Boolean,
+    val zeldaCleared: Int,
+    val zeldaTotal: Int,
+    val metroidCleared: Int,
+    val metroidTotal: Int,
+    val recent: List<String>,
+    val elapsedMs: Long,
+    val cleared: Set<Int>,
+    val inventory: IntArray,
+    val inLogic: Set<Int>?,
+    val position: MapPosition? = null,
+    val seen: List<android.graphics.RectF> = emptyList(),
+    val discoveredOnly: Boolean = false,
+    val bosses: List<BossMark> = emptyList(),
+    val help: HelpInfo = HelpInfo(),
+    val areaBox: android.graphics.RectF? = null,
+)
+
+/** Reads SMZ3 memory from the running core and shows the run on the secondary display (the AYN Thor's bottom screen). */
+object Smz3Tracker {
+    private const val WRAM_SIZE = 0x20000
+    private const val SRAM_SIZE = 0x100000
+    private const val MAX_RECENT = 8
+
+    private val main = Handler(Looper.getMainLooper())
+    private var presentation: Smz3Presentation? = null
+    private var pendingPlayTime = 0L
+    private var lastPad = 0
+    private var lastSmState = -1
+
+    fun start(scope: CoroutineScope, view: GLRetroView) {
+        val context = view.context
+        val displays = context.getSystemService(Context.DISPLAY_SERVICE) as DisplayManager
+        displays.registerDisplayListener(
+            object : DisplayManager.DisplayListener {
+                override fun onDisplayAdded(displayId: Int) = main.post { showOnSecondary(context) }.let { }
+
+                override fun onDisplayRemoved(displayId: Int) = main.post { dismiss() }.let { }
+
+                override fun onDisplayChanged(displayId: Int) = Unit
+            },
+            main,
+        )
+        main.post { showOnSecondary(context) }
+        // Screen shape: the config tab's choice wins over the one the run was created with.
+        val runShape = RunStore.activeSlot(context)?.let { RunStore.load(context, it) }
+            ?.let { runCatching { org.json.JSONObject(it.settings).optString("screenShape", "original") }.getOrNull() }
+        view.aspectRatioOverride = Smz3Hotkeys.aspect(Smz3Hotkeys.shape(context) ?: runShape ?: "original")
+
+        scope.launch(Dispatchers.Default) {
+            var seen = emptySet<Int>()
+            val recent = ArrayDeque<String>()
+            var startedAt = 0L
+            var lastTick = SystemClock.elapsedRealtime()
+            var saveCountdown = 0
+            var lastFrame = -1
+            val itemNames = List(Smz3Native.inventoryCount()) { Smz3Native.inventoryInfo(it).split("|")[1] }
+            var logicKey = ""
+            var inLogic: Set<Int>? = null
+            var logicCountdown = 0
+            val inventoryCache = IntArray(Smz3Native.inventoryCount())
+            val discovery = Smz3Discovery(context)
+            var discoverySlot: Int? = null
+            var seenRects = emptyList<android.graphics.RectF>()
+            var seenCount = -1
+            var discoveredOnly = false
+            while (isActive) {
+                delay(500)
+                val wram = view.readMemory(GLRetroView.MEMORY_SYSTEM_RAM, 0, WRAM_SIZE)
+                if (wram.size > 0x8D) {
+                    val pad = (wram[0x8B].toInt() and 0xFF) or ((wram[0x8C].toInt() and 0xFF) shl 8)
+                    val sm = (wram[0x998].toInt() and 0xFF) or ((wram[0x999].toInt() and 0xFF) shl 8)
+                    if (sm != lastSmState) { lastSmState = sm; Timber.i("SMZ3 SM game state \$0998 = %04x frame \$05B6 = %02x".format(sm, wram[0x5B6])) }
+                    if (pad != lastPad) { lastPad = pad; Timber.i("SMZ3 SM pad word \$8B = %04x".format(pad)) }
+                }
+                val sram = view.readMemory(GLRetroView.MEMORY_SAVE_RAM, 0, SRAM_SIZE)
+                // Both games bump a frame counter every frame (ALttP 0x7E001A, Super Metroid 0x7E05B6): when it does
+                // not move between two reads the emulator is paused or in the background, so no play time is counted.
+                val frame = if (wram.size > 0x05B6) (wram[0x1A].toInt() and 0xFF) or ((wram[0x05B6].toInt() and 0xFF) shl 8) else -1
+                val running = frame != lastFrame
+                lastFrame = frame
+                val s = Smz3Native.summarize(wram, sram)
+                val cleared = Smz3Native.clearedLocations(wram, sram).toSet()
+
+                val started = s[1] != 0
+                if (started && startedAt == 0L) startedAt = SystemClock.elapsedRealtime()
+                if (!started) startedAt = 0L
+                if (seen.isNotEmpty() || recent.isNotEmpty() || started) {
+                    for (i in cleared - seen) {
+                        recent.addFirst(Smz3Native.locationName(i))
+                        while (recent.size > MAX_RECENT) recent.removeLast()
+                    }
+                }
+                seen = cleared
+                val inv = Smz3Native.inventory(wram, sram)
+                for (i in inv.indices) if (inv[i] >= 0 && i < inventoryCache.size) inventoryCache[i] = inv[i]
+
+                if (started && Smz3Help.current().mode == "all" && --logicCountdown <= 0) {
+                    logicCountdown = 6
+                    val run = RunStore.activeSlot(context)?.let { RunStore.load(context, it) }
+                    val settings = run?.settings ?: "{}"
+                    val keysanity = runCatching { org.json.JSONObject(settings.ifBlank { "{}" }).optString("keysanity", "None") }.getOrDefault("None")
+                    val items = RunLogic.items(itemNames, inventoryCache) + RunKeys.items(wram, sram, s[0], keysanity)
+                    val key = (run?.seed ?: "") + settings + items.sorted().joinToString(",")
+                    if (key != logicKey && run != null) {
+                        logicKey = key
+                        inLogic = RunLogic.reachable(run.seed, settings, items)
+                        Timber.i("SMZ3 logic keysanity=$keysanity items=${items.size} keys=${items.count { it.startsWith("Key") || it.startsWith("BigKey") || it.startsWith("Card") }} inLogic=${inLogic?.size}")
+                    }
+                }
+
+                val slotNow = RunStore.activeSlot(context)
+                Smz3Help.select(context, slotNow)
+                val help = Smz3Help.current()
+                if (slotNow != discoverySlot) {
+                    discoverySlot = slotNow
+                    slotNow?.let {
+                        discovery.load(RunStore.discoveryFile(context, it))
+                        discoveredOnly = RunStore.load(context, it)?.mapMode == "discovered"
+                    }
+                    seenCount = -1
+                }
+                if (started && slotNow != null) {
+                    discovery.update(wram, s[0])
+                    val count = discovery.rooms.size + discovery.screens.size + discovery.dungeons.size
+                    if (count != seenCount) {
+                        seenCount = count
+                        seenRects = discovery.rects()
+                        discovery.saveIfChanged(RunStore.discoveryFile(context, slotNow))
+                    }
+                }
+
+                val snapshot = Smz3Snapshot(
+                    game = s[0], started = started,
+                    zeldaCleared = s[2], zeldaTotal = s[3],
+                    metroidCleared = s[4], metroidTotal = s[5],
+                    recent = recent.toList(),
+                    elapsedMs = if (startedAt == 0L) 0 else SystemClock.elapsedRealtime() - startedAt,
+                    cleared = cleared,
+                    inventory = inventoryCache.copyOf(),
+                    inLogic = if (help.mode == "all") inLogic else null,   // which checks are in logic is a help too
+                    help = help,
+                    position = discovery.position,
+                    areaBox = discovery.areaBox(s[0]),
+                    seen = seenRects,
+                    discoveredOnly = discoveredOnly,
+                    bosses = if (started && slotNow != null) Smz3Bosses.marks(wram, discovery) else emptyList(),
+                )
+                main.post { presentation?.render(snapshot) }
+
+                val now = SystemClock.elapsedRealtime()
+                val delta = now - lastTick
+                lastTick = now
+                RunStore.activeSlot(context)?.let { slot ->
+                    if (started && running) pendingPlayTime += delta
+                    if (--saveCountdown <= 0) {
+                        saveCountdown = 10
+                        RunStore.load(context, slot)?.let { run ->
+                            RunStore.save(
+                                context,
+                                run.copy(
+                                    lastPlayedAt = System.currentTimeMillis(),
+                                    playTimeMs = run.playTimeMs + pendingPlayTime,
+                                    game = if (started) s[0] else run.game,
+                                    zeldaCleared = if (started) s[2] else run.zeldaCleared,
+                                    zeldaTotal = s[3],
+                                    metroidCleared = if (started) s[4] else run.metroidCleared,
+                                    metroidTotal = s[5],
+                                ),
+                            )
+                            pendingPlayTime = 0
+                        }
+                    }
+                }
+                fun hex(a: ByteArray, o: Int, n: Int) = (o until o + n).joinToString("") { "%02x".format(a[it]) }
+                Timber.i("SMZ3 mem sram340=" + hex(sram, 0x340, 0x50) + " sram3b40=" + hex(sram, 0x3B40, 0x50) + " sram3f50=" + hex(sram, 0x3F50, 0x10) + " sram3970=" + hex(sram, 0x3970, 2) + " wramF340=" + hex(wram, 0xF340, 0x50) + " wramF4E0=" + hex(wram, 0xF4E0, 0x10) + " wramD830=" + hex(wram, 0xD830, 2))
+                Timber.i("SMZ3 game=${s[0]} started=$started zelda=${s[2]}/${s[3]} metroid=${s[4]}/${s[5]} nmi=%d room=%04x x=%d y=%d zmod=%02x zroom=%04x zx=%d zy=%d pose=%04x mv=%04x shots=%d".format((wram[0x5B6].toInt() and 0xFF) or ((wram[0x5B7].toInt() and 0xFF) shl 8), (wram[0x79B].toInt() and 0xFF) or ((wram[0x79C].toInt() and 0xFF) shl 8), (wram[0xAF6].toInt() and 0xFF) or ((wram[0xAF7].toInt() and 0xFF) shl 8), (wram[0xAFA].toInt() and 0xFF) or ((wram[0xAFB].toInt() and 0xFF) shl 8), wram[0x10], (wram[0xA0].toInt() and 0xFF) or ((wram[0xA1].toInt() and 0xFF) shl 8), (wram[0x22].toInt() and 0xFF) or ((wram[0x23].toInt() and 0xFF) shl 8), (wram[0x20].toInt() and 0xFF) or ((wram[0x21].toInt() and 0xFF) shl 8), (wram[0xA1C].toInt() and 0xFF) or ((wram[0xA1D].toInt() and 0xFF) shl 8), (wram[0xA1E].toInt() and 0xFF) or ((wram[0xA1F].toInt() and 0xFF) shl 8), (wram[0xCCE].toInt() and 0xFF) or ((wram[0xCCF].toInt() and 0xFF) shl 8)))
+            }
+        }
+    }
+
+    private fun showOnSecondary(context: Context) {
+        if (presentation != null) return
+        val displays = context.getSystemService(Context.DISPLAY_SERVICE) as DisplayManager
+        val target = displays.getDisplays(DisplayManager.DISPLAY_CATEGORY_PRESENTATION).firstOrNull() ?: return
+        runCatching {
+            presentation = Smz3Presentation(context, target).also { it.show() }
+        }.onFailure { Timber.e(it, "Cannot show the SMZ3 tracker on display ${target.displayId}") }
+    }
+
+    private fun dismiss() {
+        presentation?.dismiss()
+        presentation = null
+    }
+}
