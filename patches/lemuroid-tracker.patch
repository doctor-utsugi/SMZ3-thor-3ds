@@ -0,0 +1,97 @@
+package com.swordfish.lemuroid.app.shared.game.viewmodel
+
+import android.animation.ValueAnimator
+import android.app.Presentation
+import android.content.Context
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.LinearGradient
+import android.graphics.Paint
+import android.graphics.Shader
+import android.hardware.display.DisplayManager
+import android.os.Bundle
+import android.view.Display
+import android.view.View
+import android.view.ViewGroup
+import android.view.animation.LinearInterpolator
+import kotlin.math.PI
+import kotlin.math.sin
+import kotlin.random.Random
+
+/** Decorative waiting screen for the secondary display while no game is running: a drifting starfield under the title. */
+internal class Smz3IdlePresentation(context: Context, display: Display) : Presentation(context, display) {
+    private var animator: ValueAnimator? = null
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        window?.setBackgroundDrawable(android.graphics.drawable.ColorDrawable(Color.BLACK))
+        window?.clearFlags(android.view.WindowManager.LayoutParams.FLAG_DIM_BEHIND)
+        val view = IdleView(context)
+        setContentView(view, ViewGroup.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT))
+        animator = ValueAnimator.ofFloat(0f, 1f).apply {
+            duration = 12000
+            repeatCount = ValueAnimator.INFINITE
+            interpolator = LinearInterpolator()
+            addUpdateListener { view.phase = it.animatedValue as Float; view.invalidate() }
+            start()
+        }
+    }
+
+    override fun onStop() {
+        animator?.cancel()
+        super.onStop()
+    }
+
+    private class IdleView(context: Context) : View(context) {
+        var phase = 0f
+        private val rnd = Random(7)
+        private val stars = List(90) { floatArrayOf(rnd.nextFloat(), rnd.nextFloat(), 0.3f + rnd.nextFloat() * 0.7f) }
+        private val paint = Paint(Paint.ANTI_ALIAS_FLAG)
+        private val density = context.resources.displayMetrics.density
+
+        override fun onDraw(canvas: Canvas) {
+            val w = width.toFloat()
+            val h = height.toFloat()
+            paint.shader = LinearGradient(0f, 0f, 0f, h, Color.parseColor("#0B1A12"), Color.parseColor("#05080C"), Shader.TileMode.CLAMP)
+            canvas.drawRect(0f, 0f, w, h, paint)
+            paint.shader = null
+            paint.alpha = 255
+            for (s in stars) {
+                val y = (s[1] + phase * s[2]) % 1f
+                val twinkle = 0.5f + 0.5f * sin((phase * 6f * s[2] + s[0] * 10f) * 2f * PI.toFloat())
+                paint.color = Color.argb((90 + 150 * twinkle * s[2]).toInt().coerceIn(0, 255), 243, 235, 200)
+                canvas.drawCircle(s[0] * w, y * h, (1f + 1.6f * s[2]) * density, paint)
+            }
+            paint.textAlign = Paint.Align.CENTER
+            paint.color = Color.parseColor("#E8C14A")
+            paint.typeface = android.graphics.Typeface.create(android.graphics.Typeface.SERIF, android.graphics.Typeface.BOLD)
+            paint.textSize = 44f * density
+            canvas.drawText("SMZ3", w / 2f, h * 0.45f, paint)
+            paint.color = Color.parseColor("#FF9A1F")
+            paint.textSize = 15f * density
+            canvas.drawText("A LINK TO THE PAST  ·  SUPER METROID", w / 2f, h * 0.45f + 30f * density, paint)
+            val pulse = 0.45f + 0.55f * (0.5f + 0.5f * sin(phase * 6f * 2f * PI.toFloat()))
+            paint.color = Color.argb((255 * pulse).toInt(), 216, 246, 255)
+            paint.typeface = android.graphics.Typeface.DEFAULT
+            paint.textSize = 16f * density
+            canvas.drawText("Waiting for a game...", w / 2f, h * 0.75f, paint)
+        }
+    }
+}
+
+/** Keeps at most one idle presentation, shown while the run menu is in front. */
+internal object Smz3Idle {
+    private var presentation: Smz3IdlePresentation? = null
+
+    fun show(context: Context) {
+        if (presentation != null) return
+        val displays = context.getSystemService(Context.DISPLAY_SERVICE) as DisplayManager
+        val target = displays.getDisplays(DisplayManager.DISPLAY_CATEGORY_PRESENTATION).firstOrNull() ?: return
+        runCatching { presentation = Smz3IdlePresentation(context, target).also { it.show() } }
+    }
+
+    fun hide() {
+        runCatching { presentation?.dismiss() }
+        presentation = null
+    }
+}
diff --git a/lemuroid-app/src/main/java/com/swordfish/lemuroid/app/shared/game/viewmodel/Smz3MapView.kt b/lemuroid-app/src/main/java/com/swordfish/lemuroid/app/shared/game/viewmodel/Smz3MapView.kt
