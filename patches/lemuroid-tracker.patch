+package com.swordfish.lemuroid.app.mobile.feature.runs
+
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+class RunLogicItemsTest {
+    @Test
+    fun levelsBecomeRepeatedItemTypes() {
+        val names = listOf("Sword", "Gloves", "Bottles", "Bow", "Missiles", "Energy Tanks", "Varia", "Reserve")
+        val levels = intArrayOf(3, 2, 2, 1, 15, 4, 1, 200)
+        val got = RunLogic.items(names, levels).groupingBy { it }.eachCount()
+        assertEquals(3, got["ProgressiveSword"])
+        assertEquals(2, got["ProgressiveGlove"])
+        assertEquals(2, got["Bottle"])
+        assertEquals(1, got["Bow"])
+        assertEquals(3, got["Missile"])        // 15 missiles = 3 packs
+        assertEquals(4, got["ETank"])
+        assertEquals(1, got["Varia"])
+        assertEquals(2, got["ReserveTank"])    // 200 reserve = 2 tanks
+    }
+
+    @Test
+    fun absentItemsAreSkipped() {
+        assertEquals(emptyList<String>(), RunLogic.items(listOf("Hookshot", "Morph Ball"), intArrayOf(0, -1)))
+    }
+}
diff --git a/lemuroid-app/src/test/java/com/swordfish/lemuroid/app/shared/game/viewmodel/Smz3RoomFilterTest.kt b/lemuroid-app/src/test/java/com/swordfish/lemuroid/app/shared/game/viewmodel/Smz3RoomFilterTest.kt
new file mode 100644
index 0000000..3adef3f
--- /dev/null
+++ b/lemuroid-app/src/test/java/com/swordfish/lemuroid/app/shared/game/viewmodel/Smz3RoomFilterTest.kt
@@ -0,0 +1,48 @@
+package com.swordfish.lemuroid.app.shared.game.viewmodel
+
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+class Smz3RoomFilterTest {
+    private val kraid = 0xA59F
+    private val parlor = 0x92FD
+
+    private fun run(filter: Smz3RoomFilter, samples: List<Pair<Int, Int>>) = samples.map { (state, room) -> filter.accept(state, room) }
+
+    @Test
+    fun portalReturnWithStaleKraidRoomIsRejectedThenParlorAccepted() {
+        // The logged sequence after a Zelda to SM return: the stale room for 1-3 samples (game state not 8 yet, or 8 for
+        // one sample), then the real room.
+        for (stale in 1..3) {
+            val samples = List(stale) { 0x0B to kraid } + listOf(8 to kraid) + List(3) { 8 to parlor }
+            val filter = Smz3RoomFilter()
+            val accepted = run(filter, samples).zip(samples).filter { it.first }.map { it.second.second }
+            assertEquals("stale=$stale", listOf(parlor, parlor), accepted)
+        }
+    }
+
+    @Test
+    fun staleRoomSeenOnceInNormalGameplayIsRejected() {
+        val filter = Smz3RoomFilter()
+        assertEquals(listOf(false, false, true), run(filter, listOf(8 to kraid, 8 to parlor, 8 to parlor)))
+    }
+
+    @Test
+    fun legitimateRoomChangeIsAcceptedOnTheSecondSample() {
+        val filter = Smz3RoomFilter()
+        val out = run(filter, listOf(8 to parlor, 8 to parlor, 8 to parlor, 8 to kraid, 8 to kraid))
+        assertEquals(listOf(false, true, true, false, true), out)
+    }
+
+    @Test
+    fun nothingIsAcceptedOutsideNormalGameplay() {
+        val filter = Smz3RoomFilter()
+        assertEquals(listOf(false, false, false), run(filter, listOf(6 to parlor, 7 to parlor, 0x0A to parlor)))
+    }
+
+    @Test
+    fun leavingGameplayResetsTheCount() {
+        val filter = Smz3RoomFilter()
+        assertEquals(listOf(false, false, false), run(filter, listOf(8 to parlor, 0x0B to parlor, 8 to parlor)))
+    }
+}
