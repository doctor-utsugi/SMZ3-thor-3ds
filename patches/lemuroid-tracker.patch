+package com.swordfish.lemuroid.app.mobile.feature.runs
+
+import android.content.Context
+import android.text.format.DateFormat
+import java.util.Date
+
+/** Two-line text for a run: checks cleared, play time, where it was left and when. */
+internal fun summary(context: Context, run: Run): String {
+    val sec = run.playTimeMs / 1000
+    val time = "%d:%02d:%02d".format(sec / 3600, sec / 60 % 60, sec % 60)
+    val last = if (run.lastPlayedAt == 0L) "never played" else DateFormat.getMediumDateFormat(context).format(Date(run.lastPlayedAt))
+    val game = when (run.game) {
+        1 -> "in A Link to the Past"
+        2 -> "in Super Metroid"
+        else -> "not started"
+    }
+    return "Zelda ${run.zeldaCleared}/${run.zeldaTotal} · Metroid ${run.metroidCleared}/${run.metroidTotal}\n" +
+        "$time played · $game · $last"
+}
