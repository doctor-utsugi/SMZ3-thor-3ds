diff --git a/lemuroid-app/src/test/java/com/swordfish/lemuroid/app/mobile/feature/runs/RunKeysTest.kt b/lemuroid-app/src/test/java/com/swordfish/lemuroid/app/mobile/feature/runs/RunKeysTest.kt
new file mode 100644
index 0000000..68b2a9d
--- /dev/null
+++ b/lemuroid-app/src/test/java/com/swordfish/lemuroid/app/mobile/feature/runs/RunKeysTest.kt
@@ -0,0 +1,67 @@
+package com.swordfish.lemuroid.app.mobile.feature.runs
+
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+class RunKeysTest {
+    private fun wram() = ByteArray(0x20000)
+    private fun sram() = ByteArray(0x100000)
+
+    @Test
+    fun noKeysanityReadsNothing() {
+        val w = wram(); val s = sram()
+        w[0xF4E4] = 2; w[0xD830] = 0x05
+        assertEquals(emptyList<String>(), RunKeys.items(w, s, RunKeys.GAME_ZELDA, "None"))
+        assertEquals(emptyList<String>(), RunKeys.items(w, s, RunKeys.GAME_METROID, "None"))
+    }
+
+    @Test
+    fun zeldaKeysFromWramWhileInZelda() {
+        val w = wram(); val s = sram()
+        w[0xF4E4] = 2          // Castle Tower: two small keys
+        w[0xF4E0] = 1; w[0xF4E1] = 1   // sewers and castle add up to two Hyrule Castle keys
+        w[0xF4ED] = 1          // Ganon's Tower
+        w[0xF366] = 0x04.toByte()   // big key Ganon's Tower
+        w[0xF367] = 0x20       // big key Eastern Palace
+        val got = RunKeys.items(w, s, RunKeys.GAME_ZELDA, "Zelda")
+        assertEquals(listOf("BigKeyGT", "BigKeyEP", "KeyHC", "KeyHC", "KeyCT", "KeyCT", "KeyGT").sorted(), got.sorted())
+    }
+
+    @Test
+    fun zeldaKeysFromSramWhileInMetroid() {
+        val w = wram(); val s = sram()
+        s[0x3F50 + 6] = 3      // Palace of Darkness
+        s[0x366] = 0x80.toByte()   // big key Skull Woods, in the mirrored inventory block
+        w[0xF4E4] = 5          // stale ALttP WRAM must be ignored while Super Metroid runs
+        val got = RunKeys.items(w, s, RunKeys.GAME_METROID, "Zelda")
+        assertEquals(listOf("BigKeySW", "KeyPD", "KeyPD", "KeyPD").sorted(), got.sorted())
+    }
+
+    @Test
+    fun keycardsFromWramInMetroidAndSramInZelda() {
+        val w = wram(); val s = sram()
+        w[0xD830] = 0x05; w[0xD831] = 0x80.toByte()   // Crateria L1 + boss, Lower Norfair boss
+        assertEquals(listOf("CardCrateriaL1", "CardCrateriaBoss", "CardLowerNorfairBoss"),
+            RunKeys.items(w, s, RunKeys.GAME_METROID, "SuperMetroid"))
+        val w2 = wram(); val s2 = sram()
+        s2[0x3970] = 0x40; s2[0x3971] = 0x02          // Norfair L1, Wrecked... bit 9 = Maridia L1
+        assertEquals(listOf("CardNorfairL1", "CardMaridiaL1"), RunKeys.items(w2, s2, RunKeys.GAME_ZELDA, "Both"))
+    }
+
+    @Test
+    fun keysanityOfOneGameDoesNotReadTheOther() {
+        val w = wram(); val s = sram()
+        w[0xF4E4] = 2; w[0xD830] = 0x01
+        assertEquals(listOf("KeyCT", "KeyCT"), RunKeys.items(w, s, RunKeys.GAME_ZELDA, "Zelda"))
+        w[0xD830] = 0x01
+        assertEquals(listOf("CardCrateriaL1"), RunKeys.items(w, s, RunKeys.GAME_METROID, "SuperMetroid"))
+        assertEquals(emptyList<String>(), RunKeys.items(w, s, RunKeys.GAME_METROID, "Zelda").filter { it.startsWith("Card") })
+    }
+
+    @Test
+    fun uninitialisedCounterIsIgnored() {
+        val w = wram(); val s = sram()
+        w[0xF4E4] = 0xFF.toByte()
+        assertEquals(emptyList<String>(), RunKeys.items(w, s, RunKeys.GAME_ZELDA, "Zelda"))
+    }
+}
