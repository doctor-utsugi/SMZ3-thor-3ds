+package com.swordfish.lemuroid.app.mobile.feature.runs
+
+/**
+ * Keysanity items for the logic: ALttP small and big keys and Super Metroid keycards, read from the game memory.
+ * Addresses follow the Cas' tracker auto tracker (ZeldaMiscData.cs, MetroidBosses.cs); the SRAM offsets are the
+ * cartridge addresses minus 0xA06000 (A0:6000 is 0, A1:6000 is 0x2000).
+ *
+ * While ALttP runs its state is in WRAM ($7EF000 at 0xF000); while Super Metroid runs the ALttP state is mirrored in SRAM
+ * (inventory block at 0x340, keys at 0x3F50) and the keycards are in WRAM ($7ED830); while ALttP runs the keycards
+ * are in SRAM at 0x3970.
+ */
+object RunKeys {
+    const val GAME_ZELDA = 1
+    const val GAME_METROID = 2
+
+    private const val WRAM_ZELDA = 0xF000
+    private const val WRAM_KEYCARDS = 0xD830
+    private const val SRAM_KEYS = 0x3F50
+    private const val SRAM_KEYCARDS = 0x3970
+
+    /** Small key counters, in the order of the byte array at $7EF4E0 (the first two bytes, sewers and castle, add up). */
+    private val smallKeys = listOf(
+        "KeyDP" to 3, "KeyCT" to 4, "KeySP" to 5, "KeyPD" to 6, "KeyMM" to 7, "KeySW" to 8,
+        "KeyIP" to 9, "KeyTH" to 10, "KeyTT" to 11, "KeyTR" to 12, "KeyGT" to 13,
+    )
+
+    /** Big keys: byte offset from $7EF340 (0x366 or 0x367) and bit mask. */
+    private val bigKeys = listOf(
+        Triple("BigKeyGT", 0x366, 0x04), Triple("BigKeyTR", 0x366, 0x08), Triple("BigKeyTT", 0x366, 0x10),
+        Triple("BigKeyTH", 0x366, 0x20), Triple("BigKeyIP", 0x366, 0x40), Triple("BigKeySW", 0x366, 0x80),
+        Triple("BigKeyMM", 0x367, 0x01), Triple("BigKeyPD", 0x367, 0x02), Triple("BigKeySP", 0x367, 0x04),
+        Triple("BigKeyDP", 0x367, 0x10), Triple("BigKeyEP", 0x367, 0x20),
+    )
+
+    /** Keycards: bit index in the 16 bits at the keycard address (low byte first). */
+    private val cards = listOf(
+        "CardCrateriaL1", "CardCrateriaL2", "CardCrateriaBoss", "CardBrinstarL1", "CardBrinstarL2", "CardBrinstarBoss",
+        "CardNorfairL1", "CardNorfairL2", "CardNorfairBoss", "CardMaridiaL1", "CardMaridiaL2", "CardMaridiaBoss",
+        "CardWreckedShipL1", "CardWreckedShipBoss", "CardLowerNorfairL1", "CardLowerNorfairBoss",
+    )
+
+    /** Item type names (small keys repeated per key) for what the player holds. [keysanity] is the run's setting. */
+    fun items(wram: ByteArray, sram: ByteArray, game: Int, keysanity: String): List<String> {
+        val zelda = keysanity == "Zelda" || keysanity == "Both"
+        val metroid = keysanity == "SuperMetroid" || keysanity == "Both"
+        val out = mutableListOf<String>()
+        if (zelda && game == GAME_ZELDA) addZelda(out, { wram.u8(WRAM_ZELDA + it) }, { wram.u8(WRAM_ZELDA + 0x4E0 + it) })
+        if (zelda && game == GAME_METROID) addZelda(out, { sram.u8(it) }, { sram.u8(SRAM_KEYS + it) })
+        if (metroid && game == GAME_METROID) addCards(out, wram.u8(WRAM_KEYCARDS) or (wram.u8(WRAM_KEYCARDS + 1) shl 8))
+        if (metroid && game == GAME_ZELDA) addCards(out, sram.u8(SRAM_KEYCARDS) or (sram.u8(SRAM_KEYCARDS + 1) shl 8))
+        return out
+    }
+
+    /** [state] reads the $7EF000 block by offset from $7EF000, [keys] the key bytes by offset from $7EF4E0. */
+    private fun addZelda(out: MutableList<String>, state: (Int) -> Int, keys: (Int) -> Int) {
+        for ((name, off, mask) in bigKeys) if (state(off) and mask != 0) out += name
+        repeat((count(keys(0)) + count(keys(1))).coerceAtMost(8)) { out += "KeyHC" }
+        for ((name, index) in smallKeys) repeat(count(keys(index))) { out += name }
+    }
+
+    private fun addCards(out: MutableList<String>, bits: Int) {
+        for ((i, name) in cards.withIndex()) if (bits and (1 shl i) != 0) out += name
+    }
+
+    private fun ByteArray.u8(i: Int) = if (i in indices) this[i].toInt() and 0xFF else 0
+
+    /** A key counter byte; 0xFF means the block is not initialised. */
+    private fun count(v: Int) = if (v == 0xFF) 0 else v.coerceAtMost(8)
+}
