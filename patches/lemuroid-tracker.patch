+    private lateinit var helpStatus: TextView
+    private lateinit var helpHistory: TextView
+    private lateinit var hintButton: Button
+    private lateinit var revealButton: Button
+    private var helpBusy = false
+    private var helpNote = ""
+    private lateinit var regionPicker: LinearLayout
+
+    private fun buildHelpPage(): View {
+        val column = LinearLayout(context).apply {
+            orientation = LinearLayout.VERTICAL
+            setPadding(dp(16), dp(16), dp(16), dp(16))
+        }
+        helpStatus = label(16f).apply { setPadding(0, 0, 0, dp(12)) }
+        hintButton = Button(context).apply {
+            text = "Give me a hint"
+            setOnClickListener { askHint() }
+        }
+        revealButton = Button(context).apply {
+            text = "Show the checks left in a region"
+            setOnClickListener { askReveal() }
+        }
+        regionPicker = LinearLayout(context).apply { orientation = LinearLayout.VERTICAL; visibility = View.GONE }
+        helpHistory = label(14f).apply { setPadding(0, dp(16), 0, 0) }
+        listOf(helpStatus, hintButton, revealButton, regionPicker, helpHistory).forEach {
+            column.addView(it, ViewGroup.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT))
+        }
+        return ScrollView(context).apply { addView(column) }
+    }
+
+    private fun askHint() {
+        if (helpBusy || !Smz3Help.current().canAsk) return
+        helpBusy = true
+        hintButton.isEnabled = false
+        hintButton.text = "Thinking..."
+        Thread(null, {
+            val text = runCatching { Smz3Help.askHint(context) }.getOrNull()
+            hintButton.post {
+                helpBusy = false
+                hintButton.text = "Give me a hint"
+                hintButton.isEnabled = true
+                helpNote = if (text == null) "No more hints." else "New hint: $text"
+            }
+        }, "smz3-help", 16L * 1024 * 1024).start()
+    }
+
+    /** The region list is inline: a dialog cannot be opened from a presentation window. */
+    private fun askReveal() {
+        if (!Smz3Help.current().canAsk) return
+        regionPicker.removeAllViews()
+        if (regionPicker.visibility == View.VISIBLE) { regionPicker.visibility = View.GONE; return }
+        regions.forEach { region ->
+            regionPicker.addView(
+                Button(context).apply {
+                    text = "${region.name}  (${if (region.game == 1) "Zelda" else "Metroid"})"
+                    setOnClickListener {
+                        Smz3Help.reveal(context, region.locations)
+                        regionPicker.visibility = View.GONE
+                        helpNote = "Showing the checks left in ${region.name}."
+                    }
+                },
+                ViewGroup.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT),
+            )
+        }
+        regionPicker.visibility = View.VISIBLE
+    }
+
+    private fun renderHelp(h: HelpInfo) {
+        val on = h.mode != "none"
+        tabs.getOrNull(HELP_TAB)?.visibility = if (on) View.VISIBLE else View.GONE
+        if (!on && selectedTab == HELP_TAB) select(0)
+        helpStatus.text = when (h.mode) {
+            "all" -> "All helps are on: hints are unlimited and the map shows what is left."
+            "limited" -> "Helps left: ${h.left} of ${h.total}"
+            else -> ""
+        } + if (helpNote.isEmpty()) "" else "\n\n$helpNote"
+        hintButton.visibility = if (on && h.hints.size < 15) View.VISIBLE else View.GONE
+        hintButton.isEnabled = h.canAsk && !helpBusy
+        revealButton.visibility = if (h.mode == "limited") View.VISIBLE else View.GONE
+        revealButton.isEnabled = h.canAsk
+        helpHistory.text = if (h.hints.isEmpty()) "" else "Hints so far\n\n" + h.hints.joinToString("\n\n")
+    }
