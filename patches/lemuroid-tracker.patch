+    /** Hotkey settings: tap a button to cycle it through the pad buttons; changes apply at once. */
+    private fun buildConfigPage(): View {
+        val column = LinearLayout(context).apply {
+            orientation = LinearLayout.VERTICAL
+            setPadding(dp(16), dp(12), dp(16), dp(16))
+        }
+        column.addView(label(13f, Role.DIM).apply { text = "HOTKEYS  (tap a button to change it; hold the first, then press the second)" })
+        for (action in Smz3HotkeyAction.entries) {
+            val row = LinearLayout(context).apply { orientation = LinearLayout.HORIZONTAL; gravity = Gravity.CENTER_VERTICAL }
+            row.addView(label(16f).apply { text = action.title }, LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f))
+            val first = Button(context)
+            val second = Button(context)
+            fun refresh() {
+                val keys = Smz3Hotkeys.keys(context, action)
+                first.text = Smz3Hotkeys.name(keys[0])
+                second.text = if (keys.size > 1) Smz3Hotkeys.name(keys[1]) else "none"
+            }
+            fun cycle(current: Int?): Int? {
+                val order = Smz3Hotkeys.BUTTONS
+                val next = order.getOrNull(if (current == null) 0 else order.indexOf(current) + 1)
+                return next
+            }
+            first.setOnClickListener {
+                val keys = Smz3Hotkeys.keys(context, action)
+                val next = cycle(keys[0]) ?: Smz3Hotkeys.BUTTONS[0]
+                Smz3Hotkeys.setKeys(context, action, listOf(next) + keys.drop(1).filter { it != next })
+                refresh()
+            }
+            second.setOnClickListener {
+                val keys = Smz3Hotkeys.keys(context, action)
+                val next = cycle(keys.getOrNull(1))
+                Smz3Hotkeys.setKeys(context, action, if (next == null || next == keys[0]) listOf(keys[0]) else listOf(keys[0], next))
+                refresh()
+            }
+            configButtons += ::refresh
+            refresh()
+            row.addView(first, LinearLayout.LayoutParams(dp(92), ViewGroup.LayoutParams.WRAP_CONTENT))
+            row.addView(second, LinearLayout.LayoutParams(dp(92), ViewGroup.LayoutParams.WRAP_CONTENT))
+            column.addView(row, ViewGroup.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT))
+        }
+        column.addView(label(13f, Role.DIM).apply { text = "SAVE STATES AND SPEED"; setPadding(0, dp(18), 0, 0) })
+        fun spinRow(title: String, value: () -> String, step: () -> Unit): Button {
+            val row = LinearLayout(context).apply { orientation = LinearLayout.HORIZONTAL; gravity = Gravity.CENTER_VERTICAL }
+            row.addView(label(16f).apply { text = title }, LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f))
+            val button = Button(context)
+            button.text = value()
+            button.setOnClickListener { step(); button.text = value() }
+            configButtons += { button.text = value() }
+            row.addView(button, LinearLayout.LayoutParams(dp(92), ViewGroup.LayoutParams.WRAP_CONTENT))
+            column.addView(row, ViewGroup.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT))
+            return button
+        }
+        spinRow("Active save slot", { "Slot ${Smz3Hotkeys.slot(context)}" }) { Smz3Hotkeys.setSlot(context, Smz3Hotkeys.slot(context) % Smz3Hotkeys.SLOTS + 1) }
+        spinRow("Fast-forward speed", { "x${Smz3Hotkeys.speed(context)}" }) {
+            val speeds = Smz3Hotkeys.SPEEDS
+            Smz3Hotkeys.setSpeed(context, speeds[(speeds.indexOf(Smz3Hotkeys.speed(context)) + 1) % speeds.size])
+        }
+        spinRow("Screen shape", { Smz3Hotkeys.shapeTitle(Smz3Hotkeys.shape(context) ?: runShape()) }) {
+            val next = Smz3Hotkeys.SHAPES[(Smz3Hotkeys.SHAPES.indexOf(Smz3Hotkeys.shape(context) ?: runShape()) + 1) % Smz3Hotkeys.SHAPES.size]
+            Smz3Hotkeys.setShape(context, next)
+            Smz3Hotkeys.host?.hotkeyAspect(Smz3Hotkeys.aspect(next))
+        }.layoutParams.width = dp(150)
+        column.addView(
+            Button(context).apply {
+                text = "Reset to defaults"
+                setOnClickListener { Smz3Hotkeys.resetAll(context); Smz3Hotkeys.host?.hotkeyAspect(Smz3Hotkeys.aspect(runShape())); configButtons.forEach { it() } }
+            },
+            LinearLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT).apply { topMargin = dp(18) },
+        )
+        column.addView(label(12f, Role.DIM).apply { text = "The hotkeys work in game on the main screen. The state is saved in the active slot."; setPadding(0, dp(12), 0, 0) })
+        return ScrollView(context).apply { addView(column) }
+    }
