index 0000000..d66ee20
--- /dev/null
+++ b/lemuroid-app/src/main/java/com/swordfish/lemuroid/app/shared/game/viewmodel/Smz3MapView.kt
@@ -0,0 +1,265 @@
+package com.swordfish.lemuroid.app.shared.game.viewmodel
+
+import android.content.Context
+import android.animation.ValueAnimator
+import android.graphics.Bitmap
+import android.graphics.BitmapFactory
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.Matrix
+import android.graphics.Paint
+import android.graphics.PorterDuff
+import android.graphics.PorterDuffXfermode
+import android.graphics.RectF
+import android.view.GestureDetector
+import android.view.MotionEvent
+import android.view.ScaleGestureDetector
+import android.view.View
+import org.json.JSONArray
+
+/** Pannable, zoomable SMZ3 map. Pending checks are drawn as bright dots, cleared ones as small green dots. */
+internal class Smz3MapView(context: Context, private val follow: Boolean = false) : View(context) {
+    private var position: MapPosition? = null
+    private var seen: List<RectF> = emptyList()
+    private var discoveredOnly = false
+    private val fog = Paint().apply { color = Color.BLACK }
+    private val clear = Paint().apply { xfermode = PorterDuffXfermode(PorterDuff.Mode.CLEAR) }
+    private val me = Paint(Paint.ANTI_ALIAS_FLAG).apply { color = Color.WHITE }
+    private val mapped = RectF()
+
+    private val bitmap: Bitmap? = runCatching {
+        context.assets.open("smz3/map.png").use { BitmapFactory.decodeStream(it) }?.also { it.setHasMipMap(true) }
+    }.getOrNull()
+
+    /** The map is drawn into its half-size coordinate space (what markers, rooms and the player position use). */
+    private val mapRect = RectF(0f, 0f, MAP_W, MAP_H)
+
+    private val markers: List<IntArray> = runCatching {
+        val json = context.assets.open("smz3/map_markers.json").use { String(it.readBytes()) }
+        JSONArray(json).let { a -> List(a.length()) { i -> a.getJSONArray(i).let { intArrayOf(it.getInt(0), it.getInt(1), it.getInt(2)) } } }
+    }.getOrDefault(emptyList())
+
+    private val matrix = Matrix()
+    private val values = FloatArray(9)
+    private val bitmapPaint = Paint(Paint.FILTER_BITMAP_FLAG)
+    private val pending = Paint(Paint.ANTI_ALIAS_FLAG).apply { color = Color.parseColor("#FFD54A") }
+    private val done = Paint(Paint.ANTI_ALIAS_FLAG).apply { color = Color.parseColor("#6FD08C") }
+    private val ring = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+        style = Paint.Style.STROKE
+        color = Color.BLACK
+        strokeWidth = 2f
+    }
+    private var cleared: Set<Int> = emptySet()
+    private var inLogic: Set<Int>? = null
+    // Checks that are not in logic yet: dark fill with a light rim so they stay readable on the pale Dark World too.
+    private val dim = Paint(Paint.ANTI_ALIAS_FLAG).apply { color = Color.parseColor("#E6243038") }
+    private val dimRim = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+        style = Paint.Style.STROKE
+        color = Color.parseColor("#F0F4F8")
+        strokeWidth = 2.5f
+    }
+    private var fitted = false
+    private var pulse = 0f
+    private val pulser = ValueAnimator.ofFloat(0f, 1f).apply {
+        duration = 1500
+        repeatMode = ValueAnimator.REVERSE
+        repeatCount = ValueAnimator.INFINITE
+        addUpdateListener {
+            pulse = it.animatedValue as Float
+            if (isShown) invalidate()
+        }
+    }
+
+    override fun onAttachedToWindow() {
+        super.onAttachedToWindow()
+        pulser.start()
+    }
+
+    override fun onDetachedFromWindow() {
+        pulser.cancel()
+        super.onDetachedFromWindow()
+    }
+
+    private val scaleDetector = ScaleGestureDetector(context, object : ScaleGestureDetector.SimpleOnScaleGestureListener() {
+        override fun onScale(d: ScaleGestureDetector): Boolean {
+            matrix.postScale(d.scaleFactor, d.scaleFactor, d.focusX, d.focusY)
+            invalidate()
+            return true
+        }
+    })
+
+    private val panDetector = GestureDetector(context, object : GestureDetector.SimpleOnGestureListener() {
+        override fun onScroll(e1: MotionEvent?, e2: MotionEvent, dx: Float, dy: Float): Boolean {
+            matrix.postTranslate(-dx, -dy)
+            invalidate()
+            return true
+        }
+
+        override fun onDoubleTap(e: MotionEvent): Boolean {
+            fit()
+            invalidate()
+            return true
+        }
+    })
+
+    fun setTheme(theme: Smz3Theme) {
+        pending.color = theme.pending
+        done.color = theme.done
+        invalidate()
+    }
+
+    fun setCleared(set: Set<Int>, logic: Set<Int>?) {
+        cleared = set
+        inLogic = logic
+        invalidate()
+    }
+
+    private var visibleChecks: Set<Int>? = null
+
+    /** Pending checks drawn on the map: null shows all of them, otherwise only these (the helps the player asked for). */
+    fun setVisibleChecks(set: Set<Int>?) {
+        visibleChecks = set
+        invalidate()
+    }
+
+    fun setDiscovery(pos: MapPosition?, rects: List<RectF>, onlyDiscovered: Boolean) {
+        position = pos
+        seen = rects
+        discoveredOnly = onlyDiscovered
+        invalidate()
+    }
+
+    private var bosses: List<BossMark> = emptyList()
+    private val icons = HashMap<String, Bitmap?>()
+
+    fun setBosses(list: List<BossMark>) {
+        bosses = list
+        invalidate()
+    }
+
+    private fun icon(name: String): Bitmap? = icons.getOrPut(name) {
+        runCatching { context.assets.open("smz3/rewards/$name").use { BitmapFactory.decodeStream(it) } }.getOrNull()
+    }
+
+    private val iconPaint = Paint(Paint.FILTER_BITMAP_FLAG)
+    private val dst = RectF()
+
+    private fun isSeen(x: Float, y: Float) = seen.any { it.contains(x, y) }
+
+    private fun centerOnPlayer() {
+        val pos = position ?: return fit()
+        val s = width / 240f
+        matrix.reset()
+        matrix.postScale(s, s)
+        matrix.postTranslate(width / 2f - pos.x * s, height / 2f - pos.y * s)
+    }
+
+    /** Fits a part of the map (half-size map pixels) in the view, e.g. the Super Metroid area Samus is in. */
+    fun fitRect(r: RectF) {
+        if (width == 0 || height == 0) { pendingFit = r; return }
+        val sc = minOf(width / r.width(), height / r.height())
+        matrix.reset()
+        matrix.postScale(sc, sc)
+        matrix.postTranslate((width - r.width() * sc) / 2f - r.left * sc, (height - r.height() * sc) / 2f - r.top * sc)
+        fitted = true
+        invalidate()
+    }
+
+    private var pendingFit: RectF? = null
+
+    private fun fit() {
+        val bmp = bitmap ?: return
+        if (width == 0 || height == 0) return
+        val s = minOf(width.toFloat() / MAP_W, height.toFloat() / MAP_H)
+        matrix.reset()
+        matrix.postScale(s, s)
+        matrix.postTranslate((width - MAP_W * s) / 2, (height - MAP_H * s) / 2)
+        fitted = true
+    }
+
+    override fun onSizeChanged(w: Int, h: Int, oldw: Int, oldh: Int) {
+        val p = pendingFit
+        if (p != null) { pendingFit = null; fitRect(p) } else if (!fitted) fit()
+        if (follow) centerOnPlayer()
+    }
+
+    override fun onTouchEvent(event: MotionEvent): Boolean {
+        if (follow) {
+            if (event.action == MotionEvent.ACTION_UP) performClick()
+            return true
+        }
+        parent?.requestDisallowInterceptTouchEvent(true)
+        scaleDetector.onTouchEvent(event)
+        if (!scaleDetector.isInProgress) panDetector.onTouchEvent(event)
+        return true
+    }
+
+    override fun onDraw(canvas: Canvas) {
+        canvas.drawColor(Color.parseColor("#0B0E12"))
+        val bmp = bitmap ?: return
+        if (follow) centerOnPlayer()
+        canvas.save()
+        canvas.concat(matrix)
+        canvas.drawBitmap(bmp, null, mapRect, bitmapPaint)
+        canvas.restore()
+        // Parts of the map not seen yet are covered by a veil: light when everything is shown, dark when only discovered parts are.
+        val layer = canvas.saveLayer(0f, 0f, width.toFloat(), height.toFloat(), null)
+        fog.alpha = if (discoveredOnly) 235 else 110
+        canvas.drawRect(0f, 0f, width.toFloat(), height.toFloat(), fog)
+        for (r in seen) {
+            mapped.set(r)
+            matrix.mapRect(mapped)
+            canvas.drawRect(mapped, clear)
+        }
+        canvas.restoreToCount(layer)
+        matrix.getValues(values)
+        val zoom = values[Matrix.MSCALE_X]
+        val pts = FloatArray(2)
+        val radius = (5f + 2f * zoom).coerceIn(5f, 16f)
+        for (m in markers) {
+            pts[0] = m[1].toFloat(); pts[1] = m[2].toFloat()
+            matrix.mapPoints(pts)
+            if (pts[0] < -20 || pts[1] < -20 || pts[0] > width + 20 || pts[1] > height + 20) continue
+            if (discoveredOnly && !isSeen(m[1].toFloat(), m[2].toFloat())) continue
+            if (m[0] in cleared) {
+                canvas.drawCircle(pts[0], pts[1], radius * 0.6f, done)
+            } else if (visibleChecks != null && m[0] !in visibleChecks!!) {
+                continue
+            } else if (inLogic != null && m[0] !in inLogic!!) {
+                canvas.drawCircle(pts[0], pts[1], radius * 0.7f, dim)
+                canvas.drawCircle(pts[0], pts[1], radius * 0.7f, dimRim)
+            } else {
+                // gentle breathing: size and brightness move a little, never blink
+                val r = radius * (1f + 0.22f * pulse)
+                pending.alpha = (255 * (0.75f + 0.25f * (1f - pulse))).toInt()
+                canvas.drawCircle(pts[0], pts[1], r, pending)
+                canvas.drawCircle(pts[0], pts[1], r, ring)
+            }
+        }
+        for (b in bosses) {
+            if (discoveredOnly && !isSeen(b.x, b.y)) continue
+            pts[0] = b.x; pts[1] = b.y
+            matrix.mapPoints(pts)
+            val bmp2 = icon(b.icon) ?: continue
+            val half = (7f + 3f * zoom).coerceIn(8f, 20f)
+            dst.set(pts[0] - half, pts[1] - half, pts[0] + half, pts[1] + half)
+            iconPaint.alpha = if (b.done) 90 else 255
+            canvas.drawBitmap(bmp2, null, dst, iconPaint)
+            if (b.done) canvas.drawCircle(pts[0] + half * 0.6f, pts[1] + half * 0.6f, half * 0.35f, done)
+        }
+            position?.let {
+            pts[0] = it.x; pts[1] = it.y
+            matrix.mapPoints(pts)
+            val pr = (6f + 2f * zoom).coerceIn(7f, 14f)
+            canvas.drawCircle(pts[0], pts[1], pr * (1.1f + 0.3f * pulse), ring)
+            canvas.drawCircle(pts[0], pts[1], pr, me)
+            canvas.drawCircle(pts[0], pts[1], pr, ring)
+        }
+    }
+
+    private companion object {
+        /** Size of the half-size combined map: the coordinate space of the tracker data. */
+        const val MAP_W = 1623f
+        const val MAP_H = 958f
+    }
+}
