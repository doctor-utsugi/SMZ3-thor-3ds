+    /** Saves and states go to /sdcard/SMZ3 when it is writable so sync tools (RomM clients) can reach them. */
+    private fun sharedDirectory(name: String, fallback: File): File {
+        val shared = File("/sdcard/SMZ3", name)
+        val usable = runCatching { shared.mkdirs(); shared.isDirectory && shared.canWrite() }.getOrDefault(false)
+        if (!usable) return fallback
+        runCatching {
+            fallback.listFiles()?.forEach { f -> val t = File(shared, f.name); if (f.isFile && !t.exists()) f.copyTo(t) }
         }
+        return shared
+    }
+
+    fun getStatesDirectory(): File =
+        sharedDirectory("states", File(appContext.getExternalFilesDir(null), "states").apply { mkdirs() })
 
