@@ -0,0 +1,139 @@
+package com.swordfish.lemuroid.app.shared.game.viewmodel
+
+import android.content.Context
+import android.view.KeyEvent
+
+/** What the hotkeys can do in game; implemented by the game view model. */
+interface Smz3HotkeyHost {
+    fun hotkeySaveState(slot: Int)
+
+    fun hotkeyLoadState(slot: Int)
+
+    fun hotkeyFastForward(speed: Int)
+
+    fun hotkeyToast(message: String)
+
+    fun hotkeyAspect(ratio: Float)
+}
+
+enum class Smz3HotkeyAction(val title: String, val defaultKeys: List<Int>) {
+    SAVE_STATE("Save state", listOf(KeyEvent.KEYCODE_BUTTON_L2, KeyEvent.KEYCODE_BUTTON_START)),
+    LOAD_STATE("Load state", listOf(KeyEvent.KEYCODE_BUTTON_L2, KeyEvent.KEYCODE_BUTTON_SELECT)),
+    FAST_FORWARD("Fast forward", listOf(KeyEvent.KEYCODE_BUTTON_R2)),
+    NEXT_SLOT("Next save slot", listOf(KeyEvent.KEYCODE_BUTTON_L2, KeyEvent.KEYCODE_BUTTON_R1)),
+}
+
+/**
+ * Hotkeys for the game screen, with a combo of one or two buttons per action, the save slot they work on and the
+ * fast-forward speed. The settings live in their own preferences file and are edited from the tracker's CONFIG tab.
+ */
+object Smz3Hotkeys {
+    /** The buttons a hotkey can use, in the order the config tab cycles through them. */
+    val BUTTONS: List<Int> = listOf(
+        KeyEvent.KEYCODE_BUTTON_L1, KeyEvent.KEYCODE_BUTTON_R1, KeyEvent.KEYCODE_BUTTON_L2, KeyEvent.KEYCODE_BUTTON_R2,
+        KeyEvent.KEYCODE_BUTTON_THUMBL, KeyEvent.KEYCODE_BUTTON_THUMBR, KeyEvent.KEYCODE_BUTTON_SELECT,
+        KeyEvent.KEYCODE_BUTTON_START, KeyEvent.KEYCODE_BUTTON_A, KeyEvent.KEYCODE_BUTTON_B,
+        KeyEvent.KEYCODE_BUTTON_X, KeyEvent.KEYCODE_BUTTON_Y,
+    )
+
+    val SPEEDS = listOf(2, 3, 4, 6, 8)
+    const val SLOTS = 4
+    private const val FILE = "smz3_hotkeys"
+    private const val DEFAULT_SPEED = 4
+
+    @Volatile var host: Smz3HotkeyHost? = null
+    private val pressed = HashSet<Int>()
+    private val consumed = HashSet<Int>()
+
+    private fun prefs(context: Context) = context.getSharedPreferences(FILE, Context.MODE_PRIVATE)
+
+    fun name(keyCode: Int): String = when (keyCode) {
+        KeyEvent.KEYCODE_BUTTON_THUMBL -> "L3"
+        KeyEvent.KEYCODE_BUTTON_THUMBR -> "R3"
+        KeyEvent.KEYCODE_BUTTON_L1 -> "L1"
+        KeyEvent.KEYCODE_BUTTON_R1 -> "R1"
+        KeyEvent.KEYCODE_BUTTON_L2 -> "L2"
+        KeyEvent.KEYCODE_BUTTON_R2 -> "R2"
+        KeyEvent.KEYCODE_BUTTON_SELECT -> "Select"
+        KeyEvent.KEYCODE_BUTTON_START -> "Start"
+        KeyEvent.KEYCODE_BUTTON_A -> "A"
+        KeyEvent.KEYCODE_BUTTON_B -> "B"
+        KeyEvent.KEYCODE_BUTTON_X -> "X"
+        KeyEvent.KEYCODE_BUTTON_Y -> "Y"
+        else -> "-"
+    }
+
+    /** The one or two buttons of [action], first one always set. */
+    fun keys(context: Context, action: Smz3HotkeyAction): List<Int> {
+        val saved = prefs(context).getString(action.name, null) ?: return action.defaultKeys
+        val keys = saved.split(",").mapNotNull { it.toIntOrNull() }.filter { it in BUTTONS }
+        return keys.ifEmpty { action.defaultKeys }
+    }
+
+    fun setKeys(context: Context, action: Smz3HotkeyAction, keys: List<Int>) {
+        prefs(context).edit().putString(action.name, keys.joinToString(",")).apply()
+    }
+
+    fun slot(context: Context): Int = prefs(context).getInt("slot", 1).coerceIn(1, SLOTS)
+
+    fun setSlot(context: Context, slot: Int) = prefs(context).edit().putInt("slot", slot).apply()
+
+    fun speed(context: Context): Int = prefs(context).getInt("speed", DEFAULT_SPEED).takeIf { it in SPEEDS } ?: DEFAULT_SPEED
+
+    fun setSpeed(context: Context, speed: Int) = prefs(context).edit().putInt("speed", speed).apply()
+
+    val SHAPES = listOf("original", "wide", "pixel")
+
+    /** The shape chosen in the config tab, or null to follow the one the run was created with. */
+    fun shape(context: Context): String? = prefs(context).getString("shape", null)?.takeIf { it in SHAPES }
+
+    fun setShape(context: Context, shape: String?) = prefs(context).edit().apply { if (shape == null) remove("shape") else putString("shape", shape) }.apply()
+
+    /** Width / height to stretch the picture to; 0 keeps the ratio the core reports. */
+    fun aspect(shape: String): Float = when (shape) {
+        "wide" -> 16f / 9f
+        "pixel" -> 8f / 7f
+        else -> 0f
+    }
+
+    fun shapeTitle(shape: String): String = when (shape) {
+        "wide" -> "Wide 16:9"
+        "pixel" -> "Pixels 8:7"
+        else -> "Original 4:3"
+    }
+
+    fun resetAll(context: Context) = prefs(context).edit().clear().apply()
+
+    fun run(context: Context, action: Smz3HotkeyAction) {
+        timber.log.Timber.i("SMZ3 hotkey ${action.name} slot=${slot(context)}")
+        val h = host ?: return
+        when (action) {
+            Smz3HotkeyAction.SAVE_STATE -> { h.hotkeySaveState(slot(context)); h.hotkeyToast("State saved in slot ${slot(context)}") }
+            Smz3HotkeyAction.LOAD_STATE -> { h.hotkeyLoadState(slot(context)); h.hotkeyToast("State loaded from slot ${slot(context)}") }
+            Smz3HotkeyAction.FAST_FORWARD -> h.hotkeyFastForward(speed(context))
+            Smz3HotkeyAction.NEXT_SLOT -> {
+                val next = slot(context) % SLOTS + 1
+                setSlot(context, next)
+                h.hotkeyToast("Save slot $next")
+            }
+        }
+    }
+
+    /** Returns true when the key was taken by a hotkey and must not reach the game. */
+    fun onKey(context: Context, event: KeyEvent): Boolean {
+        val code = event.keyCode
+        if (event.action == KeyEvent.ACTION_UP) {
+            pressed.remove(code)
+            return consumed.remove(code)
+        }
+        if (event.action != KeyEvent.ACTION_DOWN || event.repeatCount > 0) return code in consumed
+        pressed.add(code)
+        val match = Smz3HotkeyAction.entries
+            .map { it to keys(context, it) }
+            .filter { (_, keys) -> code in keys && pressed.containsAll(keys) }
+            .maxByOrNull { (_, keys) -> keys.size } ?: return false
+        consumed.add(code)
+        run(context, match.first)
+        return true
+    }
+}
diff --git a/lemuroid-app/src/main/java/com/swordfish/lemuroid/app/shared/game/viewmodel/Smz3HudView.kt b/lemuroid-app/src/main/java/com/swordfish/lemuroid/app/shared/game/viewmodel/Smz3HudView.kt
