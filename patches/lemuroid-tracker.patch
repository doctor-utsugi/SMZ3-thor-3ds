@@ -0,0 +1,151 @@
+package com.swordfish.lemuroid.app.shared.game.viewmodel
+
+import android.content.Context
+import android.graphics.Bitmap
+import android.graphics.BitmapFactory
+import android.graphics.Canvas
+import android.graphics.Paint
+import android.graphics.Path
+import android.graphics.RectF
+import android.view.View
+
+/**
+ * The status panel at the top of the RUN tab, drawn like the game HUD in use: a gold-framed row of
+ * hearts for A Link to the Past, an orange-framed energy tank and ammo readout for Super Metroid.
+ */
+internal class Smz3HudView(context: Context) : View(context) {
+    private val density = context.resources.displayMetrics.density
+    private fun dp(v: Float) = v * density
+
+    private var theme = Smz3Theme.ZELDA
+    private var game = 1
+    private var levels = mapOf<String, Int>()
+
+    private val frame = Paint(Paint.ANTI_ALIAS_FLAG).apply { style = Paint.Style.STROKE }
+    private val fill = Paint(Paint.ANTI_ALIAS_FLAG).apply { style = Paint.Style.FILL }
+    private val text = Paint(Paint.ANTI_ALIAS_FLAG)
+    private val icons = mutableMapOf<String, Bitmap?>()
+
+    /** Optional user spritesheet /sdcard/SMZ3/hud/hud.png: four square cells in one row (heart, missile, super missile, power bomb). */
+    private val sheet: Bitmap? by lazy { runCatching { BitmapFactory.decodeFile("/sdcard/SMZ3/hud/hud.png") }.getOrNull() }
+    private val sheetCells = listOf("heart container.png", "missile.png", "super missile.png", "power bomb.png")
+
+    private fun sheetCell(file: String): Bitmap? {
+        val sh = sheet ?: return null
+        val i = sheetCells.indexOf(file)
+        val cell = sh.height
+        if (i < 0 || cell <= 0 || sh.width != cell * sheetCells.size) return null
+        return runCatching { Bitmap.createBitmap(sh, i * cell, 0, cell, cell) }.getOrNull()
+    }
+
+    private fun icon(file: String): Bitmap? = icons.getOrPut(file) {
+        sheetCell(file) ?: runCatching { context.assets.open("smz3/items/${file.replace(" ", "_")}").use { BitmapFactory.decodeStream(it) } }.getOrNull()
+    }
+
+    fun update(theme: Smz3Theme, game: Int, levels: Map<String, Int>) {
+        this.theme = theme
+        this.game = game
+        this.levels = levels
+        invalidate()
+    }
+
+    override fun onMeasure(widthSpec: Int, heightSpec: Int) {
+        setMeasuredDimension(MeasureSpec.getSize(widthSpec), dp(170f).toInt())
+    }
+
+    override fun onDraw(canvas: Canvas) {
+        if (game == 2) drawMetroid(canvas) else drawZelda(canvas)
+    }
+
+    private fun drawZelda(canvas: Canvas) {
+        val w = width.toFloat()
+        val h = height.toFloat()
+        fill.color = theme.panel
+        canvas.drawRoundRect(RectF(dp(4f), dp(4f), w - dp(4f), h - dp(4f)), dp(10f), dp(10f), fill)
+        frame.color = theme.accent
+        frame.strokeWidth = dp(3f)
+        canvas.drawRoundRect(RectF(dp(4f), dp(4f), w - dp(4f), h - dp(4f)), dp(10f), dp(10f), frame)
+        frame.strokeWidth = dp(1f)
+        canvas.drawRoundRect(RectF(dp(10f), dp(10f), w - dp(10f), h - dp(10f)), dp(7f), dp(7f), frame)
+
+        text.typeface = theme.typeface
+        text.color = theme.accent
+        text.textSize = dp(13f)
+        canvas.drawText("- LIFE -", dp(20f), dp(34f), text)
+
+        val hearts = (levels["Hearts"] ?: 3).coerceIn(1, 20)
+        val heart = icon("heart container.png")
+        val size = dp(26f)
+        val perRow = 10
+        for (i in 0 until hearts) {
+            val x = dp(20f) + (i % perRow) * (size + dp(4f))
+            val y = dp(44f) + (i / perRow) * (size + dp(4f))
+            if (heart != null) canvas.drawBitmap(heart, null, RectF(x, y, x + size, y + size), null)
+        }
+
+        val pieces = levels["Heart Pieces"] ?: 0
+        val bottles = levels["Bottles"] ?: 0
+        text.color = theme.text
+        text.textSize = dp(14f)
+        val row = h - dp(20f)
+        canvas.drawText("Heart pieces $pieces/4", dp(20f), row, text)
+        canvas.drawText("Bottles $bottles", w / 2f, row, text)
+    }
+
+    private fun drawMetroid(canvas: Canvas) {
+        val w = width.toFloat()
+        val h = height.toFloat()
+        val cut = dp(14f)
+        val outline = Path().apply {
+            moveTo(dp(4f) + cut, dp(4f))
+            lineTo(w - dp(4f), dp(4f))
+            lineTo(w - dp(4f), h - dp(4f) - cut)
+            lineTo(w - dp(4f) - cut, h - dp(4f))
+            lineTo(dp(4f), h - dp(4f))
+            lineTo(dp(4f), dp(4f) + cut)
+            close()
+        }
+        fill.color = theme.panel
+        canvas.drawPath(outline, fill)
+        frame.color = theme.accent
+        frame.strokeWidth = dp(2f)
+        canvas.drawPath(outline, frame)
+
+        text.typeface = theme.typeface
+        text.color = theme.accent
+        text.textSize = dp(14f)
+        val tanks = levels["Energy Tanks"] ?: 0
+        val reserve = levels["Reserve"] ?: 0
+        canvas.drawText("ENERGY", dp(20f), dp(36f), text)
+
+        fill.color = theme.accent
+        val box = dp(16f)
+        for (i in 0 until tanks.coerceAtMost(14)) {
+            val x = dp(100f) + i * (box + dp(4f))
+            canvas.drawRect(x, dp(22f), x + box, dp(22f) + box, fill)
+        }
+        text.color = theme.text
+        text.textSize = dp(22f)
+        canvas.drawText("${(tanks + 1) * 100 - 1}", dp(20f), dp(70f), text)
+        text.textSize = dp(12f)
+        text.color = theme.dim
+        if (reserve > 0) canvas.drawText("RESERVE $reserve", dp(110f), dp(68f), text)
+
+        val ammo = listOf(
+            Triple("MISSILE", "missile.png", levels["Missiles"] ?: 0),
+            Triple("SUPER", "super missile.png", levels["Super Missiles"] ?: 0),
+            Triple("POWER", "power bomb.png", levels["Power Bombs"] ?: 0),
+        )
+        val col = (w - dp(40f)) / ammo.size
+        ammo.forEachIndexed { i, (label, file, value) ->
+            val x = dp(20f) + i * col
+            icon(file)?.let { canvas.drawBitmap(it, null, RectF(x, dp(88f), x + dp(40f), dp(128f)), null) }
+            text.color = theme.dim
+            text.textSize = dp(11f)
+            canvas.drawText(label, x + dp(46f), dp(104f), text)
+            text.color = theme.text
+            text.textSize = dp(20f)
+            canvas.drawText(value.toString(), x + dp(46f), dp(128f), text)
+        }
+    }
+}
