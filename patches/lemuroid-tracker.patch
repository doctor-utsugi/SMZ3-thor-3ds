+private val palette = listOf(
+    Color(0xFF10141C), Color(0xFF1D2430), Color(0xFF2E4A6B), Color(0xFFE8ECF2), Color(0xFF8793A6), Color(0xFFE9A23B), Color(0xFFE05A4F),
+)
+private enum class Act { NONE, CONTINUE, DELETE, GENERATE }
+
+private fun spriteDir(game: Int) = File("/sdcard/SMZ3/sprites", if (game == 0) "link" else "samus")
+
+/** Sprite previews (`<name>.pv` beside the .rdc: u8 width, u8 height, RGBA), decoded once and kept; null when the file is missing. */
+private val previewCache = HashMap<String, ImageBitmap?>()
+
+private fun preview(key: String): ImageBitmap? = previewCache.getOrPut(key) {
+    runCatching {
+        val game = if (key.startsWith("link/")) 0 else 1
+        val bytes = File(spriteDir(game), key.substringAfter('/') + ".pv").readBytes()
+        val w = bytes[0].toInt() and 255; val h = bytes[1].toInt() and 255
+        val px = IntArray(w * h) { i ->
+            val o = 2 + i * 4
+            ((bytes[o + 3].toInt() and 255) shl 24) or ((bytes[o].toInt() and 255) shl 16) or ((bytes[o + 1].toInt() and 255) shl 8) or (bytes[o + 2].toInt() and 255)
+        }
+        android.graphics.Bitmap.createBitmap(px, w, h, android.graphics.Bitmap.Config.ARGB_8888).asImageBitmap()
+    }.getOrNull()
+}
+
+private val plandoDir = File("/sdcard/SMZ3/plando")
+
+private fun plandoNames(): Array<String> =
+    plandoDir.listFiles { f -> f.extension.equals("yml", true) || f.extension.equals("yaml", true) }?.map { it.name }?.sorted()?.toTypedArray() ?: emptyArray()
+
+private fun spriteNames(game: Int): Array<String> =
+    spriteDir(game).listFiles { f -> f.extension.equals("rdc", true) }?.map { it.nameWithoutExtension }?.sorted()?.toTypedArray() ?: emptyArray()
+
+/**
+ * The start menu, run creation, options and sprite pickers. All of it lives in the shared C core (core/ui); this
+ * screen forwards buttons and touches to it, draws the rectangles and texts it produces and performs the actions
+ * it asks for (continue, delete, generate), so the 3DS build gets the same menus.
+ */
+@Composable
+fun NativeMenuScreen(
+    modifier: Modifier = Modifier,
+    retrogradeDb: RetrogradeDatabase,
+    onContinue: (Run) -> Unit,
+) {
+    val context = LocalContext.current
+    val scope = rememberCoroutineScope()
+    var version by remember { mutableIntStateOf(0) }
+    val focus = remember { FocusRequester() }
+    val paint = remember { Paint(Paint.ANTI_ALIAS_FLAG).apply { typeface = Typeface.MONOSPACE } }
+
+    fun refreshSlots() {
+        RunStore.loadAll(context).forEachIndexed { i, run ->
+            Smz3Native.uiSetSlot(i, run != null, run?.name ?: "", run?.let { summary(context, it).replace("\n", " · ").take(38) } ?: "")
+        }
+        version++
+    }
+
+    DisposableEffect(Unit) {
+        Smz3Native.uiInit()
+        Smz3Native.uiSetSprites(0, spriteNames(0))
+        Smz3Native.uiSetSprites(1, spriteNames(1))
+        Smz3Native.uiSetSprites(2, plandoNames())
+        refreshSlots()
+        onDispose { }
+    }
+    LaunchedEffect(Unit) { runCatching { focus.requestFocus() } }
+
+    fun generate(slot: Int) {
+        Smz3Native.uiBusy("Reading the base ROMs ...")
+        version++
+        scope.launch {
+            val outcome = runCatching {
+                val games = retrogradeDb.gameDao().selectListBySystem("snes")
+                val (sm, z3) = RunGenerator.findBaseRoms(context, games)
+                    ?: error(RunGenerator.wrongBaseRom ?: "Super Metroid and ALttP ROMs are needed")
+                Smz3Native.uiBusy("Generating the seed ...")
+                version++
+                // a plando file replaces the generated seed and carries its own settings
+                val plandoName = Smz3Native.uiPlandoName()
+                val plandoText = plandoName.takeIf { it.isNotEmpty() }?.let { File(plandoDir, it).takeIf(File::exists)?.readText() }
+                Smz3Native.uiSetPlando(plandoText?.toByteArray(Charsets.UTF_8)).takeIf { it.isNotEmpty() }?.let { error("plando $plandoName: $it") }
+                val rawSettings = Smz3Native.uiSettingsJson(java.security.SecureRandom().nextInt(Int.MAX_VALUE))
+                val settings = JSONObject(rawSettings)
+                if (plandoText != null) settings.put("plandoYaml", plandoText)
+                fun rdc(game: Int, key: String) = settings.optString(key).takeIf { it.isNotEmpty() }
+                    ?.let { File(spriteDir(game), "$it.rdc").takeIf(File::exists)?.readBytes() }
+                val (rom, usedSeed) = RunGenerator.generate(context, sm, z3, settings, rdc(0, "linkSprite"), rdc(1, "samusSprite"))
+                val name = "Run ${slot + 1}"
+                val romFile = RunStore.newRomFile(context, usedSeed, rawSettings)
+                romFile.writeBytes(rom)
+                val totals = Smz3Native.summarize(ByteArray(0), ByteArray(0))
+                val filters = listOf("sharp", "smooth", "crt", "lcd")
+                val prefs = com.swordfish.lemuroid.lib.preferences.SharedPreferencesHelper.getLegacySharedPreferences(context)
+                prefs.edit().putString(context.getString(com.swordfish.lemuroid.R.string.pref_key_shader_filter), settings.optString("screenFilter", filters[0])).apply()
+                RunStore.save(
+                    context,
+                    Run(
+                        slot = slot, name = name, gameId = 0, createdAt = System.currentTimeMillis(),
+                        zeldaTotal = totals[3], metroidTotal = totals[5], keysanity = settings.optString("keysanity") != "None",
+                        logic = "Vanilla", romPath = romFile.path, seed = usedSeed,
+                        settings = settings.toString(), mapMode = settings.optString("mapMode", "all"),
+                    ),
+                )
+                val game = RunGenerator.registerGame(context, retrogradeDb, slot, name)
+                RunStore.load(context, slot)?.let { RunStore.save(context, it.copy(gameId = game.id)) }
+            }.onFailure { android.util.Log.e("NativeMenu", "generation failed", it) }
+            outcome.exceptionOrNull()?.let {   // tell the player why nothing was created (wrong ROM revision, missing ROM, bad plando)
+                Smz3Native.uiBusy((it.message ?: "Generation failed").take(43))
+                version++
+                kotlinx.coroutines.delay(5000)
+            }
+            Smz3Native.uiIdle()
+            refreshSlots()
+        }
+    }
+
+    fun pollActions() {
+        val (act, slot) = Smz3Native.uiAction().let { Act.values()[it[0]] to it[1] }
+        when (act) {
+            Act.CONTINUE -> RunStore.load(context, slot)?.let(onContinue)
+            Act.DELETE -> { RunStore.delete(context, slot); refreshSlots() }
+            Act.GENERATE -> generate(slot)
+            Act.NONE -> {}
+        }
+    }
+
+    fun press(button: Int) { Smz3Native.uiInput(button); pollActions(); version++ }
+
+    Box(modifier.fillMaxSize().background(palette[0]), contentAlignment = Alignment.Center) {
+        Canvas(
+            Modifier
+                .aspectRatio(W / H)
+                .fillMaxSize()
+                .focusRequester(focus)
+                .focusable()
+                .onKeyEvent { e ->
+                    if (e.type != KeyEventType.KeyDown) return@onKeyEvent false
+                    val b = when (e.key) {
+                        Key.DirectionUp -> 0; Key.DirectionDown -> 1; Key.DirectionLeft -> 2; Key.DirectionRight -> 3
+                        Key.ButtonA, Key.Enter, Key.NumPadEnter -> 4
+                        Key.ButtonB, Key.Escape, Key.Back -> 5
+                        Key.ButtonL1, Key.PageUp -> 6
+                        Key.ButtonR1, Key.PageDown -> 7
+                        else -> return@onKeyEvent false
+                    }
+                    press(b); true
+                }
+                .pointerInput(Unit) {
+                    detectTapGestures { p ->
+                        val scale = size.width / W
+                        Smz3Native.uiTouch((p.x / scale).toInt(), (p.y / scale).toInt()); pollActions(); version++
+                    }
+                },
+        ) {
+            version.let { }
+            val scale = size.width / W
+            val commands = Smz3Native.uiDraw()
+            drawIntoCanvas { canvas ->
+                for (line in commands) {
+                    val f = line.split(",", limit = 8)
+                    val kind = f[0].toInt(); val x = f[1].toFloat() * scale; val y = f[2].toFloat() * scale
+                    val color = palette[f[5].toInt().coerceIn(0, palette.lastIndex)]
+                    if (kind == 0) {
+                        drawRect(color, Offset(x, y), Size(f[3].toFloat() * scale, f[4].toFloat() * scale))
+                    } else if (kind == 2) {
+                        preview(f[7])?.let { img ->
+                            val bw = f[3].toFloat() * scale; val bh = f[4].toFloat() * scale
+                            val k = minOf(bw / img.width, bh / img.height)
+                            val dw = (img.width * k).toInt(); val dh = (img.height * k).toInt()
+                            drawImage(img, IntOffset.Zero, IntSize(img.width, img.height),
+                                IntOffset((x + (bw - dw) / 2).toInt(), (y + (bh - dh) / 2).toInt()), IntSize(dw, dh), filterQuality = FilterQuality.None)
+                        }
+                    } else {
+                        paint.color = color.toArgb(); paint.textSize = 12f * scale
+                        paint.textAlign = when (f[6].toInt()) { 1 -> Paint.Align.CENTER; 2 -> Paint.Align.RIGHT; else -> Paint.Align.LEFT }
+                        canvas.nativeCanvas.drawText(f[7], x, y + 10f * scale, paint)
+                    }
+                }
+            }
+        }
+    }
+}
+
+private fun Color.toArgb(): Int = android.graphics.Color.argb((alpha * 255).toInt(), (red * 255).toInt(), (green * 255).toInt(), (blue * 255).toInt())
