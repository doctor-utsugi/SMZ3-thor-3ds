+    private class RegionRow(val region: Region, val title: TextView, val bar: ProgressBar, val body: LinearLayout, val rows: List<TextView>)
+
+    private val regionRows = mutableListOf<RegionRow>()
+
+    private fun buildChecksPage(): View {
+        val byRegion = linkedMapOf<Pair<Int, String>, MutableList<Int>>()
+        for (i in 0 until Smz3Native.locationCount()) {
+            val (g, region) = Smz3Native.locationInfo(i).split("|", limit = 3)
+            byRegion.getOrPut(g.toInt() to region) { mutableListOf() }.add(i)
+        }
+        val column = LinearLayout(context).apply {
+            orientation = LinearLayout.VERTICAL
+            setPadding(dp(16), dp(8), dp(16), dp(12))
+        }
+        var lastGame = 0
+        for ((key, locs) in byRegion.entries.sortedBy { it.key.first }) {
+            if (key.first != lastGame) {
+                lastGame = key.first
+                column.addView(label(12f, Role.DIM).apply {
+                    text = if (lastGame == 1) "A LINK TO THE PAST" else "SUPER METROID"
+                    setPadding(0, dp(12), 0, dp(4))
+                })
+            }
+            val title = label(14f).apply { setPadding(0, dp(6), 0, dp(2)) }
+            val progress = bar()
+            val rows = locs.map { index ->
+                label(13f, Role.DIM).apply {
+                    text = Smz3Native.locationInfo(index).split("|")[2]
+                    setPadding(dp(18), dp(2), 0, dp(2))
+                }
+            }
+            val body = LinearLayout(context).apply {
+                orientation = LinearLayout.VERTICAL
+                visibility = View.GONE
+                rows.forEach { addView(it) }
+            }
+            title.setOnClickListener { body.visibility = if (body.visibility == View.VISIBLE) View.GONE else View.VISIBLE }
+            column.addView(title)
+            column.addView(progress, LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, dp(8)))
+            column.addView(body)
+            val region = Region(key.first, key.second, locs)
+            regions += region
+            regionViews += title to progress
+            regionRows += RegionRow(region, title, progress, body, rows)
+        }
+        return ScrollView(context).apply { addView(column) }
+    }
+
+    fun render(snapshot: Smz3Snapshot) {
+        // A debug_game file in the app files folder (containing 1 or 2) forces the theme, for previews.
+        val forced = runCatching { java.io.File(context.filesDir, "debug_game").readText().trim().toInt() }.getOrNull()
+        val s = if (forced != null) snapshot.copy(started = true, game = forced) else snapshot
+        val next = Smz3Theme.forGame(if (s.started) s.game else 0, theme)
+        if (next !== theme) applyTheme(next)
+        areaBox = s.areaBox
+        game.text = when {
+            !s.started -> "Waiting for a file"
+            s.game == 1 -> "A Link to the Past"
+            s.game == 2 -> "Super Metroid"
+            s.game == 3 -> "Credits"
+            else -> "Unknown"
+        }
+        val sec = s.elapsedMs / 1000
+        time.text = "%d:%02d:%02d".format(sec / 3600, sec / 60 % 60, sec % 60)
+        val cleared = s.zeldaCleared + s.metroidCleared
+        val total = s.zeldaTotal + s.metroidTotal
+        percent.text = if (total == 0) "0%" else "${cleared * 100 / total}%"
+        zeldaText.text = "Zelda  ${s.zeldaCleared} / ${s.zeldaTotal}"
+        metroidText.text = "Metroid  ${s.metroidCleared} / ${s.metroidTotal}"
+        zeldaBar.progress = if (s.zeldaTotal == 0) 0 else s.zeldaCleared * 100 / s.zeldaTotal
+        metroidBar.progress = if (s.metroidTotal == 0) 0 else s.metroidCleared * 100 / s.metroidTotal
+        val bossesDone = s.bosses.count { it.done }
+        val itemsOwned = s.inventory.count { it > 0 }
+        val perHour = if (sec >= 300) "%.1f".format(cleared * 3600f / sec) else "-"
+        stats.text = "Checks  $cleared / $total      Bosses  $bossesDone / ${s.bosses.size}\n" +
+            "Items  $itemsOwned / ${itemNames.size}      Pace  $perHour checks/h"
+        // Regions nearest to being finished: a goal to aim for that the game screen does not show.
+        val nearly = regions
+            .map { r -> Triple(r, r.locations.count { it in s.cleared }, r.locations.size) }
+            .filter { (_, done, size) -> done in 1 until size }
+            .sortedBy { (_, done, size) -> size - done }
+            .take(3)
+        closest.text = if (nearly.isEmpty()) "" else "Nearly done\n" + nearly.joinToString("\n") { (r, done, size) -> "${r.name}  $done / $size  (${size - done} left)" }
+        recent.text = if (s.recent.isEmpty()) "" else "Recent checks\n" + s.recent.joinToString("\n")
+
+        for (cell in cells) {
+            val level = s.inventory.getOrElse(cell.index) { 0 }
+            val name = itemNames[cell.index]
+            cell.icon.alpha = if (level > 0) 1f else 0.2f
+            cell.count.text = when {
+                level <= 0 -> ""
+                name in countedItems -> level.toString()
+                name in levelItems && level > 1 -> level.toString()
+                else -> ""
+            }
+        }
+
+        renderHelp(s.help)
+        map?.setVisibleChecks(s.help.visibleChecks)
+        miniMap?.setVisibleChecks(s.help.visibleChecks)
+        map?.setCleared(s.cleared, s.inLogic)
+        miniMap?.setCleared(s.cleared, s.inLogic)
+        map?.setDiscovery(s.position, s.seen, s.discoveredOnly)
+        miniMap?.setDiscovery(s.position, s.seen, s.discoveredOnly)
+        map?.setBosses(s.bosses)
+        miniMap?.setBosses(s.bosses)
+
+        regions.forEachIndexed { i, region ->
+            val done = region.locations.count { it in s.cleared }
+            val (text, progress) = regionViews[i]
+            val open = s.inLogic?.let { logic -> region.locations.count { it !in s.cleared && it in logic } }
+            text.text = "${region.name}  $done / ${region.locations.size}" + if (open != null && open > 0) "   +$open in logic" else ""
+            text.setTextColor(if (done == region.locations.size) theme.done else theme.text)
+            progress.progress = done * 100 / region.locations.size
+        }
+
+        for (row in regionRows) {
+            row.region.locations.forEachIndexed { n, index ->
+                val view = row.rows[n]
+                val name = Smz3Native.locationInfo(index).split("|")[2]
+                when {
+                    index in s.cleared -> { view.setTextColor(theme.done); view.text = "\u2713  $name" }
+                    s.inLogic?.contains(index) == true -> { view.setTextColor(theme.text); view.text = "\u2022  $name" }
+                    s.help.visibleChecks != null && index !in s.help.visibleChecks!! -> { view.setTextColor(theme.dim); view.text = "    ???" }
+                    s.help.visibleChecks != null -> { view.setTextColor(theme.text); view.text = "\u2022  $name" }
+                    else -> { view.setTextColor(theme.dim); view.text = "    $name" }
+                }
+            }
+        }
+    }
+}
