+package com.swordfish.lemuroid.app.mobile.feature.runs
+
+import android.content.Context
+import android.net.Uri
+import com.swordfish.lemuroid.lib.library.db.RetrogradeDatabase
+import com.swordfish.lemuroid.lib.library.db.entity.Game
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import org.json.JSONArray
+import org.json.JSONObject
+import java.io.ByteArrayOutputStream
+import java.io.File
+import java.io.InputStream
+import com.swordfish.lemuroid.app.shared.game.viewmodel.Smz3Native
+import java.nio.ByteBuffer
+import java.nio.ByteOrder
+
+class Choice(val value: String, val label: String)
+
+class LogicOption(val name: String, val label: String, val tip: String, val group: String, val default: Boolean)
+
+/** The options panel as the generator service describes it (GET /schema). */
+class OptionSchema(
+    val keysanity: List<Choice>,
+    val itemPlacement: List<Choice>,
+    val gameMode: List<Choice>,
+    val tourianBossDoor: List<Choice>,
+    val pyramidHole: List<Choice>,
+    val logic: List<LogicOption>,
+)
+
+/** Builds seeds and ROMs on the device with the C generator (core/gen), from the user's own base ROMs. */
+object RunGenerator {
+    private fun choices(a: JSONArray) = List(a.length()) { a.getJSONObject(it).let { o -> Choice(o.getString("value"), o.getString("label")) } }
+
+    /** The options panel, from assets/smz3/schema.json (written by `gen-cli schema`). Only what the C generator supports is offered. */
+    fun schema(context: Context): OptionSchema {
+        val json = JSONObject(context.assets.open("smz3/schema.json").use { String(it.readBytes()) })
+        val c = json.getJSONObject("choices")
+        val logic = json.getJSONArray("logic")
+        return OptionSchema(
+            keysanity = choices(c.getJSONArray("keysanity")).filter { it.value != "Random" },
+            itemPlacement = choices(c.getJSONArray("itemPlacement")),
+            gameMode = choices(c.getJSONArray("gameMode")).filter { it.value == "Vanilla" },
+            tourianBossDoor = choices(c.getJSONArray("tourianBossDoor")),
+            pyramidHole = choices(c.getJSONArray("pyramidHole")),
+            logic = List(logic.length()) {
+                logic.getJSONObject(it).let { o ->
+                    LogicOption(o.getString("name"), o.optString("label"), o.optString("tip"), o.optString("group"), o.getBoolean("value"))
+                }
+            },
+        )
+    }
+
+    private fun fnv1a(text: String): Int {
+        var h = 0x811C9DC5.toInt()
+        for (b in text.toByteArray(Charsets.UTF_8)) h = (h xor (b.toInt() and 0xFF)) * 0x01000193
+        return h
+    }
+
+    /** Like the tracker's seed parsing: empty is random, plain numbers are used as they are, anything else is hashed. */
+    fun parseSeed(input: String): Int {
+        val text = input.trim()
+        if (text.isEmpty()) return java.security.SecureRandom().nextInt(Int.MAX_VALUE)
+        return text.toIntOrNull() ?: text.toLongOrNull(16)?.toInt()?.takeIf { text.length <= 8 && text.all { c -> c.isLetterOrDigit() } } ?: fnv1a(text)
+    }
+
+    private val keysanityIds = mapOf("None" to 0, "Zelda" to 1, "SuperMetroid" to 2, "Both" to 3)
+    private val ruleIds = mapOf("Anywhere" to 0, "DungeonsAndMetroid" to 1, "CrystalDungeonsAndMetroid" to 2, "SameGame" to 3, "OppositeGame" to 4)
+
+    /** Settings JSON (as stored with the run) to the native generator's parameters. */
+    fun nativeParams(settings: JSONObject, seed: Int): IntArray = intArrayOf(
+        seed,
+        keysanityIds[settings.optString("keysanity", "None")] ?: 0,
+        ruleIds[settings.optString("itemPlacement", "Anywhere")] ?: 0,
+        settings.optInt("ganonCrystals", 7), settings.optInt("ganonsTowerCrystals", 7), settings.optInt("tourianBosses", 4),
+        if (settings.optString("pyramidHole", "Closed") == "Open") 1 else 0,
+        if (settings.optString("tourianBossDoor", "Closed") == "Open") 1 else 0,
+        if (settings.optBoolean("lightDarkRooms")) 1 else 0,
+        if (settings.optString("helpMode", "all") == "all") 15 else 0,   // hint tiles belong to "all helps"
+        settings.optInt("etecoonsJingle", 0),
+        if (settings.optBoolean("nerfedCharge")) 1 else 0,
+    )
+
+    fun logicNames(settings: JSONObject): Pair<Array<String>, IntArray> {
+        val logic = settings.optJSONObject("logic") ?: JSONObject()
+        val names = logic.keys().asSequence().toList()
+        return names.toTypedArray() to IntArray(names.size) { logic.get(names[it]).let { v -> if (v is Int) v else if (v == true) 1 else 0 } }
+    }
+
+    /** The plando config a run was made from (stored in its settings), or null. */
+    fun plandoBytes(settings: JSONObject): ByteArray? = settings.optString("plandoYaml").takeIf { it.isNotEmpty() }?.toByteArray(Charsets.UTF_8)
+
+    /** Generates the ROM for [settings] (seed included, as a string). Returns the ROM and the numeric seed used. */
+    suspend fun generate(context: Context, sm: ByteArray, z3: ByteArray, settings: JSONObject, linkRdc: ByteArray? = null, samusRdc: ByteArray? = null): Pair<ByteArray, String> = withContext(Dispatchers.IO) {
+        val seed = parseSeed(settings.optString("seed", ""))
+        val ipsDir = "smz3/ips"
+        val names = context.assets.list(ipsDir).orEmpty().filter { it.endsWith(".ips") }
+        val data = names.map { n -> context.assets.open("$ipsDir/$n").use { it.readBytes() } }
+        val (logicNames, logicValues) = logicNames(settings)
+        var rom: ByteArray? = null
+        // the generator needs more stack than a pool thread has
+        val thread = Thread(null, {
+            rom = Smz3Native.generate(sm, z3, names.toTypedArray(), data.toTypedArray(), nativeParams(settings, seed), logicNames, logicValues, linkRdc, samusRdc, plandoBytes(settings))
+        }, "smz3-generate", 64L * 1024 * 1024)
+        thread.start()
+        thread.join()
+        (rom ?: error(Smz3Native.lastError().ifEmpty { "generation failed" })) to seed.toString()
+    }
+
+    fun openRom(context: Context, game: Game): InputStream {
+        val uri = Uri.parse(game.fileUri)
+        return if (uri.scheme == "file") File(uri.path!!).inputStream() else context.contentResolver.openInputStream(uri)!!
+    }
+
+    const val SM_MD5 = "21f3e98df4780ee1c667b84e57d88675"
+    const val Z3_MD5 = "03a63945398191337e896e5771f77173"
+
+    /** Set by [findBaseRoms] when a base ROM was found but it is the wrong revision. */
+    @Volatile var wrongBaseRom: String? = null
+
+    private fun stripHeader(rom: ByteArray) = if (rom.size % 0x8000 == 0x200) rom.copyOfRange(0x200, rom.size) else rom
+
+    private fun internalTitle(rom: ByteArray): String =
+        if (rom.size > 0x7FD5) String(rom, 0x7FC0, 21, Charsets.ISO_8859_1).uppercase() else ""
+
+    private fun asBaseRom(rom: ByteArray): Pair<String, ByteArray>? {
+        val clean = stripHeader(rom)
+        val title = internalTitle(clean)
+        return when {
+            clean.size == 0x300000 && "METROID" in title -> "sm" to clean
+            clean.size == 0x100000 && "ZELDA" in title -> "z3" to clean
+            else -> null
+        }
+    }
+
+    /**
+     * Finds the Super Metroid (3 MB) and ALttP (1 MB) base ROMs by their internal header, first among the
+     * library games and then in the usual ROM folders on the device.
+     */
+    suspend fun findBaseRoms(context: Context, games: List<Game>): Pair<ByteArray, ByteArray>? = withContext(Dispatchers.IO) {
+        var sm: ByteArray? = null
+        var z3: ByteArray? = null
+        wrongBaseRom = null
+        fun offer(bytes: ByteArray?) {
+            val found = bytes?.let(::asBaseRom) ?: return
+            // only the exact revisions the patches were written for: with another A Link to the Past revision the patched
+            // Zelda code is misaligned and the game crashes when Samus enters a portal
+            val md5 = java.security.MessageDigest.getInstance("MD5").digest(found.second).joinToString("") { "%02x".format(it) }
+            val expected = if (found.first == "sm") SM_MD5 else Z3_MD5
+            if (md5 != expected) {
+                android.util.Log.w("RunGenerator", "base ROM ${found.first} has md5 $md5, the patches need $expected")
+                if (wrongBaseRom == null) wrongBaseRom = if (found.first == "sm") "Super Metroid ROM must be (JU), md5 21f3e98d" else "ALttP ROM must be Japanese v1.0 (03a63945)"
+                return
+            }
+            if (found.first == "sm" && sm == null) sm = found.second
+            if (found.first == "z3" && z3 == null) z3 = found.second
+        }
+        for (game in games) {
+            if (sm != null && z3 != null) break
+            offer(runCatching { openRom(context, game).use { it.readBytes() } }.getOrNull())
+        }
+        val folders = listOf("Download/roms", "Download", "Roms", "roms", "ROMs").map { File("/sdcard", it) }
+        for (folder in folders) {
+            if (sm != null && z3 != null) break
+            folder.listFiles()?.filter { it.isFile && (it.length() == 0x300000L || it.length() == 0x100000L || it.length() == 0x300200L || it.length() == 0x100200L) }
+                ?.forEach { offer(runCatching { it.readBytes() }.getOrNull()) }
+        }
+        if (sm != null && z3 != null) sm!! to z3!! else null
+    }
+
+    /** Same layout as Rom.CombineSMZ3Rom in the tracker: 6 MB, Super Metroid banks interleaved, ALttP in the high banks. */
+    fun combine(sm: ByteArray, z3: ByteArray): ByteArray {
+        val out = ByteArray(0x600000)
+        // Like the tracker's stream reads, a source that runs out leaves the rest of the output zeroed.
+        fun copy(from: ByteArray, src: Int, to: Int) {
+            val n = minOf(0x8000, from.size - src)
+            if (n > 0) System.arraycopy(from, src, out, to, n)
+        }
+        var src = 0
+        var pos = 0
+        for (i in 0 until 0x40) { copy(sm, src, pos + 0x8000); src += 0x8000; pos += 0x10000 }
+        pos = 0
+        for (i in 0 until 0x40) { copy(sm, src, pos); src += 0x8000; pos += 0x10000 }
+        src = 0
+        pos = 0x400000
+        for (i in 0 until 0x20) { copy(z3, src, pos + 0x8000); src += 0x8000; pos += 0x10000 }
+        return out
+    }
+
+    /** Applies an "SPT1" patch (u32 length, then records of u32 offset, u32 length, bytes; little endian). */
+    fun applyPatch(base: ByteArray, patch: ByteArray): ByteArray {
+        val buf = ByteBuffer.wrap(patch).order(ByteOrder.LITTLE_ENDIAN)
+        val magic = ByteArray(4).also { buf.get(it) }
+        require(String(magic) == "SPT1") { "unknown patch format" }
+        val rom = base.copyOf(buf.int)
+        while (buf.hasRemaining()) {
+            val offset = buf.int
+            val length = buf.int
+            buf.get(rom, offset, length)
+        }
+        return rom
+    }
+
+    /** Writes the run's ROM and makes sure it is in the Lemuroid library; returns the game. */
+    suspend fun registerGame(context: Context, db: RetrogradeDatabase, slot: Int, name: String): Game = withContext(Dispatchers.IO) {
+        val file = RunStore.romFile(context, slot)
+        val uri = Uri.fromFile(file).toString()
+        val dao = db.gameDao()
+        val game = Game(
+            fileName = file.name, fileUri = uri, title = name, systemId = "snes", developer = null,
+            coverFrontUrl = null, lastIndexedAt = System.currentTimeMillis(),
+        )
+        dao.selectByFileUri(uri) ?: game.copy(id = dao.insert(listOf(game)).first().toInt())
+    }
+}
