+package com.swordfish.lemuroid.app.shared.game.viewmodel
+
+/** JNI bridge to the shared C core (core/smz3_state.c). */
+object Smz3Native {
+    init {
+        System.loadLibrary("smz3core")
+    }
+
+    /** {game, started, zeldaCleared, zeldaTotal, metroidCleared, metroidTotal}; game is 0 none, 1 zelda, 2 metroid, 3 credits. */
+    @JvmStatic external fun summarize(wram: ByteArray, sram: ByteArray): IntArray
+
+    @JvmStatic external fun clearedLocations(wram: ByteArray, sram: ByteArray): IntArray
+
+    @JvmStatic external fun locationName(index: Int): String
+
+    /** Level per inventory item, -1 when unknown right now. */
+    @JvmStatic external fun inventory(wram: ByteArray, sram: ByteArray): IntArray
+
+    /** "game|name|icon" of an inventory item (game 1 Zelda, 2 Metroid). */
+    @JvmStatic external fun inventoryInfo(index: Int): String
+
+    @JvmStatic external fun inventoryCount(): Int
+    @JvmStatic external fun zeldaRoomLocation(room: Int): Int
+
+    /** "game|region|name" of a location. */
+    @JvmStatic external fun locationInfo(index: Int): String
+
+    @JvmStatic external fun locationCount(): Int
+
+    /** Builds a playable ROM (6 MB) from the 3 MB Super Metroid and 1 MB ALttP ROMs, or null (see [lastError]). */
+    @JvmStatic external fun generate(
+        sm: ByteArray, z3: ByteArray, ipsNames: Array<String>, ipsData: Array<ByteArray>,
+        params: IntArray, logicNames: Array<String>, logicValues: IntArray,
+        linkRdc: ByteArray?, samusRdc: ByteArray?, plandoYaml: ByteArray?,
+    ): ByteArray?
+
+    @JvmStatic external fun lastError(): String
+
+    @JvmStatic external fun itemByName(name: String): Int
+
+    /** Tracker location indices in logic for the seed described by [params] and these ItemType numbers. */
+    @JvmStatic external fun reachable(params: IntArray, logicNames: Array<String>, logicValues: IntArray, items: IntArray, plandoYaml: ByteArray?): IntArray
+
+    /** The 15 hints a player may ask for, for the seed described by [params]; empty strings when none. */
+    @JvmStatic external fun helpTexts(params: IntArray, logicNames: Array<String>, logicValues: IntArray, plandoYaml: ByteArray?): Array<String?>
+
+    // Shared menu (core/ui): Kotlin forwards input and draws the commands.
+    @JvmStatic external fun uiInit()
+    @JvmStatic external fun uiSetSlot(i: Int, used: Boolean, name: String, summary: String)
+    @JvmStatic external fun uiSetSprites(game: Int, names: Array<String>)
+    @JvmStatic external fun uiInput(button: Int)
+    @JvmStatic external fun uiTouch(x: Int, y: Int)
+    @JvmStatic external fun uiIdle()
+    @JvmStatic external fun uiBusy(message: String)
+    @JvmStatic external fun uiDraw(): Array<String>
+    @JvmStatic external fun uiAction(): IntArray
+    /** Gives the menu the YAML of the chosen plando file (null clears it); returns the parse error, empty when fine. */
+    @JvmStatic external fun uiSetPlando(yaml: ByteArray?): String
+    @JvmStatic external fun uiPlandoName(): String
+    @JvmStatic external fun uiSettingsJson(seedIfRandom: Int): String
+    @JvmStatic external fun uiOption(opt: Int): Int
+    @JvmStatic external fun uiScreen(): Int
+    @JvmStatic external fun romName(settingsJson: String, seed: String): String
+}
diff --git a/lemuroid-app/src/main/java/com/swordfish/lemuroid/app/shared/game/viewmodel/Smz3Presentation.kt b/lemuroid-app/src/main/java/com/swordfish/lemuroid/app/shared/game/viewmodel/Smz3Presentation.kt
new file mode 100644
index 0000000..ae90492
--- /dev/null
+++ b/lemuroid-app/src/main/java/com/swordfish/lemuroid/app/shared/game/viewmodel/Smz3Presentation.kt
@@ -0,0 +1,515 @@
+package com.swordfish.lemuroid.app.shared.game.viewmodel
+
+import android.app.Presentation
+import android.content.Context
+import android.graphics.BitmapFactory
+import android.content.res.ColorStateList
+import android.graphics.Color
+import android.graphics.drawable.BitmapDrawable
+import android.os.Bundle
+import android.view.Display
+import android.view.Gravity
+import android.view.View
+import android.view.ViewGroup
+import android.widget.Button
+import android.widget.FrameLayout
+import android.widget.GridLayout
+import android.widget.ImageView
+import android.widget.LinearLayout
+import android.widget.ProgressBar
+import android.widget.ScrollView
+import android.widget.TextView
+
+/** The tracker shown on the secondary display: run summary, inventory and checks per region. */
+internal class Smz3Presentation(context: Context, display: Display) : Presentation(context, display) {
+    private class Region(val game: Int, val name: String, val locations: List<Int>)
+
+    private class ItemCell(val index: Int, val icon: ImageView, val count: TextView)
+
+    private val density = context.resources.displayMetrics.density
+    private fun dp(v: Int) = (v * density).toInt()
+
+    private companion object { const val HELP_TAB = 4; const val MAP_TAB = 3 }
+
+    private enum class Role { TEXT, DIM, ACCENT }
+
+    private var theme = Smz3Theme.ZELDA
+    private var selectedTab = 0
+    private lateinit var root: LinearLayout
+    private lateinit var tabRow: LinearLayout
+    private val themedText = mutableListOf<Pair<TextView, Role>>()
+    private val themedBars = mutableListOf<ProgressBar>()
+    private val itemNames by lazy { List(Smz3Native.inventoryCount()) { Smz3Native.inventoryInfo(it).split("|")[1] } }
+    private val tabs = mutableListOf<TextView>()
+    private val pages = mutableListOf<View>()
+
+    private lateinit var game: TextView
+    private lateinit var time: TextView
+    private lateinit var zeldaText: TextView
+    private lateinit var metroidText: TextView
+    private lateinit var zeldaBar: ProgressBar
+    private lateinit var metroidBar: ProgressBar
+    private lateinit var recent: TextView
+
+    private var map: Smz3MapView? = null
+    private var miniMap: Smz3MapView? = null
+    private val cells = mutableListOf<ItemCell>()
+    private val regions = mutableListOf<Region>()
+    private val regionViews = mutableListOf<Pair<TextView, ProgressBar>>()
+
+    private val countedItems = setOf(
+        "Bottles", "Hearts", "Heart Pieces", "Energy Tanks", "Reserve", "Missiles", "Super Missiles", "Power Bombs",
+    )
+    private val levelItems = setOf("Sword", "Shield", "Mail", "Gloves")
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        root = LinearLayout(context).apply { orientation = LinearLayout.VERTICAL }
+        tabRow = LinearLayout(context).apply { orientation = LinearLayout.HORIZONTAL }
+        val content = FrameLayout(context)
+        val pageViews = listOf("RUN" to buildRunPage(), "ITEMS" to buildItemsPage(), "CHECKS" to buildChecksPage(), "MAP" to buildMapPage(), "HELP" to buildHelpPage(), "CONFIG" to buildConfigPage())
+        pageViews.forEachIndexed { i, (title, page) ->
+            val tab = label(15f, Role.DIM).apply {
+                text = title
+                gravity = Gravity.CENTER
+                setPadding(0, dp(12), 0, dp(12))
+                setOnClickListener { select(i) }
+            }
+            tabs += tab
+            pages += page
+            tabRow.addView(tab, LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f))
+            content.addView(page, FrameLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT))
+        }
+        root.addView(tabRow, LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT))
+        root.addView(content, LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, 0, 1f))
+        setContentView(root)
+        select(0)
+        applyTheme(theme)
+    }
+
+    private fun select(index: Int) {
+        selectedTab = index
+        pages.forEachIndexed { i, p -> p.visibility = if (i == index) View.VISIBLE else View.GONE }
+        styleTabs()
+    }
+
+    private fun styleTabs() {
+        tabs.forEachIndexed { i, t ->
+            t.setTextColor(if (i == selectedTab) theme.accent else theme.dim)
+            t.setBackgroundColor(if (i == selectedTab) theme.tabSelected else theme.background)
+        }
+    }
+
+    private fun applyTheme(next: Smz3Theme) {
+        theme = next
+        root.setBackgroundColor(next.background)
+        tabRow.setBackgroundColor(next.background)
+        styleTabs()
+        for ((view, role) in themedText) {
+            view.typeface = next.typeface
+            view.setTextColor(
+                when (role) {
+                    Role.TEXT -> next.text
+                    Role.DIM -> next.dim
+                    Role.ACCENT -> next.accent
+                },
+            )
+        }
+        themedBars.forEach { it.progressTintList = ColorStateList.valueOf(next.bar) }
+        map?.setTheme(next)
+        miniMap?.setTheme(next)
+    }
+
+    private fun label(size: Float, role: Role = Role.TEXT) = TextView(context).apply {
+        textSize = size
+        themedText += this to role
+    }
+
+    private fun bar() = ProgressBar(context, null, android.R.attr.progressBarStyleHorizontal).apply {
+        max = 100
+        themedBars += this
+    }
+
+    private lateinit var percent: TextView
+    private lateinit var stats: TextView
+    private lateinit var closest: TextView
