+package com.swordfish.lemuroid.app.shared.game.viewmodel
+
+/** A boss or dungeon reward shown on the map; [icon] is a file in assets/smz3/rewards. */
+class BossMark(val x: Float, val y: Float, val icon: String, val done: Boolean)
+
+/** Which bosses are beaten, read from the game RAM, and where to draw them on the half-size map. */
+object Smz3Bosses {
+    private class Dungeon(val region: String, val room: Int)
+
+    // Boss room of each dungeon; the room's "boss defeated" flag is bit 0x0800 of its word at $7EF000 + 2 * room.
+    private val dungeons = listOf(
+        Dungeon("Eastern Palace", 200), Dungeon("Desert Palace", 51), Dungeon("Tower of Hera", 7),
+        Dungeon("Palace of Darkness", 90), Dungeon("Swamp Palace", 6), Dungeon("Skull Woods", 41),
+        Dungeon("Thieves' Town", 172), Dungeon("Ice Palace", 222), Dungeon("Misery Mire", 144),
+        Dungeon("Turtle Rock", 164), Dungeon("Castle Tower", 32),
+    )
+
+    // Super Metroid's four bosses: room pointer, event bit in the word at $7ED828, icon.
+    private class Boss(val room: Int, val bit: Int, val icon: String)
+    private val bosses = listOf(
+        Boss(0xA59F, 0x0100, "kraid_boss_token.png"), Boss(0xCD13, 0x0200, "phantoon_boss_token.png"),
+        Boss(0xDA60, 0x0400, "draygon_boss_token.png"), Boss(0xB32E, 0x0800, "ridley_boss_token.png"),
+    )
+
+    private fun u16(w: ByteArray, a: Int) = (w[a].toInt() and 0xFF) or ((w[a + 1].toInt() and 0xFF) shl 8)
+
+    fun marks(wram: ByteArray, discovery: Smz3Discovery): List<BossMark> {
+        if (wram.size < 0x10000) return emptyList()
+        val out = mutableListOf<BossMark>()
+        for (d in dungeons) {
+            val box = discovery.zeldaBox(d.region) ?: continue
+            out += BossMark(box[0] - 12f, box[1] - 12f, "unknown.png", (u16(wram, 0xF000 + 2 * d.room) and 0x0800) != 0)
+        }
+        val events = u16(wram, 0xD828)
+        for (b in bosses) {
+            val c = discovery.metroidRoomCentre(b.room) ?: continue
+            out += BossMark(c.x, c.y, b.icon, (events and b.bit) != 0)
+        }
+        return out
+    }
+}
diff --git a/lemuroid-app/src/main/java/com/swordfish/lemuroid/app/shared/game/viewmodel/Smz3Discovery.kt b/lemuroid-app/src/main/java/com/swordfish/lemuroid/app/shared/game/viewmodel/Smz3Discovery.kt
new file mode 100644
index 0000000..6324f98
--- /dev/null
+++ b/lemuroid-app/src/main/java/com/swordfish/lemuroid/app/shared/game/viewmodel/Smz3Discovery.kt
@@ -0,0 +1,176 @@
+package com.swordfish.lemuroid.app.shared.game.viewmodel
+
+import android.content.Context
+import android.graphics.RectF
+import org.json.JSONArray
+import org.json.JSONObject
+import java.io.File
+
+/** Where the player is on the combined map, in pixels of the half-size map image. */
+class MapPosition(val x: Float, val y: Float)
+
+/**
+ * What the player has seen in this run, and where they are now. Super Metroid is tracked by room, ALttP by
+ * overworld screen and dungeon. Rectangles are in pixels of the half-size combined map (1623 x 958).
+ */
+class Smz3Discovery(context: Context) {
+    private class SmRoom(val area: Int, val mx: Int, val my: Int, val w: Int, val h: Int)
+
+    private val smRooms: Map<Int, SmRoom> = runCatching {
+        val a = JSONArray(context.assets.open("smz3/sm_rooms.json").use { String(it.readBytes()) })
+        (0 until a.length()).associate { i ->
+            a.getJSONArray(i).let { r -> r.getInt(0) to SmRoom(r.getInt(1), r.getInt(2), r.getInt(3), r.getInt(4), r.getInt(5)) }
+        }
+    }.getOrDefault(emptyMap())
+
+    private val z3Regions: Map<String, FloatArray> = runCatching {
+        val o = JSONObject(context.assets.open("smz3/z3_regions.json").use { String(it.readBytes()) })
+        o.keys().asSequence().associateWith { k -> o.getJSONArray(k).let { a -> FloatArray(4) { a.getDouble(it).toFloat() } } }
+    }.getOrDefault(emptyMap())
+
+    /** Half-size map position of every location marker, by location index (asset `map_markers.json`). */
+    private val markerPos: Map<Int, MapPosition> = runCatching {
+        val a = JSONArray(context.assets.open("smz3/map_markers.json").use { String(it.readBytes()) })
+        (0 until a.length()).associate { i -> a.getJSONArray(i).let { m -> m.getInt(0) to MapPosition(m.getInt(1).toFloat(), m.getInt(2).toFloat()) } }
+    }.getOrDefault(emptyMap())
+
+    val rooms = linkedSetOf<Int>()
+    val screens = linkedSetOf<Int>()
+    val dungeons = linkedSetOf<String>()
+    var position: MapPosition? = null
+        private set
+    private var currentArea = -1
+    private var lastOverworld: MapPosition? = null
+    private var dirty = false
+
+    fun load(file: File) {
+        rooms.clear(); screens.clear(); dungeons.clear()
+        runCatching {
+            val o = JSONObject(file.readText())
+            o.optJSONArray("rooms")?.let { a -> for (i in 0 until a.length()) rooms += a.getInt(i) }
+            o.optJSONArray("screens")?.let { a -> for (i in 0 until a.length()) screens += a.getInt(i) }
+            o.optJSONArray("dungeons")?.let { a -> for (i in 0 until a.length()) dungeons += a.getString(i) }
+        }
+    }
+
+    fun saveIfChanged(file: File) {
+        if (!dirty) return
+        dirty = false
+        file.writeText(JSONObject().put("rooms", JSONArray(rooms.toList())).put("screens", JSONArray(screens.toList()))
+            .put("dungeons", JSONArray(dungeons.toList())).toString())
+    }
+
+    private fun u16(w: ByteArray, a: Int) = (w[a].toInt() and 0xFF) or ((w[a + 1].toInt() and 0xFF) shl 8)
+
+    /** Updates the position and the seen sets from the game RAM; [game] is 1 for ALttP and 2 for Super Metroid. */
+    fun update(wram: ByteArray, game: Int) {
+        if (wram.size < 0x10000) return
+        when (game) {
+            2 -> updateMetroid(wram)
+            1 -> updateZelda(wram)
+        }
+    }
+
+    private val roomFilter = Smz3RoomFilter()
+
+    private fun updateMetroid(w: ByteArray) {
+        val room = u16(w, 0x79B)
+        if (!roomFilter.accept(w[0x998].toInt() and 0xFF, room)) return
+        val info = smRooms[room] ?: return
+        if (rooms.add(room)) { dirty = true; timber.log.Timber.i("SMZ3 SM room discovered %04x".format(room)) }
+        currentArea = info.area
+        val origin = SM_ORIGINS.getOrNull(info.area) ?: return
+        val tileX = u16(w, 0x7A1) + u16(w, 0xAF6) / 256f
+        val tileY = u16(w, 0x7A3) + u16(w, 0xAFA) / 256f
+        position = MapPosition((origin.first - 16 + 32 * tileX) / 2f, (origin.second - 16 + 32 * tileY) / 2f)
+    }
+
+    private fun updateZelda(w: ByteArray) {
+        val dark = (w[0xF3CA].toInt() and 0x40) != 0
+        val indoors = w[0x1B].toInt() != 0
+        val dungeon = DUNGEONS[w[0x040C].toInt() and 0xFF]
+        if (indoors && dungeon != null) {
+            if (dungeons.add(dungeon)) dirty = true
+            z3Regions[dungeon]?.let { position = MapPosition((it[0] + it[2]) / 2f, (it[1] + it[3]) / 2f) }
+            return
+        }
+        if (indoors) {
+            // Houses and caves: the room number is the check address of the chest inside, so the map can place Link there
+            // even when the game was entered indoors (no overworld position seen yet).
+            val room = u16(w, 0xA0)
+            val marker = Smz3Native.zeldaRoomLocation(room).let { if (it >= 0) markerPos[it] else null }
+            position = marker ?: lastOverworld ?: position
+            return
+        }
+        val screen = (w[0x8A].toInt() and 0x3F) + if (dark) 64 else 0
+        if (screens.add(screen)) dirty = true
+        val x = u16(w, 0x22).coerceIn(0, 4095)
+        val y = u16(w, 0x20).coerceIn(0, 4095)
+        val scale = 958f / 4096f / 2f
+        position = MapPosition(x * scale, y * scale + if (dark) 479f else 0f).also { lastOverworld = it }
+    }
+
+    /**
+     * The part of the half-size map to enlarge when the mini map is tapped: the whole Super Metroid area Samus is in,
+     * or both ALttP worlds. Null when unknown (the whole map is shown).
+     */
+    fun areaBox(game: Int): RectF? {
+        if (game == 1) return RectF(0f, 0f, 480f, 958f)
+        val origin = SM_ORIGINS.getOrNull(currentArea) ?: return null
+        var box: RectF? = null
+        for (r in smRooms.values) {
+            if (r.area != currentArea) continue
+            val x = (origin.first - 16 + 32 * r.mx) / 2f
+            val y = (origin.second - 16 + 32 * r.my) / 2f
+            val rect = RectF(x, y, x + 16f * r.w, y + 16f * r.h)
+            box = box?.also { it.union(rect) } ?: rect
+        }
+        return box?.also { it.inset(-24f, -24f) }
+    }
+
+    /** Bounding box of a Zelda region's item markers, in half-size map pixels, or null. */
+    fun zeldaBox(name: String): FloatArray? = z3Regions[name]
+
+    /** Centre of a Super Metroid room on the half-size map, or null. */
+    fun metroidRoomCentre(ptr: Int): MapPosition? {
+        val r = smRooms[ptr] ?: return null
+        val origin = SM_ORIGINS.getOrNull(r.area) ?: return null
+        return MapPosition((origin.first - 16 + 32 * r.mx) / 2f + 8f * r.w, (origin.second - 16 + 32 * r.my) / 2f + 8f * r.h)
+    }
+
+    /** Rectangles of the map that count as discovered. */
+    fun rects(): List<RectF> {
+        val out = mutableListOf<RectF>()
+        for (ptr in rooms) {
+            val r = smRooms[ptr] ?: continue
+            val origin = SM_ORIGINS.getOrNull(r.area) ?: continue
+            val x = (origin.first - 16 + 32 * r.mx) / 2f
+            val y = (origin.second - 16 + 32 * r.my) / 2f
+            out += RectF(x, y, x + 16f * r.w, y + 16f * r.h)
+        }
+        val cell = 958f / 8f / 2f
+        for (s in screens) {
+            val dark = s >= 64
+            val col = (s % 64) % 8
+            val row = (s % 64) / 8
+            out += RectF(col * cell, row * cell + if (dark) 479f else 0f, (col + 1) * cell, (row + 1) * cell + if (dark) 479f else 0f)
+        }
+        for (name in dungeons) {
+            val b = z3Regions[name] ?: continue
+            out += RectF(b[0] - 26f, b[1] - 26f, b[2] + 26f, b[3] + 26f)
+        }
+        return out
+    }
+
+    companion object {
+        /** Combined-map pixel (full size) where each Super Metroid area's map tile grid starts, measured from the item positions. */
+        private val SM_ORIGINS = listOf(998 to 80, 902 to 656, 1894 to 1296, 2086 to -240, 1798 to 656)
+
+        private val DUNGEONS = mapOf(
+            0x00 to "Hyrule Castle", 0x02 to "Hyrule Castle", 0x04 to "Eastern Palace", 0x06 to "Desert Palace",
+            0x08 to "Castle Tower", 0x0A to "Swamp Palace", 0x0C to "Palace of Darkness", 0x0E to "Misery Mire",
+            0x10 to "Skull Woods", 0x12 to "Ice Palace", 0x14 to "Tower of Hera", 0x16 to "Thieves' Town",
+            0x18 to "Turtle Rock", 0x1A to "Ganon's Tower",
+        )
+    }
+}
diff --git a/lemuroid-app/src/main/java/com/swordfish/lemuroid/app/shared/game/viewmodel/Smz3Help.kt b/lemuroid-app/src/main/java/com/swordfish/lemuroid/app/shared/game/viewmodel/Smz3Help.kt
