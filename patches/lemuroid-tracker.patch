+package com.swordfish.lemuroid.app.shared.game.viewmodel
+
+/**
+ * Decides which Super Metroid room samples can be trusted. After the Zelda to Super Metroid portal the room pointer
+ * ($79B) keeps a stale value (the Kraid room) for a sample or two while the game is not in normal gameplay, so a
+ * sample counts only when the game state ($0998) is 8 and the same room was read in two consecutive samples.
+ */
+class Smz3RoomFilter {
+    private var candidate = -1
+    private var count = 0
+
+    /** True when [room], read while the game was in [gameState], can be accepted. */
+    fun accept(gameState: Int, room: Int): Boolean {
+        if (gameState != NORMAL_GAMEPLAY) { candidate = -1; count = 0; return false }
+        if (room == candidate) count++ else { candidate = room; count = 1 }
+        return count >= 2
+    }
+
+    companion object {
+        const val NORMAL_GAMEPLAY = 8
+    }
+}
