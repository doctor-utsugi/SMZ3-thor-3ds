+++ b/lemuroid-app/src/main/java/com/swordfish/lemuroid/app/mobile/feature/runs/RunLogic.kt
@@ -0,0 +1,56 @@
+package com.swordfish.lemuroid.app.mobile.feature.runs
+
+import com.swordfish.lemuroid.app.shared.game.viewmodel.Smz3Native
+import org.json.JSONObject
+
+/** Asks the C generator which locations are in logic for a run with the inventory read from the game. */
+object RunLogic {
+    private val zeldaItems = mapOf(
+        "Sword" to "ProgressiveSword", "Shield" to "ProgressiveShield", "Mail" to "ProgressiveTunic",
+        "Gloves" to "ProgressiveGlove", "Bow" to "Bow", "Silver Arrows" to "SilverArrows",
+        "Blue Boomerang" to "BlueBoomerang", "Red Boomerang" to "RedBoomerang", "Hookshot" to "Hookshot",
+        "Fire Rod" to "Firerod", "Ice Rod" to "Icerod", "Bombos" to "Bombos", "Ether" to "Ether", "Quake" to "Quake",
+        "Lamp" to "Lamp", "Hammer" to "Hammer", "Bug Net" to "Bugnet", "Book" to "Book", "Somaria" to "Somaria",
+        "Byrna" to "Byrna", "Cape" to "Cape", "Mirror" to "Mirror", "Boots" to "Boots", "Flippers" to "Flippers",
+        "Moon Pearl" to "MoonPearl", "Powder" to "Powder", "Mushroom" to "Mushroom", "Shovel" to "Shovel",
+        "Flute" to "Flute", "Bottles" to "Bottle", "Half Magic" to "HalfMagic",
+    )
+
+    private val metroidItems = mapOf(
+        "Varia" to "Varia", "Gravity" to "Gravity", "Morph Ball" to "Morph", "Bombs" to "Bombs",
+        "Spring Ball" to "SpringBall", "Screw Attack" to "ScrewAttack", "Hi-Jump" to "HiJump",
+        "Space Jump" to "SpaceJump", "Speed Booster" to "SpeedBooster", "Grapple" to "Grapple", "X-Ray" to "XRay",
+        "Charge" to "Charge", "Ice" to "Ice", "Wave" to "Wave", "Spazer" to "Spazer", "Plasma" to "Plasma",
+    )
+
+    /** ItemType names, repeated for counts, for the inventory levels read from memory (see smz3_inventory.c). */
+    fun items(names: List<String>, levels: IntArray): List<String> {
+        val out = mutableListOf<String>()
+        for ((i, name) in names.withIndex()) {
+            val level = levels.getOrElse(i) { 0 }
+            if (level <= 0) continue
+            zeldaItems[name]?.let { type ->
+                val count = if (name == "Sword" || name == "Shield" || name == "Mail" || name == "Gloves" || name == "Bottles") level else 1
+                for (n in 0 until count) out += type
+            }
+            metroidItems[name]?.let { out += it }
+            when (name) {
+                "Energy Tanks" -> for (n in 0 until level) out += "ETank"
+                "Reserve" -> for (n in 0 until level / 100) out += "ReserveTank"
+                "Missiles" -> for (n in 0 until level / 5) out += "Missile"
+                "Super Missiles" -> for (n in 0 until level / 5) out += "Super"
+                "Power Bombs" -> for (n in 0 until level / 5) out += "PowerBomb"
+            }
+        }
+        return out
+    }
+
+    /** Tracker location indices in logic for the run's seed and settings, with the inventory read from the game. */
+    fun reachable(seed: String, settings: String, items: List<String>): Set<Int> {
+        val json = JSONObject(settings.ifBlank { "{}" })
+        val (names, values) = RunGenerator.logicNames(json)
+        val ids = items.map { Smz3Native.itemByName(it) }.filter { it > 0 }.toIntArray()
+        val params = RunGenerator.nativeParams(json, seed.toIntOrNull() ?: 0)
+        return Smz3Native.reachable(params, names, values, ids, RunGenerator.plandoBytes(json)).toSet()
+    }
+}
diff --git a/lemuroid-app/src/main/java/com/swordfish/lemuroid/app/mobile/feature/runs/RunStore.kt b/lemuroid-app/src/main/java/com/swordfish/lemuroid/app/mobile/feature/runs/RunStore.kt
