+static void trackerDraw()
+{
+    if (gfxGetScreenFormat(settings3DS.SecondScreen) != GSP_RGB565_OES) gfxSetScreenFormat(settings3DS.SecondScreen, GSP_RGB565_OES);
+    trkFb = (u16 *)gfxGetFramebuffer(settings3DS.SecondScreen, GFX_LEFT, NULL, NULL);
+    if (cardState) {   // the game has ended: the run's details instead of the tracker
+        setClip(0, 0, 320, 240);
+        drawCardDetails();
+        impl3dsFlushScreen(settings3DS.SecondScreen, false, false);
+        gfxScreenSwapBuffers(settings3DS.SecondScreen, false);
+        dirty = false;
+        return;
+    }
+    if (!tabShown(tab)) tab = TAB_RUN;
+    if (trk.started) theme = trk.game == SMZ3_GAME_METROID ? THEME_METROID : trk.game == SMZ3_GAME_ZELDA ? THEME_ZELDA : theme;
+    setClip(0, 0, 320, 240);
+    fill(0, 0, 320, 240, theme.bg);
+    if (daily) drawDailyStrip();
+    drawTabs();
+    int y0 = topOfTabs() + TAB_H, y1 = 240;
+    setClip(0, y0, 320, y1);
+    switch (tab) {
+    case TAB_RUN: drawRun(y0, y1); break;
+    case TAB_ITEMS: drawItems(y0, y1); break;
+    case TAB_CHECKS: drawChecks(y0, y1); break;
+    case TAB_MAP: drawMapTab(y0, y1); break;
+    case TAB_HELP: drawHelp(y0, y1); break;
+    case TAB_DAILY: drawDaily(y0, y1); break;
+    }
+    clampScroll(tab);
+    setClip(0, 0, 320, 240);
+    impl3dsFlushScreen(settings3DS.SecondScreen, false, false);
+    gfxScreenSwapBuffers(settings3DS.SecondScreen, false);
+    dirty = false;
+}
+
+// ---- touch: the tabs, scrolling by dragging, the map's buttons and panning
+
+static int touchX, touchY, touchStartX, touchStartY, touchMoved;
+static u64 touchAt;
+static bool touching = false;
+
+static void clampScroll(int t)
+{
+    int view = 240 - topOfTabs() - TAB_H, max = contentH[t] - view + 8;
+    if (scrollY[t] > max) scrollY[t] = max;
+    if (scrollY[t] < 0) scrollY[t] = 0;
+}
+
+static void trackerTap(int x, int y)
+{
+    int y0 = topOfTabs() + TAB_H, y1 = 240;
+    if (tab == TAB_RUN && scPick >= 0) { pickerTap(x, y, y0, y1); return; }
+    if (tab == TAB_RUN && shortcutTap(x, y, false)) return;
+    if (tab == TAB_RUN && x >= 162 && y >= runMiniTop && y < runMiniBottom) { tab = TAB_MAP; bigMap = miniMap; bigMap.zoom = 0.45f; dv.picked = false; dv.world = false; return; }
+    if (tab == TAB_CHECKS) {
+        int r = -1;
+        drawChecks(y0, y1, &r, y);
+        if (r >= 0) regions[r].open = !regions[r].open;
+        return;
+    }
+    if (tab == TAB_MAP && y >= y1 - 24) {
+        const char *const *names;
+        const int *w;
+        int n = mapButtons(&names, &w);
+        for (int i = 0; i < n; i++) {
+            int bx0, bx1;
+            mapButtonRect(i, n, w, &bx0, &bx1);
+            if (x < bx0 || x >= bx1) continue;
+            const char *b = names[i];
+            if (!strcmp(b, "-") && bigMap.zoom > 0.2f) bigMap.zoom /= 1.5f;
+            else if (!strcmp(b, "+") && bigMap.zoom < 1.5f) bigMap.zoom *= 1.5f;
+            else if (!strcmp(b, "FOLLOW")) bigMap.follow = !bigMap.follow;
+            else if (!strcmp(b, "CENTER")) { if (disc.has_position) { bigMap.cx = disc.x; bigMap.cy = disc.y; } else { bigMap.cx = 811; bigMap.cy = 479; bigMap.zoom = 0.19f; } }
+            else if (!strcmp(b, "DUNGEON")) { if (haveLive) { dv.picked = false; dv.world = false; } else dungeonPick(dv, dv.d, dv.picked ? dv.idx : dmeta.below[dv.d]); }
+            else if (!strcmp(b, "<")) dungeonStep(dv, -1);
+            else if (!strcmp(b, ">")) dungeonStep(dv, 1);
+            else if (!strcmp(b, "HERE")) { dv.picked = false; dv.world = !haveLive; }
+            else if (!strcmp(b, "WORLD")) dv.world = true;
+            return;
+        }
+    }
+    if (tab == TAB_MAP && dungeonShowing(dv) && dungeonFloorTap(x, y, y0)) return;
+    if (tab == TAB_HELP && hintButtonY >= 0) {
+        int by = hintButtonY - scrollY[TAB_HELP];
+        if (x >= 8 && x < 160 && y >= by && y < by + 22) {
+            char out[SMZ_HOST_HELP_TEXT + 32];
+            smz3AskHelp(out, sizeof out);
+            snprintf(helpNote, sizeof helpNote, "%s", out);
+            readHelp();
+        }
+    }
+}
+
+// A touch on the tab row picks that tab; true when it was there.
+static bool tabTouch(int x, int y)
+{
+    int ty = topOfTabs();
+    if (y < ty || y >= ty + TAB_H) return false;
+    int order[TAB_COUNT], n = shownTabs(order), w = (320 - PAUSE_W) / n, i = x / w;
+    if (i < n) { tab = order[i]; scPick = -1; dirty = true; }
+    return true;
+}
+
+static void dragBy(int dx, int dy)
+{
+    if (tab == TAB_MAP && dungeonShowing(dv)) return;
+    if (tab == TAB_MAP) { bigMap.follow = false; bigMap.cx -= dx / bigMap.zoom; bigMap.cy -= dy / bigMap.zoom; dirty = true; }
+    else if (tab == TAB_CHECKS || tab == TAB_HELP || tab == TAB_DAILY) { scrollY[tab] -= dy; clampScroll(tab); dirty = true; }
+}
+
+// debug aid: sdmc:/SMZ3/debug_touch.txt, lines "t <x> <y>" (a tap) or "d <dx> <dy>" (a drag), for driving the tracker
+// from a script on an emulator; the file is removed once read
+static void debugTouches()
+{
+    FILE *f = fopen(SMZ_DIR "/debug_touch.txt", "r");
+    if (!f) return;
+    char kind;
+    int a, b;
+    while (fscanf(f, " %c %d %d", &kind, &a, &b) == 3) {
+        if (kind == 't' && !tabTouch(a, b)) trackerTap(a, b);
+        if (kind == 'd') dragBy(a, b);
+    }
+    fclose(f);
+    remove(SMZ_DIR "/debug_touch.txt");
+}
+
+bool smz3TrackerTouch(unsigned keysDown, unsigned keysHeld)
+{
+    if (!smz3IsRun() || curSlot < 0) return false;
+    bool held = keysHeld & KEY_TOUCH;
+    if (held) {
+        touchPosition t;
+        hidTouchRead(&t);
+        if (keysDown & KEY_TOUCH) {
+            if (cardState) {   // the details: a tap before their buttons only jumps to them
+                touching = false;
+                if (cardSkip() || t.py < CARD_BTN_Y || t.py >= CARD_BTN_Y + 32) return true;
+                if (cardState == 2) {   // Back to menu: the touch opens the menu, which goes on to the run list
+                    if (t.px < 80 || t.px >= 240) return true;
+                    wantRunList = true;
+                    return false;
+                }
+                cardState = 2;
+                dirty = true;
+                if (t.px < 160) { wantRunList = true; return false; }
+                return true;
+            }
+            int ty = topOfTabs();
+            if (t.px >= 320 - PAUSE_W && t.py >= ty && t.py < ty + TAB_H) return false;   // the pause button: the emulator's menu
+            touching = !tabTouch(t.px, t.py);
+            touchAt = osGetTime();
+            touchStartX = touchX = t.px; touchStartY = touchY = t.py; touchMoved = 0;
+            return true;
+        }
+        if (!touching) return true;
+        int dx = t.px - touchX, dy = t.py - touchY;
+        touchMoved += abs(dx) + abs(dy);
+        touchX = t.px; touchY = t.py;
+        if (touchMoved > 6 && (dx || dy)) dragBy(dx, dy);
+        // holding a filled ALttP slot opens its picker
+        if (touchMoved <= 6 && tab == TAB_RUN && scPick < 0 && osGetTime() - touchAt >= 600 && shortcutTap(touchStartX, touchStartY, true)) { touching = false; dirty = true; }
+        return true;
+    }
+    if (touching) {
+        touching = false;
+        if (touchMoved <= 6) { trackerTap(touchStartX, touchStartY); dirty = true; }
+    }
+    return false;
+}
+
+// ---- reading the run once a second
+
+static u64 turboWallMs;   // wall time spent in fast forward since the last reading, and the SNES time it emulated
+static double turboEmuMs;
+
+static void trackerUpdate()
+{
+    static u64 startedAt = 0;
+    // debug aid: sdmc:/SMZ3/debug_poke.txt, lines "w <hex offset> <hex value>" (WRAM) or "s ..." (SRAM) are OR-ed into memory,
+    // "W" and "S" write the value as it is
+    if (FILE *dbg = fopen(SMZ_DIR "/debug_poke.txt", "r")) {
+        char kind;
+        unsigned off, val;
+        while (fscanf(dbg, " %c %x %x", &kind, &off, &val) == 3) {
+            if (kind == 'w' && off < 0x20000) Memory.RAM[off] |= (u8)val;
+            if (kind == 's' && off < 0x20000) Memory.SRAM[off] |= (u8)val;
+            if (kind == 'W' && off < 0x20000) Memory.RAM[off] = (u8)val;
+            if (kind == 'S' && off < 0x20000) Memory.SRAM[off] = (u8)val;
+        }
+        fclose(dbg);
+    }
+    smz3_summary sum;
+    smz3_summarize(Memory.RAM, 0x20000, Memory.SRAM, 0x20000, &sum);
+    if (sum.started && !startedAt) startedAt = osGetTime();
+    if (!sum.started) startedAt = 0;
+    // play time, proof of run and the online ladder: the shared tracker reads the same memory as the other frontends
+    static int calls = 0, proofDirty = 0, queued = 0;
+    static u64 lastMs = 0, nextToken = 0;
+    static int deadBosses = 0;
+    static int64_t nextHintAsk = 0;
+    char discPath[96];
+    snprintf(discPath, sizeof discPath, RUN_DIR "/slot%d.discovery", curSlot);
+    if (gPlaySlot != curSlot) {
+        curSlot = gPlaySlot;
+        snprintf(discPath, sizeof discPath, RUN_DIR "/slot%d.discovery", curSlot);
+        SmzRun r0;
+        char rp[96];
+        snprintf(rp, sizeof rp, RUN_DIR "/slot%d.run", curSlot);
+        memset(&r0, 0, sizeof r0);
+        if (curSlot >= 0 && smz_run_load(rp, &r0) == 0) smz_tracker_reset(&trk, r0.play_ms, r0.save_ms, r0.save_zelda, r0.save_metroid);
+        else smz_tracker_reset(&trk, 0, 0, 0, 0);
+        snprintf(runName, sizeof runName, "%s", r0.name);
+        smz_goal_from_settings(r0.settings, &trk.goal);   // a daily challenge ends at its goal
+        gChallenge = strstr(r0.settings, "\"challenge\":true") != NULL;
+        finishedBefore = r0.game == 3;
+        finalMs = r0.play_ms;
+        cardState = 0;
+        finalRun = r0;
+        discoveredOnly = strstr(r0.settings, "\"mapMode\":\"discovered\"") != NULL;
+        fixedKeys = strstr(r0.settings, "\"showFixedKeys\"") ? strstr(r0.settings, "\"showFixedKeys\":true") != NULL : !strcmp(r0.name, "Cozy run");
+        dv = {false, false, 2, 0};
+        smz_disc_init(&disc, &SMZ3_MAP_DATA);
+        size_t dn = 0;
+        char *dt = (char *)readFile(discPath, &dn);
+        if (dt) { char *z = (char *)realloc(dt, dn + 1); if (z) { z[dn] = 0; smz_disc_load(&disc, z); dt = z; } free(dt); }
+        size_t pn = 0;
+        char *pt = (char *)readFile(smzOnlineProofPath(curSlot), &pn);
+        if (pt) { char *z = (char *)realloc(pt, pn + 1); if (z) { z[pn] = 0; pt = z; } }
+        smz_proof_parse(&proof, pt ? pt : "");
+        free(pt);
+        daily = curSlot == SMZ_DAILY_SLOT && smzDailyLoad(&dr);
+        deadBosses = smz_daily_prepared_bosses(r0.settings);
+        dailyDoneMs = r0.game == 3 ? 1 : 0;   // finished before: its time was sent then
+        nextHintAsk = newHintUntil = 0;
+        lastMs = osGetTime();
+        calls = proofDirty = queued = 0;
+        nextToken = 0;
+        readHelp();
+        helpNote[0] = 0;
+        tab = TAB_RUN;
+        memset(scrollY, 0, sizeof scrollY);
+        bigMap = {811, 479, 0.19f, false};
+        miniMap = {811, 479, 0.45f, true};
+    }
+    u64 nowMs = osGetTime();
+    int dt = (int)(nowMs - lastMs);
+    lastMs = nowMs;
+    if (dt < 0 || dt > 3000) dt = 1000;   // a pause in between is not play time
+    else if (turboWallMs > 0) dt += (int)lround(turboEmuMs) - (int)turboWallMs;   // fast forward runs unpaced: its frames count at the SNES rate
+    if (dt < 0) dt = 0;
+    turboWallMs = 0; turboEmuMs = 0;
+    if (deadBosses) smz_prepared_apply(deadBosses, Memory.RAM, 0x20000, Memory.SRAM, 0x20000);   // a mid-game daily start
+    smz_tracker_tick(&trk, Memory.RAM, 0x20000, Memory.SRAM, 0x20000, dt, 1);
+    if (trk.started) smz_disc_update(&disc, Memory.RAM, 0x20000, (int)trk.game);
+    dungeonReadLive();
+    if (trk.game == 3 && !cardState) cardBegin();
+    if (daily && trk.started && smz_daily_note_began(&dr, smzDailyNowMs())) smzDailySave(&dr);   // the clock starts with the game, as in the ladder
+    int online = curSlot >= 0 && !finishedBefore ? smzOnlineSlotKind(curSlot) : 0;   // a finished run played again sends nothing
+    if ((online || (daily && !finishedBefore)) && trk.started && smz_proof_note(&proof, trk.cleared, SMZ_TRK_MAX_LOCS, trk.base_ms + trk.pending_ms)) proofDirty = 1;
+    // debug aid: sdmc:/SMZ3/debug_token.txt asks for the run's token even before the game has started
+    if (online) if (FILE *df = fopen(SMZ_DIR "/debug_token.txt", "r")) { fclose(df); remove(SMZ_DIR "/debug_token.txt"); smzOnlineEnsureToken(curSlot); }
+    if (online && trk.started && trk.running && nowMs >= nextToken) { nextToken = nowMs + 60000; smzOnlineEnsureToken(curSlot); }
+    if (curSlot >= 0 && (++calls % 10 == 0 || trk.game == 3)) {   // the run's file keeps the play time and the progress
+        char rp[96];
+        SmzRun r1;
+        snprintf(rp, sizeof rp, RUN_DIR "/slot%d.run", curSlot);
+        bool have = smz_run_load(rp, &r1) == 0 && trk.started;
+        if (have && finishedBefore) {   // it keeps its result; its rewards only add up
+            r1.boss_mask |= trk.boss_mask; r1.crystal_mask |= trk.crystal_mask;
+            r1.last_played = (int64_t)time(NULL) * 1000;
+            smz_run_save(rp, &r1);
+        } else if (have) {
+            r1.play_ms = trk.base_ms + trk.pending_ms;
+            r1.last_played = (int64_t)time(NULL) * 1000;
+            r1.game = (int)trk.game;
+            r1.zelda_cleared = (int)trk.zelda_cleared; r1.metroid_cleared = (int)trk.metroid_cleared;
+            r1.boss_mask = trk.boss_mask; r1.crystal_mask = trk.crystal_mask;
+            if (trk.save_ms > 0) { r1.save_ms = trk.save_ms; r1.save_zelda = trk.save_zelda; r1.save_metroid = trk.save_metroid; }
+            if (smz_run_save(rp, &r1) == 0) smz_tracker_commit(&trk);
+            if ((online || daily) && proofDirty) {
+                static char ptxt[SMZ_PROOF_MAX * 24];
+                size_t pl = smz_proof_format(&proof, ptxt, sizeof ptxt);
+                FILE *pf = fopen(smzOnlineProofPath(curSlot), "wb");
+                if (pf) { fwrite(ptxt, 1, pl, pf); fclose(pf); proofDirty = 0; }
+            }
+            if (daily && trk.game == 3 && !queued && !dailyDoneMs) {   // the goal: the real time since the game's start goes to the server
+                queued = 1;
+                dailyDoneMs = smzDailyNowMs() - smz_daily_clock_from(&dr);
+                smzDailyQueueFinish(dailyDoneMs);
+            }
+            if (online && trk.game == 3 && !queued && !finishedBefore && strstr(r1.settings, "\"defaultRules\":true")) {
+                queued = 1;
+                smzOnlineQueueFinish(curSlot, r1.play_ms, atoi(r1.seed));
+            }
+        }
+        if (disc.dirty) {
+            static char dtext[8192];
+            int n = smz_disc_save(&disc, dtext, sizeof dtext);
+            FILE *df = n > 0 ? fopen(discPath, "wb") : NULL;
+            if (df) { fwrite(dtext, 1, n, df); fclose(df); disc.dirty = 0; }
+        }
+    }
+    if (daily) {
+        int64_t now = smzDailyNowMs();
+        SmzDailyRun fresh;
+        if (smzDailyTakeHints(&fresh)) {
+            if (fresh.n_hints > dr.n_hints) newHintUntil = now + 15000;
+            if (dr.began_at && !fresh.began_at) { fresh.began_at = dr.began_at; smzDailySave(&fresh); }   // set while the hints were on their way
+            dr = fresh;
+        }
+        if (trk.game != 3 && !finishedBefore && dr.next_hint_at > 0 && now >= dr.next_hint_at && now >= nextHintAsk) { nextHintAsk = now + 15000; smzDailyRequestHints(&dr); }
+    }
+    // debug aid: with sdmc:/SMZ3/debug_panel.txt present, where Samus and Link are goes to debug_state.txt, which is how a
+    // blind input route can be followed on an emulator whose picture is garbled
+    if (FILE *dp = fopen(SMZ_DIR "/debug_panel.txt", "r")) {
+        fclose(dp);
+        const u8 *r = Memory.RAM;
+        if (FILE *st = fopen(SMZ_DIR "/debug_state.txt", "w")) {
+            fprintf(st, "%u %u %u %u %u %u %u %u %u %u %u %u %u %u\n", r[0x79B] | r[0x79C] << 8, r[0xAF6] | r[0xAF7] << 8, r[0xAFA] | r[0xAFB] << 8,
+                    r[0x9C6] | r[0x9C7] << 8, sum.metroid_cleared, sum.zelda_cleared, r[0x9D2] | r[0x9D3] << 8,
+                    Memory.SRAM[0x33FE], r[0xA0] | r[0xA1] << 8, r[0x22] | r[0x23] << 8, r[0x20] | r[0x21] << 8, r[0x1B],
+                    r[0xA1C] | r[0xA1D] << 8, sum.zelda_cleared + sum.metroid_cleared);
+            fclose(st);
+        }
+    }
+    // debug aid: sdmc:/SMZ3/debug_dump.txt asks for one dump of the whole WRAM to ram.bin (then the flag is removed)
+    if (FILE *dd = fopen(SMZ_DIR "/debug_dump.txt", "r")) {
+        fclose(dd);
+        if (FILE *rb = fopen(SMZ_DIR "/ram.bin", "wb")) { fwrite(Memory.RAM, 1, 0x20000, rb); fclose(rb); }
+        if (FILE *rg = fopen(SMZ_DIR "/regs.txt", "w")) {   // CPU registers, to see where a hung game is stuck
+            fprintf(rg, "PB %02X PC %04X DB %02X P %04X A %04X X %04X Y %04X S %04X D %04X\n", Registers.PB, Registers.PC, Registers.DB,
+                    Registers.P.W, Registers.A.W, Registers.X.W, Registers.Y.W, Registers.S.W, Registers.D.W);
+            fclose(rg);
+        }
+        if (FILE *sr = fopen(SMZ_DIR "/sram.bin", "wb")) { fwrite(Memory.SRAM, 1, 0x8000, sr); fclose(sr); }
+        remove(SMZ_DIR "/debug_dump.txt");
+    }
+}
+
+void smz3StateLoaded(void) { trk.state_loaded = 3; }
+
+unsigned smz3TrackerKeys(unsigned keysDown, bool *openMenu)
+{
+    *openMenu = false;
+    if (!smz3IsRun()) return 0;
+    if (cardState != 1) {
+        scLoad();
+        unsigned took = 0;
+        for (int i = 0; i < SC_KEYS; i++) {
+            if (!scKeys[i] || !(keysDown & scKeys[i])) continue;
+            int id = i < SC_SLOTS ? scSlots[i] : SC_ZELDA_COUNT + i - SC_SLOTS;
+            if (id >= 0) scUse(id);
+            took |= scKeys[i];
+        }
+        if (took) dirty = true;
+        return took;
+    }
+    if (!(keysDown & (KEY_A | KEY_B))) return 0;
+    if (cardSkip()) return KEY_A | KEY_B;
+    if (keysDown & KEY_A) { wantRunList = *openMenu = true; }
+    cardState = 2;
+    dirty = true;
+    return KEY_A | KEY_B;
+}
+
+bool smz3TakeRunListRequest(void)
+{
+    bool want = wantRunList;
+    wantRunList = false;
+    return want;
+}
+
+void smz3TrackerFrame(bool tick)
+{
+    static int sinceDraw = 0;
+    if (strncmp(Memory.ROMFilename, RUN_DIR "/", sizeof RUN_DIR) != 0 || !Memory.RAM || !Memory.SRAM) return;
+    sinceDraw++;
+    static u64 lastFrameMs;
+    u64 now = osGetTime();
+    if (settings3DS.TurboMode && now - lastFrameMs < 3000) { turboWallMs += now - lastFrameMs; turboEmuMs += 1000 / 60.0988; }
+    lastFrameMs = now;
+    if (tick || curSlot != gPlaySlot) { trackerUpdate(); debugTouches(); dirty = true; }
+    if (cardState) { cardSounds(); if (cardT() < T_BUTTONS + 0.4f && sinceDraw >= 2) dirty = true; }   // the details move at 30 fps
+    if (dirty && (tick || sinceDraw >= 3 || cardState)) { trackerDraw(); sinceDraw = 0; }   // a drag redraws at most every third frame
+}
+
+// ---- helps of the run being played (the pause menu asks for them)
+
+bool smz3IsRun(void) { return strncmp(Memory.ROMFilename, RUN_DIR "/", sizeof RUN_DIR) == 0; }
+
+// Runs that allow save states keep an auto state, saved on leaving and offered on Continue (the load choice).
+bool smz3AutoStates(void) { return smz3IsRun() && gRunStates && !smz3NoStates(); }
+
+// The run chosen in the menu is loaded: its flags take over. True when it starts from its auto state.
+bool smz3RunStarted(void)
+{
+    curSlot = -2;   // the tracker starts over, also when the same run is chosen again
+    gRunStates = gNextStates;
+    return gNextLoadState && smz3AutoStates();
+}
+
+// Monthly and weekly runs allow no save states of any kind.
+bool smz3NoFastForward(void) { return smz3IsRun() && gChallenge; }
+bool smz3NoStates(void) { return smz3IsRun() && (gChallenge || (gPlaySlot >= 0 && smzOnlineSlotKind(gPlaySlot) >= 1)); }
+
+// Gives the next hint (a help is spent in the limited mode). The text is for a dialog.
+void smz3AskHelp(char *out, size_t cap)
+{
+    char path[320];
+    snprintf(path, sizeof path, "%.300s.help", Memory.ROMFilename);
+    FILE *f = fopen(path, "rb");
+    if (!f) { snprintf(out, cap, "This run has no helps."); return; }
+    int mode = 2, count = 0, used = 0, given = 0;
+    static char hints[SMZ_HOST_HELP_COUNT][SMZ_HOST_HELP_TEXT];
+    if (fscanf(f, "%d %d %d %d\n", &mode, &count, &used, &given) != 4) mode = 2;
+    for (int i = 0; i < SMZ_HOST_HELP_COUNT; i++) {
+        hints[i][0] = 0;
+        if (!fgets(hints[i], SMZ_HOST_HELP_TEXT, f)) break;
+        hints[i][strcspn(hints[i], "\r\n")] = 0;
+    }
+    fclose(f);
+    if (mode == 2) { snprintf(out, cap, "This run has no helps."); return; }
+    if (mode == 1 && used >= count) { snprintf(out, cap, "No helps left (0 of %d).", count); return; }
+    if (given >= SMZ_HOST_HELP_COUNT || !hints[given][0]) { snprintf(out, cap, "No more hints."); return; }
+    int index = given;
+    given++;
+    if (mode == 1) used++;
+    f = fopen(path, "wb");
+    if (f) {
+        fprintf(f, "%d %d %d %d\n", mode, count, used, given);
+        for (int i = 0; i < SMZ_HOST_HELP_COUNT; i++) fprintf(f, "%s\n", hints[i]);
+        fclose(f);
+    }
+    if (mode == 1) snprintf(out, cap, "%s (helps left: %d of %d)", hints[index], count - used, count);
+    else snprintf(out, cap, "%s", hints[index]);
+}
