+static int tab = TAB_RUN;
+static int scrollY[TAB_COUNT];
+static int contentH[TAB_COUNT];
+static TrkMapView bigMap = {811, 479, 0.19f, false}, miniMap = {811, 479, 0.45f, true};
+static bool dirty = true;
