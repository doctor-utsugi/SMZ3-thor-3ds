+struct GenJob {
+    const SmzUi *ui;
+    int32_t seedIfRandom;
+    unsigned char *sm, *z3, *link, *samus, *rom;
+    size_t linkLen, samusLen;
+    char json[4096], seedText[16];
+    char hints[SMZ_HOST_HELP_COUNT * SMZ_HOST_HELP_TEXT];
+    int rc;
+};
+
+static void genThread(void *arg)
+{
+    GenJob *j = (GenJob *)arg;
+    j->rc = smz_host_generate(j->ui, j->seedIfRandom, j->sm, j->z3, j->link, j->linkLen, j->samus, j->samusLen, loadIps, NULL,
+                              j->rom, j->json, sizeof j->json, j->seedText, sizeof j->seedText, j->hints);
+}
+
+// dailyCheck: the run is the attempt of a daily challenge ending at this goal (smz3_goal.h), off the ladders
+static bool generateRun(SmzUi *u, int slot, char *message, size_t cap, const char *dailyCheck = NULL, const char *dailySettings = NULL)
+{
+    GenJob job;
+    memset(&job, 0, sizeof job);
+    if (!findBaseRoms(&job.sm, &job.z3)) {
+        snprintf(message, cap, "%s", wrongRom[0] ? wrongRom : "Put both ROMs (or a zip) in " SMZ_DIR "/base");
+        free(job.sm); free(job.z3);
+        return false;
+    }
+    job.ui = u;
+    job.seedIfRandom = (int32_t)((osGetTime() ^ (u64)svcGetSystemTick() * 2654435761ull) & 0x7FFFFFFF);
+    char link[32], samus[32], path[128];
+    smz_host_sprites(u, link, samus);
+    if (link[0]) { snprintf(path, sizeof path, SPRITE_DIR "/link/%s.rdc", link); job.link = readFile(path, &job.linkLen); }
+    if (samus[0]) { snprintf(path, sizeof path, SPRITE_DIR "/samus/%s.rdc", samus); job.samus = readFile(path, &job.samusLen); }
+    // a plando file replaces the generated seed and the settings it carries
+    char plando[32], perr[160] = "";
+    smz_host_plando_name(u, plando);
+    if (plando[0]) {
+        size_t plen = 0;
+        snprintf(path, sizeof path, SMZ_DIR "/plando/%s", plando);
+        unsigned char *yaml = readFile(path, &plen);
+        if (!yaml || smz_host_set_plando((const char *)yaml, plen, perr, sizeof perr)) {
+            snprintf(message, cap, "Plando: %.40s", yaml ? perr : "cannot read the file");
+            free(yaml); free(job.sm); free(job.z3); free(job.link); free(job.samus);
+            return false;
+        }
+        free(yaml);
+    } else smz_host_set_plando(NULL, 0, perr, sizeof perr);
+    job.rom = (unsigned char *)malloc(SMZ_HOST_ROM_SIZE);
+    bool ok = false;
+    if (job.rom) {
+        Thread t = threadCreate(genThread, &job, 512 * 1024, 0x30, -2, false);
+        if (t) { threadJoin(t, U64_MAX); threadFree(t); }
+        else genThread(&job);
+        if (job.rc == 0) {
+            char name[96];
+            smz_run_rom_name(job.json, job.seedText, name, sizeof name);
+            mkdir(SMZ_DIR, 0777); mkdir(RUN_DIR, 0777); mkdir(SMZ_DIR "/saves", 0777); mkdir(SMZ_DIR "/savestates", 0777);
+            SmzRun r;
+            memset(&r, 0, sizeof r);
+            snprintf(r.name, sizeof r.name, "%s", ui_run_label(u)[0] ? ui_run_label(u) : "Run");
+            snprintf(r.seed, sizeof r.seed, "%s", job.seedText);
+            snprintf(r.rom_path, sizeof r.rom_path, RUN_DIR "/%s", name);
+            snprintf(r.settings, sizeof r.settings, "%s", job.json);
+            if (dailyCheck && smz_daily_mark_settings(r.settings, sizeof r.settings, dailyCheck, dailySettings)) {
+                snprintf(message, cap, "The challenge's settings do not fit");
+                free(job.rom); free(job.link); free(job.samus); free(job.sm); free(job.z3);
+                return false;
+            }
+            r.created = (int64_t)time(NULL) * 1000;
+            r.zelda_total = 216; r.metroid_total = 100;
+            FILE *f = fopen(r.rom_path, "wb");
+            if (f) { ok = fwrite(job.rom, 1, SMZ_HOST_ROM_SIZE, f) == SMZ_HOST_ROM_SIZE; fclose(f); }
+            if (ok) {
+                // the helps of the run: "mode count used given" and then the hints that may be asked for
+                int mode = u->value[UIO_HELP], count = u->value[UIO_HELPS];
+                char helpPath[300];
+                snprintf(helpPath, sizeof helpPath, "%.250s.help", r.rom_path);
+                FILE *h = fopen(helpPath, "wb");
+                if (h) {
+                    fprintf(h, "%d %d 0 0\n", mode, count);
+                    for (int i = 0; i < SMZ_HOST_HELP_COUNT; i++) fprintf(h, "%s\n", mode == 2 ? "" : job.hints + i * SMZ_HOST_HELP_TEXT);
+                    fclose(h);
+                }
+                snprintf(path, sizeof path, RUN_DIR "/slot%d.run", slot);
+                ok = smz_run_save(path, &r) == 0;
+                if (ok) smzOnlineMarkRun(slot, dailyCheck ? 0 : ui_online_now(u), ui_run_weekly(u) ? 3 : ui_run_monthly(u) ? 2 : 1);
+            }
+            if (!ok) snprintf(message, cap, "Cannot write to " RUN_DIR);
+        } else {
+            snprintf(message, cap, "Generation failed (%d)", job.rc);
+        }
+    }
+    free(job.rom); free(job.link); free(job.samus); free(job.sm); free(job.z3);
+    return ok;
+}
+
+// Runs made before the item shortcuts get the ROM hooks that redraw the beam and the Y item (written once, into the file).
+static void addShortcutHooks(const char *romPath)
+{
+    size_t len = 0;
+    unsigned char *rom = readFile(romPath, &len);
+    if (rom && len == SMZ_HOST_ROM_SIZE && smz_rom_shortcut_hooks(rom) == 0) {
+        smz_rom_checksum(rom);
+        if (FILE *f = fopen(romPath, "r+b")) { fwrite(rom, 1, len, f); fclose(f); }
+    }
+    free(rom);
+}
+
+static void deleteRun(int slot)
+{
+    char path[96];
+    snprintf(path, sizeof path, RUN_DIR "/slot%d.run", slot);
+    SmzRun r;
+    if (smz_run_load(path, &r) == 0 && r.rom_path[0]) remove(r.rom_path);
+    remove(path);
+}
+
+// true when the daily slot holds the attempt of this window
+static bool dailyKept(const char *window)
+{
+    SmzDailyRun r;
+    char path[96];
+    struct stat st;
+    snprintf(path, sizeof path, RUN_DIR "/slot%d.run", SMZ_DAILY_SLOT);
+    return window[0] && smzDailyLoad(&r) && !strcmp(r.window, window) && stat(path, &st) == 0;
+}
+
+// Start or Continue on the Daily screen: makes the run of the open window in the daily slot unless it is there already.
+static bool dailyBegin(SmzUi *u, char *message, size_t cap)
+{
+    if (dailyKept(u->daily.window)) return true;
+    ui_busy(u, "Starting the challenge ...");
+    drawUi(u);
+    static SmzDailyRun r;
+    static char settings[8192];
+    static SmzUi gu;
+    bool ok = false;
+    if (smzDailyStart(u->daily.window, &r, settings, sizeof settings, message, cap) == 0) {
+        gu = *u;
+        ui_preset(&gu, 1);
+        ui_apply_run_settings(&gu, settings);
+        gu.value[UIO_LINK] = u->value[UIO_LINK]; gu.value[UIO_SAMUS] = u->value[UIO_SAMUS];   // the player's sprites stay
+        gu.value[UIO_PLANDO] = 0;
+        snprintf(gu.start_label, sizeof gu.start_label, "Daily %s", r.window);
+        deleteRun(SMZ_DAILY_SLOT);
+        smzDailyForget();
+        ok = generateRun(&gu, SMZ_DAILY_SLOT, message, cap, r.check, settings);
+        if (ok) smzDailySave(&r);
+    }
+    ui_idle(u);
+    return ok;
+}
