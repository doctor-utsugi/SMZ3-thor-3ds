+static void drawRun(int y0, int y1)
+{
+    char s[96];
+    unsigned done = trk.zelda_cleared + trk.metroid_cleared, total = trk.zelda_total + trk.metroid_total;
+    int x = 6, cw = 150, y = y0 + 3;
+    snprintf(s, sizeof s, "%u%%", total ? done * 100 / total : 0);
+    int pw = bigText(x, y, 30, theme.accent, s);
+    const char *game = !trk.started ? "Waiting for a file" : trk.game == SMZ3_GAME_ZELDA ? "A Link to the Past" : trk.game == SMZ3_GAME_METROID ? "Super Metroid" : trk.game == 3 ? "Credits" : "Unknown";
+    textFit(x + pw + 6, y, cw - pw - 6, theme.accent, game);
+    fmtClock(shownClockMs(), s, sizeof s);
+    text(x + pw + 6, y + 15, theme.text, s);
+    y += 36;
+    textf(x, y, theme.text, "Zelda  %u / %u", trk.zelda_cleared, trk.zelda_total);
+    bar(x, y + 14, cw, 3, trk.zelda_cleared, trk.zelda_total, theme);
+    y += 20;
+    textf(x, y, theme.text, "Metroid  %u / %u", trk.metroid_cleared, trk.metroid_total);
+    bar(x, y + 14, cw, 3, trk.metroid_cleared, trk.metroid_total, theme);
+    y += 21;
+    int owned = 0;
+    for (unsigned i = 0; i < smz3_inventory_count && i < SMZ_TRK_MAX_INV; i++) owned += trk.started && trk.inventory[i] > 0;
+    long long sec = runMs() / 1000;
+    char pace[16] = "-";
+    if (sec >= 300) snprintf(pace, sizeof pace, "%.1f", done * 3600.0f / sec);
+    textf(x, y, theme.text, "Items %d / %u   %s/h", owned, smz3_inventory_count, pace);
+    y += 15;
+    drawRewards(x, y, 15);
+    y += 20;
+    if (trk.n_recent_items > 0 && y + 28 < y1) {
+        text(x, y, theme.dim, "RECENT ITEMS");
+        y += 14;
+        for (int i = 0; i < trk.n_recent_items && y + 14 <= y1; i++, y += 15) {
+            const smz3_inv_item &it = smz3_inventory_items[trk.recent_items[i]];
+            drawIcon(getIcon(it.icon), x, y, 14, 14, 256);
+            textFit(x + 17, y, cw - 17, theme.text, it.name);
+        }
+    }
+    // regions nearest to being finished: a goal the game screen does not show
+    if (y + 42 < y1) {
+        buildRegions();
+        int best[2] = {-1, -1}, left[2] = {1 << 30, 1 << 30};
+        for (int r = 0; r < nRegions; r++) {
+            int d = regionDone(regions[r]), l = regions[r].count - d;
+            if (d < 1 || l < 1) continue;
+            if (l < left[0]) { best[1] = best[0]; left[1] = left[0]; best[0] = r; left[0] = l; }
+            else if (l < left[1]) { best[1] = r; left[1] = l; }
+        }
+        if (best[0] >= 0) {
+            y += 3;
+            text(x, y, theme.dim, "NEARLY DONE");
+            y += 14;
+            for (int k = 0; k < 2 && best[k] >= 0; k++, y += 14) {
+                snprintf(s, sizeof s, "%s: %d left", regions[best[k]].name, left[k]);
+                textFit(x, y, cw, theme.dim, s);
+            }
+        }
+    }
+    runMiniTop = y0 + 4; runMiniBottom = y1 - 4;
+    int ids[SC_COUNT], mapTop = runMiniTop;
+    for (int row = 0; row < 2; row++) {
+        scRowY[row] = scCells(ids, row) > 0 ? mapTop : -1;
+        if (scRowY[row] >= 0) { drawShortcutRow(mapTop, row); mapTop += SC_ROW_H + 4; }
+    }
+    static const DungeonView here = {false, false, 0, 0};
+    if (haveLive) drawDungeon(here, 162, mapTop, 154, runMiniBottom - mapTop, true);   // inside a dungeon: its floor, as on the Thor
+    else drawMap(miniMap, 162, mapTop, 154, runMiniBottom - mapTop, true);
+    if (trk.game != SMZ3_GAME_ZELDA) scPick = -1;
+    if (scPick >= 0) drawPicker(y0, y1);
+}
