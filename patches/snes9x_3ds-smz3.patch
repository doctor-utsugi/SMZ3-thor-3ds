+struct TrkHelp { int mode, count, used, given; char hints[SMZ_HOST_HELP_COUNT][SMZ_HOST_HELP_TEXT]; };
+static TrkHelp help;   // the run's <rom>.help file: mode 0 all, 1 limited, 2 none
+static char helpNote[SMZ_HOST_HELP_TEXT + 32];
+
+static void readHelp()
+{
+    char path[320];
+    snprintf(path, sizeof path, "%.300s.help", Memory.ROMFilename);
+    memset(&help, 0, sizeof help);
+    help.mode = 2;
+    FILE *f = fopen(path, "rb");
+    if (!f) return;
+    if (fscanf(f, "%d %d %d %d\n", &help.mode, &help.count, &help.used, &help.given) != 4) help.mode = 2;
+    for (int i = 0; i < SMZ_HOST_HELP_COUNT; i++) {
+        if (!fgets(help.hints[i], SMZ_HOST_HELP_TEXT, f)) break;
+        help.hints[i][strcspn(help.hints[i], "\r\n")] = 0;
+    }
+    fclose(f);
+}
