+static void drawDaily(int y0, int y1)
+{
+    int64_t now = smzDailyNowMs(), left = dr.closes_at - now;
+    bool finished = trk.game == 3;
+    int y = y0 + 6 - scrollY[TAB_DAILY];
+    char a[32], b[32], s[200];
+    y = textWrap(8, y, 304, theme.accent, dr.goal) + 4;
+    if (finished) {
+        fmtClock(dailyDoneMs > 1 ? dailyDoneMs : runMs(), a, sizeof a);
+        snprintf(s, sizeof s, "CHALLENGE COMPLETE  %s", a);
+        text(8, y, 0x4CC38A, s);
+        y += 16;
+        char res[160];
+        y = textWrap(8, y, 304, theme.text, smzDailyResult(res, sizeof res) ? res : "Sending the time ...") + 6;
+    } else {
+        smz_daily_span(left, a, sizeof a);
+        fmtClock(now - smz_daily_clock_from(&dr), b, sizeof b);
+        if (left > 0) snprintf(s, sizeof s, "Window closes in %s    Own time %s", a, b);
+        else snprintf(s, sizeof s, "The window has closed: no prize    Own time %s", b);
+        y = textWrap(8, y, 304, left < 15 * 60000 ? 0xE05A4F : theme.dim, s) + 8;
+    }
+    text(8, y, theme.dim, "HINTS");
+    y += 16;
+    if (!dr.n_hints) { text(8, y, theme.dim, "None yet"); y += 14; }
+    for (int i = 0; i < dr.n_hints; i++) {
+        snprintf(s, sizeof s, "%lld min   %s", (long long)((dr.hint_at[i] - dr.started_at) / 60000), dr.hint[i]);
+        y = textWrap(8, y, 304, i == dr.n_hints - 1 && now < newHintUntil ? theme.accent : theme.text, s) + 6;
+    }
+    if (!finished) {
+        if (dr.next_hint_at > 0) { smz_daily_span(dr.next_hint_at - now, a, sizeof a); snprintf(s, sizeof s, "Next hint in %s", a); }
+        else snprintf(s, sizeof s, "Every hint is out");
+        text(8, y + 4, theme.dim, s);
+        y += 18;
+    }
+    contentH[TAB_DAILY] = y + scrollY[TAB_DAILY] - y0;
+    (void)y1;
+}
