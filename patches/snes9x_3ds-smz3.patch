+// The game's end, kept until the run is left even if the reading flickers: 0 not reached, 1 the run-complete card is up,
+// 2 ended without it (closed for the credits, or a finished run played again). Once ended, this screen shows the details.
+static int cardState = 0;
+static bool wantRunList = false;
