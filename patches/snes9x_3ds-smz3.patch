+static void refreshSlots(SmzUi *u)
+{
+    for (int i = 0; i < UI_SLOTS; i++) {
+        char path[96], sum[64];
+        snprintf(path, sizeof path, RUN_DIR "/slot%d.run", i);
+        SmzRun r;
+        if (smz_run_load(path, &r) == 0) { smz_run_summary(&r, sum, sizeof sum); ui_set_slot(u, i, 1, r.name, sum); ui_set_slot_stats(u, i, r.zelda_cleared, r.zelda_total, r.metroid_cleared, r.metroid_total, r.play_ms, r.game, r.boss_mask, r.crystal_mask); ui_set_slot_online(u, i, smzOnlineSlotKind(i)); }
+        else ui_set_slot(u, i, 0, "", "");
+    }
+}
