+struct Region { int game; const char *name; int first, count; bool open; };
+static Region regions[64];
+static int nRegions;
+static short regionLocs[SMZ_TRK_MAX_LOCS];
+
+static void buildRegions()
+{
+    if (nRegions) return;
+    int n = 0;
+    for (int g = SMZ3_GAME_ZELDA; g <= SMZ3_GAME_METROID; g++)
+        for (unsigned i = 0; i < smz3_location_count && i < SMZ_TRK_MAX_LOCS; i++) {
+            const smz3_location &l = smz3_locations[i];
+            if ((int)l.game != g) continue;
+            bool seen = false;
+            for (int r = 0; r < nRegions; r++) if (regions[r].game == g && !strcmp(regions[r].name, l.region)) seen = true;
+            if (seen || nRegions >= 64) continue;
+            Region &r = regions[nRegions++];
+            r.game = g; r.name = l.region; r.first = n; r.count = 0; r.open = false;
+            for (unsigned j = i; j < smz3_location_count && j < SMZ_TRK_MAX_LOCS; j++)
+                if ((int)smz3_locations[j].game == g && !strcmp(smz3_locations[j].region, l.region)) { regionLocs[n++] = (short)j; r.count++; }
+        }
+}
