+// ---- the game's own dungeon maps (pc_dungeon.c): read from the user's ALttP ROM once, kept as RGB565 (0 = empty) in DUNGEON_FILE
+
+#define DUNGEON_FILE SMZ_DIR "/derived/dungeons.bin"
+#define DM_PIXELS (SMZ_DM_ATLAS_W * SMZ_DM_ATLAS_H)
+
+static SmzDungeonMeta dmeta;
+static u16 *dmFull, *dmHint;
+static int dmState;   // 0 not tried, 1 ready, -1 missing
+static bool fixedKeys;   // the run marks the keys under pots and on enemies (ShowFixedKeys)
+
+struct DungeonLive { int d, idx, cell, lx, ly; };   // dungeon, floor index, room cell on the 5 x 5 grid (-1 unknown), spot in the room (0..15)
+struct DungeonView { bool world, picked; int d, idx; };
+static DungeonView dv = {false, false, 2, 0};
+static DungeonLive dlive;
+static bool haveLive;
+
+static const int BOSS_ROOM[14] = {15, 15, 200, 51, 32, 6, 90, 144, 41, 222, 7, 172, 164, 13};
+static const int BOSS_FLOOR[14] = {-1, -1, 1, 1, 6, -1, -1, -1, -2, -7, 5, -1, -3, 6};
+static const int BOSS_SPOT[14] = {-1, -1, 0x808, 8, 0, 8, 0x808, 8, 0x808, 0x800, 0x404, 0x808, 8, 8};
+static const char *const DUNGEON_NAMES[14] = {"Sewers", "Hyrule Castle", "Eastern Palace", "Desert Palace", "Castle Tower", "Swamp Palace", "Palace of Darkness",
+                                              "Misery Mire", "Skull Woods", "Ice Palace", "Tower of Hera", "Thieves' Town", "Turtle Rock", "Ganon's Tower"};
+
+// Reads the pictures out of the ALttP ROM the first time a run is played; quick afterwards.
+static void makeDungeonMaps(SmzUi *u)
+{
+    struct stat st;
+    if (stat(DUNGEON_FILE, &st) == 0) return;
+    static bool tried;
+    if (tried) return;
+    tried = true;
+    ui_busy(u, "Reading the dungeon maps ...");
+    drawUi(u);
+    unsigned char *sm, *z3;
+    bool ok = findBaseRoms(&sm, &z3);
+    free(sm);
+    u8 *rgba = ok ? (u8 *)malloc((size_t)DM_PIXELS * 8) : NULL;
+    u16 *out = rgba ? (u16 *)malloc((size_t)DM_PIXELS * 4) : NULL;
+    if (out && smz_dungeon_maps(z3, 0x100000, &dmeta, rgba, rgba + (size_t)DM_PIXELS * 4)) {
+        for (size_t k = 0; k < (size_t)DM_PIXELS * 2; k++) {
+            const u8 *px = rgba + k * 4;
+            u16 c = (u16)(((px[0] >> 3) << 11) | ((px[1] >> 2) << 5) | (px[2] >> 3));
+            out[k] = px[3] < 128 ? 0 : c ? c : 1;
+        }
+        mkdir(SMZ_DIR "/derived", 0777);
+        FILE *f = fopen(DUNGEON_FILE, "wb");
+        if (f) { fwrite(&dmeta, sizeof dmeta, 1, f); fwrite(out, 2, (size_t)DM_PIXELS * 2, f); fclose(f); }
+    }
+    free(out); free(rgba); free(z3);
+    ui_idle(u);
+}
+
+static bool dungeonAvailable()
+{
+    if (dmState) return dmState > 0;
+    dmState = -1;
+    FILE *f = fopen(DUNGEON_FILE, "rb");
+    if (!f) return false;
+    dmFull = (u16 *)malloc((size_t)DM_PIXELS * 4);
+    if (dmFull && fread(&dmeta, sizeof dmeta, 1, f) == 1 && fread(dmFull, 2, (size_t)DM_PIXELS * 2, f) == (size_t)DM_PIXELS * 2) { dmHint = dmFull + DM_PIXELS; dmState = 1; }
+    else { free(dmFull); dmFull = NULL; }
+    fclose(f);
+    return dmState > 0;
+}
+
+static int floorsOf(int d) { return dmeta.below[d] + dmeta.above[d]; }
+static int rd16(const u8 *w, int a) { return w[a] | w[a + 1] << 8; }
+
+static bool dungeonPlace(const u8 *w, DungeonLive *out)
+{
+    int d = w[0x040C] / 2;
+    if (w[0x1B] == 0 || w[0x040C] >= 28 || d >= 14) return false;
+    int fl = floorsOf(d), idx = (int8_t)w[0xA4] + dmeta.below[d];
+    if (fl < 1) return false;
+    idx = idx < 0 ? 0 : idx > fl - 1 ? fl - 1 : idx;
+    int room = rd16(w, 0xA0);
+    if (room == 137) room = 169; else if (room == 167) room = 119; else if (room == 79) room = 190;
+    int here = -1;
+    for (int c = 0; c < 25; c++) if (dmeta.grid[d][idx][c] == room) { here = c; break; }
+    *out = {d, idx, here, here < 0 ? 0 : (rd16(w, 0x22) & 0x1E0) >> 5, here < 0 ? 0 : (rd16(w, 0x20) & 0x1E0) >> 5};
+    return true;
+}
+
+// Link's place while ALttP runs; in the middle of a room change the room and the coordinates disagree, so the last settled place stays.
+static void dungeonReadLive()
+{
+    static DungeonLive stable;
+    static bool have;
+    haveLive = false;
+    if (!dungeonAvailable() || trk.game != SMZ3_GAME_ZELDA) { have = false; return; }
+    DungeonLive now;
+    bool ok = dungeonPlace(Memory.RAM, &now);
+    bool moving = Memory.RAM[0x10] == 0x07 && Memory.RAM[0x11] != 0;
+    if (moving && ok && have && stable.d == now.d) { dlive = stable; haveLive = true; return; }
+    have = ok;
+    if (ok) stable = now;
+    dlive = now;
+    haveLive = ok;
+}
+
+static bool dungeonShowing(const DungeonView &v) { return dmState > 0 && !v.world && (v.picked || haveLive); }
+
+static void dungeonShown(const DungeonView &v, int *d, int *idx)
+{
+    if (v.picked || !haveLive) { *d = v.d; *idx = v.idx; }
+    else { *d = dlive.d; *idx = dlive.idx; }
+}
+
+static void dungeonPick(DungeonView &v, int d, int idx)
+{
+    v.picked = true; v.world = false;
+    v.d = (d + 14) % 14;
+    int fl = floorsOf(v.d);
+    v.idx = idx < 0 ? 0 : idx > fl - 1 ? fl - 1 : idx;
+}
+
+static void dungeonStep(DungeonView &v, int delta)
+{
+    int d, idx;
+    dungeonShown(v, &d, &idx);
+    int nd = (d + delta + 14) % 14;
+    dungeonPick(v, nd, dmeta.below[nd]);
+}
+
+// Draws the pixels of one 8 x 8 quarter of a room from an atlas, scaled to (x0, y0)-(x1, y1); faint: blended at 100/255.
+static void blitQuarter(const u16 *atlas, int sx, int sy, float x0, float y0, float x1, float y1, bool faint)
+{
+    int ix0 = (int)x0, iy0 = (int)y0, ix1 = (int)x1, iy1 = (int)y1;
+    float k = 8 / (x1 - x0);
+    for (int x = ix0 < clipX0 ? clipX0 : ix0; x < ix1 && x < clipX1; x++) {
+        int u = sx + (int)((x - x0 + 0.5f) * k);
+        u16 *p = trkFb + x * 240 + 239 - iy0;
+        for (int y = iy0; y < iy1; y++, p--) {
+            if (y < clipY0 || y >= clipY1) continue;
+            u16 c = atlas[(sy + (int)((y - y0 + 0.5f) * k)) * SMZ_DM_ATLAS_W + u];
+            if (c) *p = faint ? blend565(*p, c, 100) : c;
+        }
+    }
+}
+
+// A key standing up, its bow at the top: gold, a big key larger and paler.
+static void keyMark(float x, float y, float s, bool big)
+{
+    int gold = big ? 0xFFE08A : 0xF2C14E, ink = 0x1A1408;
+    if (big) s *= 1.25f;
+    auto box = [](float l, float t, float w, float h, int c) { fill((int)lroundf(l), (int)lroundf(t), (int)lroundf(l + w), (int)lroundf(t + h), c); };
+    dot(x, y - s * 0.55f, s * 0.62f, ink);
+    box(x - s * 0.3f, y - s * 0.3f, s * 0.6f, s * 1.5f, ink);
+    dot(x, y - s * 0.55f, s * 0.45f, gold);
+    dot(x, y - s * 0.55f, s * 0.18f, ink);
+    box(x - s * 0.13f, y - s * 0.15f, s * 0.26f, s * 1.2f, gold);
+    box(x + s * 0.13f, y + s * 0.6f, s * 0.32f, s * 0.2f, gold);
+    box(x + s * 0.13f, y + s * 0.85f, s * 0.24f, s * 0.18f, gold);
+}
+
+static void checkDot(float x, float y, float r)
+{
+    dot(x, y, r + 1, 0xFFFFFF);
+    dot(x, y, r, 0x000000);
+    dot(x, y, r - 0.6f, 0xFFB300);
+}
+
+static int dungeonLeft(int d)   // checks still to get in a dungeon (the sewers belong to Hyrule Castle)
+{
+    const char *region = d == 0 ? "Hyrule Castle" : DUNGEON_NAMES[d];
+    int left = 0;
+    for (unsigned j = 0; j < smz3_location_count && j < SMZ_TRK_MAX_LOCS; j++)
+        if (!strcmp(smz3_locations[j].region, region) && !trk.cleared[j]) left++;
+    return left;
+}
+
+#define FLOOR_W 30
+#define FLOOR_H 18
+
+/* The floor picture with the unopened checks, the fixed keys, the boss and Link. mini: just the picture (the RUN tab). */
+static void drawDungeon(const DungeonView &v, int ax, int ay, int aw, int ah, bool mini)
+{
+    int d, idx;
+    dungeonShown(v, &d, &idx);
+    int sx0 = clipX0, sy0 = clipY0, sx1 = clipX1, sy1 = clipY1;
+    setClip(ax, ay, ax + aw, ay + ah);
+    fill(ax, ay, ax + aw, ay + ah, 0x0B0E12);
+    int fl = floorsOf(d), below = dmeta.below[d];
+    int x0 = 5, y0 = 5, x1 = -1, y1 = -1;   // the cells any floor of the dungeon uses, so floors line up
+    for (int f = 0; f < fl; f++)
+        for (int k = 0; k < 25; k++)
+            if (dmeta.grid[d][f][k] != 0xF) { int cx = k % 5, cy = k / 5; x0 = cx < x0 ? cx : x0; x1 = cx > x1 ? cx : x1; y0 = cy < y0 ? cy : y0; y1 = cy > y1 ? cy : y1; }
+    if (x1 < 0) { x0 = y0 = 0; x1 = y1 = 4; }
+    int cols = x1 - x0 + 1, rows = y1 - y0 + 1;
+
+    // what the game remembers: room quadrants visited, the dungeon's map and compass
+    bool zelda = trk.game == SMZ3_GAME_ZELDA;
+    const u8 *src = zelda ? Memory.RAM : Memory.SRAM;
+    int base = zelda ? 0xF000 : 0;
+    const u8 *flags = src + base;
+    int mapMask = rd16(src, base + 0x368), compassMask = rd16(src, base + 0x364);
+    bool haveMap = mapMask & (0x8000 >> d), showAll = !discoveredOnly;
+
+    int top0 = mini ? ay + 2 : ay + 18, left0 = mini ? ax + 2 : ax + FLOOR_W + 6, right0 = ax + aw - 2, bottom0 = mini ? ay + ah - 2 : ay + ah - 26;
+    float scale = fminf((float)(right0 - left0) / (cols * SMZ_DM_ROOM), (float)(bottom0 - top0) / (rows * SMZ_DM_ROOM));
+    float left = left0 + ((right0 - left0) - cols * SMZ_DM_ROOM * scale) / 2, top = top0 + ((bottom0 - top0) - rows * SMZ_DM_ROOM * scale) / 2;
+
+    for (int c = 0; c < 25; c++) {
+        int room = dmeta.grid[d][idx][c];
+        if (room == 0xF) continue;
+        int seen = flags[room * 2] & 0xF;
+        for (int q = 0; q < 4; q++) {
+            bool visited = seen & (8 >> q);
+            const u16 *atlas = visited || showAll ? dmFull : haveMap ? dmHint : NULL;
+            if (!atlas) continue;
+            int ox = (c % 5) * SMZ_DM_ROOM + (q & 1) * 8, oy = (c / 5) * SMZ_DM_ROOM + (q >> 1) * 8;
+            float dx = left + (ox - x0 * SMZ_DM_ROOM) * scale, dy = top + (oy - y0 * SMZ_DM_ROOM) * scale;
+            blitQuarter(atlas, idx * SMZ_DM_CELL + ox, d * SMZ_DM_CELL + oy, dx, dy, dx + 8 * scale, dy + 8 * scale, !visited && showAll);
+        }
+    }
+
+    // unopened checks: at their chest when the room data places it, else one dot at the room's centre
+    for (int c = 0; c < 25; c++) {
+        int room = dmeta.grid[d][idx][c];
+        if (room == 0xF) continue;
+        float ox = left + (c % 5 - x0) * SMZ_DM_ROOM * scale, oy = top + (c / 5 - y0) * SMZ_DM_ROOM * scale;
+        bool loose = false;
+        for (unsigned i = 0; i < smz3_location_count && i < SMZ_TRK_MAX_LOCS; i++) {
+            const smz3_location &l = smz3_locations[i];
+            if (l.game != SMZ3_GAME_ZELDA || l.zelda_misc || (int)l.addr != room || trk.cleared[i]) continue;
+            int k = (int)l.flag - 4;
+            if (k >= 0 && k < SMZ_DM_CHESTS && k < dmeta.chest_n[room]) checkDot(ox + (dmeta.chest_xy[room][k][0] + 0.5f) / 4 * scale, oy + (dmeta.chest_xy[room][k][1] + 0.5f) / 4 * scale, fmaxf(1.6f, scale * 2));
+            else loose = true;
+        }
+        if (loose) checkDot(ox + 8 * scale, oy + 8 * scale, fmaxf(2, scale * 2.6f));
+    }
+
+    // keys under pots and on enemies, until taken, on runs that ask for them
+    for (int i = 0; fixedKeys && i < smz_fixed_key_count; i++) {
+        const SmzFixedKey &fk = smz_fixed_keys[i];
+        if (smz_fixed_key_taken(i, flags, 0x20000 - base, zelda ? Memory.RAM : NULL, zelda ? 0x20000 : 0)) continue;
+        for (int c = 0; c < 25; c++) {
+            if (dmeta.grid[d][idx][c] != fk.room) continue;
+            float ox = left + (c % 5 - x0) * SMZ_DM_ROOM * scale, oy = top + (c / 5 - y0) * SMZ_DM_ROOM * scale;
+            keyMark(ox + (fk.x + 0.5f) / 4 * scale, oy + (fk.y + 0.5f) / 4 * scale, fmaxf(2.5f, scale * 1.6f), fk.big);
+        }
+    }
+
+    // the boss, once the compass says where (or on all-map runs), until it is beaten
+    int spot = BOSS_SPOT[d];
+    if (spot >= 0 && idx == BOSS_FLOOR[d] + below) {
+        bool known = showAll || (compassMask & (0x8000 >> d)), beaten = flags[BOSS_ROOM[d] * 2 + 1] & 0x08;
+        int c = -1;
+        for (int k = 0; k < 25; k++) if (dmeta.grid[d][idx][k] == BOSS_ROOM[d]) c = k;
+        if (known && !beaten && c >= 0) {
+            float x = left + ((c % 5 - x0) * SMZ_DM_ROOM + (spot >> 8) + 4) * scale, y = top + ((c / 5 - y0) * SMZ_DM_ROOM + (spot & 0xFF) + 4) * scale, r = fmaxf(4, scale * 2.8f);
+            dot(x, y, r + 1, 0xFFFFFF);
+            dot(x, y, r, 0xD32F2F);
+            if (r >= 6) text((int)x - 10, (int)y - 7, 0xFFFFFF, "B", HALIGN_CENTER, (int)x + 10);
+        }
+    }
+
+    // Link, blinking, only on the floor he is on
+    if (haveLive && dlive.d == d && dlive.idx == idx && dlive.cell >= 0 && (osGetTime() / 350) % 2 == 0) {
+        float x = left + ((dlive.cell % 5 - x0) * SMZ_DM_ROOM + dlive.lx + 0.5f) * scale, y = top + ((dlive.cell / 5 - y0) * SMZ_DM_ROOM + dlive.ly + 0.5f) * scale;
+        dot(x, y, fmaxf(2.5f, scale * 1.9f), 0x000000);
+        dot(x, y, fmaxf(1.6f, scale * 1.3f), 0xFFFFFF);
+    }
+
+    if (!mini) {   // the name with what is left, and the floor list (top floor first)
+        char s[64];
+        int n = dungeonLeft(d);
+        if (n) snprintf(s, sizeof s, "%s  %d left", DUNGEON_NAMES[d], n); else snprintf(s, sizeof s, "%s  done", DUNGEON_NAMES[d]);
+        text(ax + 6, ay + 2, n ? theme.text : 0x4CC38A, s);
+        for (int i = fl - 1; i >= 0; i--) {
+            int fn = i - below, y = ay + 18 + (fl - 1 - i) * (FLOOR_H + 2);
+            if (fn >= 0) snprintf(s, sizeof s, "%dF", fn + 1); else snprintf(s, sizeof s, "B%d", -fn);
+            fill(ax + 4, y, ax + 4 + FLOOR_W, y + FLOOR_H, i == idx ? 0x3A4A66 : 0x1D2430);
+            text(ax + 4, y + 2, i == idx ? 0xE9A23B : 0xE8ECF2, s, HALIGN_CENTER, ax + 4 + FLOOR_W);
+        }
+    }
+    setClip(sx0, sy0, sx1, sy1);
+}
