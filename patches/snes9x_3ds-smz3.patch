+// The buttons under the map: the world map's, or the dungeon picture's (dungeon and floor are picked by hand there).
+static const char *const WORLD_BUTTONS[5] = {"DUNGEON", "-", "+", "FOLLOW", "CENTER"};
+static const char *const DUNGEON_BUTTONS[4] = {"<", ">", "HERE", "WORLD"};
+static const int WORLD_W[5] = {64, 24, 24, 58, 58}, DUNGEON_W[4] = {24, 24, 58, 58};
