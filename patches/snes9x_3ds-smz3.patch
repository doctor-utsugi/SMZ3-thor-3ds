+
+struct TrkTheme { int bg, panel, accent, text, dim, bar, tab, pending, done; };
+static const TrkTheme THEME_ZELDA = {0x14231A, 0x1F3A24, 0xE8C14A, 0xF3EBC8, 0xA8A27A, 0x5BBF6A, 0x2B4A30, 0xFFD54A, 0x7BE08A};
+static const TrkTheme THEME_METROID = {0x05080C, 0x0C1A24, 0xFF9A1F, 0xD8F6FF, 0x5E8DA0, 0x19D3C5, 0x13303F, 0xFF9A1F, 0x19D3C5};
+
+enum { TAB_RUN, TAB_ITEMS, TAB_CHECKS, TAB_MAP, TAB_HELP, TAB_DAILY, TAB_COUNT };
+static const char *const TAB_NAMES[TAB_COUNT] = {"RUN", "ITEMS", "CHECKS", "MAP", "HELP", "DAILY"};
+
+#define TAB_H 20
+#define STRIP_H 30
+#define PAUSE_W 24
+
+static u16 *trkFb;
+static int clipX0, clipY0, clipX1 = 320, clipY1 = 240;
+
+static inline u16 to565(int rgb) { return (u16)(((rgb >> 8) & 0xF800) | ((rgb >> 5) & 0x07E0) | ((rgb >> 3) & 0x1F)); }
+
+static void setClip(int x0, int y0, int x1, int y1)
+{
+    clipX0 = x0 < 0 ? 0 : x0; clipY0 = y0 < 0 ? 0 : y0; clipX1 = x1 > 320 ? 320 : x1; clipY1 = y1 > 240 ? 240 : y1;
+    ui3dsSetViewport(clipX0, clipY0, clipX1, clipY1);
+}
+
+static void fill(int x0, int y0, int x1, int y1, int rgb)
+{
+    if (x0 < clipX0) x0 = clipX0;
+    if (y0 < clipY0) y0 = clipY0;
+    if (x1 > clipX1) x1 = clipX1;
+    if (y1 > clipY1) y1 = clipY1;
+    u16 c = to565(rgb);
+    for (int x = x0; x < x1; x++) {
+        u16 *p = trkFb + x * 240 + 239 - y0;
+        for (int y = y0; y < y1; y++) *p-- = c;
+    }
+}
+
+static void fillAlpha(int x0, int y0, int x1, int y1, int rgb, int a)
+{
+    if (x0 < clipX0) x0 = clipX0;
+    if (y0 < clipY0) y0 = clipY0;
+    if (x1 > clipX1) x1 = clipX1;
+    if (y1 > clipY1) y1 = clipY1;
+    u16 c = to565(rgb);
+    for (int x = x0; x < x1; x++) {
+        u16 *p = trkFb + x * 240 + 239 - y0;
+        for (int y = y0; y < y1; y++, p--) *p = blend565(*p, c, a);
+    }
+}
+
+static void dot(float cx, float cy, float r, int rgb)
+{
+    for (int dy = (int)floorf(-r); dy <= (int)ceilf(r); dy++) {
+        float yy = dy + 0.5f;
+        if (yy * yy > r * r) continue;
+        float half = sqrtf(r * r - yy * yy);
+        fill((int)lroundf(cx - half), (int)cy + dy, (int)lroundf(cx + half), (int)cy + dy + 1, rgb);
+    }
+}
+
+static int textW(const char *s) { return ui3dsGetStringWidth(s); }
+
+// align HALIGN_CENTER centres in x..x1, HALIGN_RIGHT ends at x
+static void text(int x, int y, int rgb, const char *s, int align = HALIGN_LEFT, int x1 = 320)
+{
+    if (y + 14 <= clipY0 || y >= clipY1) return;
+    int x0 = x;
+    if (align == HALIGN_RIGHT) { x0 = 0; x1 = x; }
+    ui3dsDrawStringWithNoWrapping(settings3DS.SecondScreen, x0, y, x1, y + 14, rgb, align, s);
+}
+
+static void textf(int x, int y, int rgb, const char *fmt, ...) __attribute__((format(printf, 4, 5)));
+static void textf(int x, int y, int rgb, const char *fmt, ...)
+{
+    char s[160];
+    va_list ap;
+    va_start(ap, fmt);
+    vsnprintf(s, sizeof s, fmt, ap);
+    va_end(ap);
+    text(x, y, rgb, s);
+}
+
+// Text cut with an ellipsis to fit in w pixels.
+static void textFit(int x, int y, int w, int rgb, const char *s)
+{
+    char cut[160];
+    ui3dsEllipsize(s, cut, sizeof cut, w);
+    text(x, y, rgb, cut);
+}
+
+// Word-wrapped text in w pixels from (x, y), at most maxLines lines; returns the y below it. draw = false only measures.
+static int textWrap(int x, int y, int w, int rgb, const char *s, int maxLines = 99, bool draw = true)
+{
+    char line[160];
+    const char *p = s;
+    for (int n = 0; *p && n < maxLines; n++) {
+        while (*p == ' ') p++;
+        int fit = 0, i = 0;
+        while (p[i]) {
+            int j = i;
+            while (p[j] && p[j] != ' ') j++;
+            if (j >= (int)sizeof line) break;
+            memcpy(line, p, j); line[j] = 0;
+            if (fit && textW(line) > w) break;
+            fit = j;
+            i = p[j] ? j + 1 : j;
+        }
+        if (!fit) fit = (int)strnlen(p, sizeof line - 1);
+        snprintf(line, sizeof line, "%.*s", fit, p);
+        if (n == maxLines - 1 && p[fit]) { char c[168]; snprintf(c, sizeof c, "%s ...", line); ui3dsEllipsize(c, line, sizeof line, w); }
+        if (draw) text(x, y, rgb, line);
+        y += 14;
+        p += fit;
+    }
+    return y;
+}
+
+// Text taller than the font (up to 32 px), drawn through the UI's upscaling into an RGBA4 buffer. Returns its width.
+static int bigText(int x, int y, int h, int rgb, const char *s)
+{
+    enum { BW = 200 };
+    static u16 buf[BW * 32];
+    memset(buf, 0, sizeof buf);
+    int w = ui3dsDrawStringToTexture(buf, s, 0, 0, BW, h, (u32)rgb << 8, h);
+    u16 c = to565(rgb);
+    for (int yy = 0; yy < h; yy++) {
+        int sy = y + yy;
+        if (sy < clipY0 || sy >= clipY1) continue;
+        for (int xx = 0; xx < w; xx++) {
+            int a = buf[yy * BW + xx] & 15, sx = x + xx;
+            if (!a || sx < clipX0 || sx >= clipX1) continue;
+            u16 *p = trkFb + sx * 240 + 239 - sy;
+            *p = a == 15 ? c : blend565(*p, c, a * 17);
+        }
+    }
+    return w;
+}
+
+static void bar(int x, int y, int w, int h, int done, int total, const TrkTheme &t)
+{
+    fill(x, y, x + w, y + h, t.panel);
+    if (total > 0 && done > 0) fill(x, y, x + w * (done > total ? total : done) / total, y + h, t.bar);
+}
+
+// ---- icons: romfs:/smz3/icons/<name>.pv (made by tools/gen_3ds_assets.py), loaded once
+
+struct TrkIcon { char name[40]; int w, h; u16 *c; u8 *a; };
+static TrkIcon icons[72];
+
+static const TrkIcon *getIcon(const char *file)
+{
+    char name[40];
+    snprintf(name, sizeof name, "%s", file);
+    char *dot = strrchr(name, '.');
+    if (dot && !strcmp(dot, ".png")) *dot = 0;
+    for (char *q = name; *q; q++) if (*q == ' ') *q = '_';
+    for (auto &i : icons) {
+        if (!i.name[0]) {
+            snprintf(i.name, sizeof i.name, "%s", name);
+            char path[96];
+            snprintf(path, sizeof path, "romfs:/smz3/icons/%s.pv", name);
+            size_t len = 0;
+            unsigned char *d = readFile(path, &len);
+            int w, h;
+            const unsigned char *px;
+            if (d && smz_preview_parse(d, len, &w, &h, &px)) {
+                i.c = (u16 *)malloc(w * h * 2);
+                i.a = (u8 *)malloc(w * h);
+                if (i.c && i.a) {
+                    for (int k = 0; k < w * h; k++) { i.c[k] = to565(px[k * 4] << 16 | px[k * 4 + 1] << 8 | px[k * 4 + 2]); i.a[k] = px[k * 4 + 3]; }
+                    i.w = w; i.h = h;
+                }
+            }
+            free(d);
+            return i.w ? &i : NULL;
+        }
+        if (!strcmp(i.name, name)) return i.w ? &i : NULL;
+    }
+    return NULL;
+}
+
+// The icon fitted in the box, keeping its aspect; alpha 0..256 for the whole picture.
+static void drawIcon(const TrkIcon *ic, int x, int y, int w, int h, int alpha)
+{
+    if (!ic) return;
+    int dw = w, dh = h;
+    if (ic->w * h > ic->h * w) dh = ic->h * w / ic->w; else dw = ic->w * h / ic->h;
+    x += (w - dw) / 2; y += (h - dh) / 2;
+    for (int yy = 0; yy < dh; yy++) {
+        int sy = y + yy;
+        if (sy < clipY0 || sy >= clipY1) continue;
+        int row = yy * ic->h / dh * ic->w;
+        for (int xx = 0; xx < dw; xx++) {
+            int sx = x + xx;
+            if (sx < clipX0 || sx >= clipX1) continue;
+            int k = row + xx * ic->w / dw, a = ic->a[k] * alpha >> 8;
+            if (a < 16) continue;
+            u16 *p = trkFb + sx * 240 + 239 - sy;
+            *p = a >= 250 ? ic->c[k] : blend565(*p, ic->c[k], a + 1);
+        }
+    }
+}
+
+// ---- the combined map: three sizes in romfs (1/2, 1/4 and 1/8 pixel per marker unit), sampled by the nearest pixel
+
+struct MapLevel { int w, h; u16 *px; };
+static MapLevel mapLevels[3];
+struct TrkMapView { float cx, cy, zoom; bool follow; };   // zoom: screen pixels per unit of the 1623 x 958 marker space
+
+static const MapLevel *mapLevel(float zoom)
+{
+    int n = zoom <= 0.125f ? 2 : zoom <= 0.25f ? 1 : 0;
+    MapLevel &l = mapLevels[n];
+    if (!l.px && l.w >= 0) {
+        char path[64];
+        snprintf(path, sizeof path, "romfs:/smz3/map%d.bin", n);
+        size_t len = 0;
+        unsigned char *d = readFile(path, &len);
+        l.w = -1;
+        if (d && len > 4) {
+            int w = d[0] | d[1] << 8, h = d[2] | d[3] << 8;
+            if (len >= 4 + (size_t)w * h * 2) { l.px = (u16 *)malloc((size_t)w * h * 2); if (l.px) { memcpy(l.px, d + 4, (size_t)w * h * 2); l.w = w; l.h = h; } }
+        }
+        free(d);
+    }
+    return l.px ? &l : NULL;
+}
+
+// Draws the part of the map under the screen rectangle (rx0..rx1, ry0..ry1), darkened by shift (0 none, 1 half, 3 an eighth).
+static void mapPixels(const TrkMapView &v, int ax, int ay, int aw, int ah, int rx0, int ry0, int rx1, int ry1, int shift)
+{
+    const MapLevel *l = mapLevel(v.zoom);
+    if (!l) return;
+    if (rx0 < clipX0) rx0 = clipX0;
+    if (ry0 < clipY0) ry0 = clipY0;
+    if (rx1 > clipX1) rx1 = clipX1;
+    if (ry1 > clipY1) ry1 = clipY1;
+    float s = l->w / 1623.0f;
+    float ox = v.cx - (ax + aw / 2.0f) / v.zoom, oy = v.cy - (ay + ah / 2.0f) / v.zoom;
+    u16 mask = shift == 1 ? 0x7BEF : shift == 2 ? 0x39E7 : 0x18E3;
+    u16 empty = to565(0x0B0E12);
+    for (int x = rx0; x < rx1; x++) {
+        int mx = (int)((ox + (x + 0.5f) / v.zoom) * s);
+        u16 *p = trkFb + x * 240 + 239 - ry0;
+        if (mx < 0 || mx >= l->w) { for (int y = ry0; y < ry1; y++) *p-- = empty; continue; }
+        for (int y = ry0; y < ry1; y++) {
+            int my = (int)((oy + (y + 0.5f) / v.zoom) * s);
+            u16 c = my < 0 || my >= l->h ? empty : l->px[my * l->w + mx];
+            *p-- = shift ? (u16)((c >> shift) & mask) : c;
+        }
+    }
+}
+
+static signed short stackHead[SMZ_TRK_MAX_LOCS];
+static unsigned char stackSize[SMZ_TRK_MAX_LOCS];
+
+// Zelda checks on one spot of the map (a dungeon's chests) are one dot, drawn by the first of them.
+static void buildStacks()
+{
+    static bool done = false;
+    if (done) return;
+    done = true;
+    const SmzMapData &m = SMZ3_MAP_DATA;
+    static int markerOf[SMZ_TRK_MAX_LOCS];
+    for (int i = 0; i < SMZ_TRK_MAX_LOCS; i++) markerOf[i] = -1;
+    for (int k = 0; k < m.n_markers; k++) if (m.markers[k].index >= 0 && m.markers[k].index < SMZ_TRK_MAX_LOCS) markerOf[m.markers[k].index] = k;
+    for (unsigned i = 0; i < smz3_location_count && i < SMZ_TRK_MAX_LOCS; i++) {
+        stackHead[i] = (signed short)i;
+        if (markerOf[i] < 0 || smz3_locations[i].game != SMZ3_GAME_ZELDA) continue;
+        const SmzMarker &a = m.markers[markerOf[i]];
+        for (unsigned j = 0; j < i; j++) {
+            if (markerOf[j] < 0 || smz3_locations[j].game != SMZ3_GAME_ZELDA) continue;
+            const SmzMarker &b = m.markers[markerOf[j]];
+            if (a.x == b.x && a.y == b.y) { stackHead[i] = stackHead[j]; break; }
+        }
+    }
+    for (unsigned i = 0; i < smz3_location_count && i < SMZ_TRK_MAX_LOCS; i++) if (stackSize[stackHead[i]] < 255) stackSize[stackHead[i]]++;
+}
