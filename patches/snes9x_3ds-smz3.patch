+static int mapButtons(const char *const **names, const int **widths)
+{
+    if (dungeonShowing(dv)) { *names = DUNGEON_BUTTONS; *widths = DUNGEON_W; return 4; }
+    bool dungeons = dungeonAvailable();
+    *names = WORLD_BUTTONS + !dungeons; *widths = WORLD_W + !dungeons;
+    return dungeons ? 5 : 4;
+}
