+// Each region: a title with its count and a bar; a tap opens the list of its checks.
+static void drawChecks(int y0, int y1, int *tapRegion = NULL, int tapY = -1)
+{
+    buildRegions();
+    int y = y0 + 4 - scrollY[TAB_CHECKS], lastGame = 0;
+    char s[96];
+    for (int r = 0; r < nRegions; r++) {
+        Region &g = regions[r];
+        if (g.game != lastGame) {
+            lastGame = g.game;
+            if (!tapRegion) text(8, y + 2, theme.dim, lastGame == SMZ3_GAME_ZELDA ? "A LINK TO THE PAST" : "SUPER METROID");
+            y += 18;
+        }
+        int d = regionDone(g);
+        if (tapRegion && tapY >= y && tapY < y + 20) { *tapRegion = r; return; }
+        if (!tapRegion && y + 20 > y0 && y < y1) {
+            snprintf(s, sizeof s, "%s %s", g.open ? "-" : "+", g.name);
+            textFit(8, y, 230, d == g.count ? theme.done : theme.text, s);
+            snprintf(s, sizeof s, "%d / %d", d, g.count);
+            text(312, y, d == g.count ? theme.done : theme.text, s, HALIGN_RIGHT);
+            bar(8, y + 15, 304, 3, d, g.count, theme);
+        }
+        y += 21;
+        if (!g.open) continue;
+        for (int k = 0; k < g.count; k++, y += 14) {
+            if (tapRegion || y + 14 <= y0 || y >= y1) continue;
+            int i = regionLocs[g.first + k];
+            bool c = trk.cleared[i];
+            if (c) fill(20, y + 4, 26, y + 10, theme.done);
+            else { fill(20, y + 4, 26, y + 10, theme.dim); fill(21, y + 5, 25, y + 9, theme.bg); }
+            textFit(32, y, 280, c ? theme.done : theme.text, smz3_locations[i].name);
+        }
+        y += 4;
+    }
+    contentH[TAB_CHECKS] = y + scrollY[TAB_CHECKS] - y0;
+}
