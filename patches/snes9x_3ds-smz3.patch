+// Taps on the floor list of the dungeon picture in the MAP tab; true when one was hit.
+static bool dungeonFloorTap(int x, int y, int ay)
+{
+    int d, idx;
+    dungeonShown(dv, &d, &idx);
+    int fl = floorsOf(d);
+    if (x < 4 || x >= 4 + FLOOR_W) return false;
+    for (int i = fl - 1; i >= 0; i--) {
+        int by = ay + 18 + (fl - 1 - i) * (FLOOR_H + 2);
+        if (y >= by && y < by + FLOOR_H) { dungeonPick(dv, d, i); return true; }
+    }
+    return false;
+}
