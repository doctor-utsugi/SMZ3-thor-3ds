diff --git a/source/smz3run.cpp b/source/smz3run.cpp
new file mode 100644
index 0000000..71c37e5
--- /dev/null
+++ b/source/smz3run.cpp
@@ -0,0 +1,623 @@
+// SMZ3 runs: the shared C menu (core/ui) drawn on the second screen, and offline generation (core/gen).
+#include <3ds.h>
+#include <dirent.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <stdarg.h>
+#include <time.h>
+
+extern "C" {
+#include "smz3_host.h"
+#include "smz3_md5.h"
+#include "smz3_romsetup.h"
+#include "smz3_tracker.h"
+#include "smz3_proof.h"
+#include "smz3_run.h"
+#include "smz3_ui.h"
+#include "smz3_preview.h"
+}
+
+extern "C" {
+#include "smz3_state.h"
+}
+#include "snes9x.h"
+#include "memmap.h"
+#include "3dsgpu.h"
+#include "3dsimpl.h"
+#include "3dssettings.h"
+#include "3dsui.h"
+#include "smz3run.h"
+#include "smz3online.h"
+
+#define SMZ_DIR "sdmc:/SMZ3"
+#define RUN_DIR SMZ_DIR "/runs"
+#define SPRITE_DIR SMZ_DIR "/sprites"
+
+static int gPlaySlot = -1;   // slot of the run being played
+
+static const int PALETTE[] = {0x10141C, 0x1D2430, 0x2E4A6B, 0xE8ECF2, 0x8793A6, 0xE9A23B, 0xE05A4F, 0x4CC38A, 0x4FC3F7};
+
+static unsigned char *readFile(const char *path, size_t *len)
+{
+    FILE *f = fopen(path, "rb");
+    if (!f) return NULL;
+    fseek(f, 0, SEEK_END);
+    long n = ftell(f);
+    fseek(f, 0, SEEK_SET);
+    unsigned char *b = (unsigned char *)malloc(n > 0 ? n : 1);
+    if (b && fread(b, 1, n, f) != (size_t)n) { free(b); b = NULL; }
+    fclose(f);
+    if (b) *len = (size_t)n;
+    return b;
+}
+
+static const uint8_t *loadIps(void *, const char *name, size_t *len)
+{
+    static unsigned char *buf = NULL;
+    free(buf);
+    char path[128];
+    snprintf(path, sizeof path, "romfs:/smz3/ips/%s", name);
+    buf = readFile(path, len);
+    return buf;
+}
+
+static bool isBase(const unsigned char *rom, size_t len, bool *isSm)
+{
+    if (len == 0x300200 || len == 0x100200) { rom += 0x200; len -= 0x200; }
+    if (len != 0x300000 && len != 0x100000) return false;
+    char title[22];
+    memcpy(title, rom + 0x7FC0, 21);
+    title[21] = 0;
+    for (char *p = title; *p; p++) if (*p >= 'a' && *p <= 'z') *p -= 32;
+    *isSm = strstr(title, "METROID") != NULL;
+    return *isSm ? len == 0x300000 : (strstr(title, "ZELDA") != NULL && len == 0x100000);
+}
+
+static char wrongRom[48];   // set when a base ROM was found but it is not the revision the patches need
+
+// Finds the user's own Super Metroid and ALttP ROMs in the usual folders. Returns headerless copies (malloc). Only the exact
+// revisions the patches were written for are taken: with another A Link to the Past revision the patched Zelda code is
+// misaligned and the game crashes when Samus enters a portal.
+static bool findBaseRoms(unsigned char **sm, unsigned char **z3)
+{
+    wrongRom[0] = 0;
+    static const char *dirs[] = {SMZ_DIR "/base", "sdmc:/roms/snes", "sdmc:/roms", "sdmc:/ROMs", "sdmc:/"};
+    *sm = *z3 = NULL;
+    // keeps a copy of the image when it is one of the two exact revisions the patches were written for
+    auto offer = [&](const unsigned char *b, size_t len) {
+        bool sm_ = false;
+        if (!isBase(b, len, &sm_)) return;
+        size_t off = (len & 0x1FF) ? 0x200 : 0;
+        unsigned char **slot = sm_ ? sm : z3;
+        char md5[33];
+        smz_md5_hex(b + off, len - off, md5);
+        if (strcmp(md5, sm_ ? SMZ_MD5_SM : SMZ_MD5_Z3)) {
+            if (!wrongRom[0]) snprintf(wrongRom, sizeof wrongRom, sm_ ? "Super Metroid ROM must be (JU), md5 21f3e98d" : "ALttP ROM must be Japanese v1.0 (03a63945)");
+        } else if (!*slot) { *slot = (unsigned char *)malloc(len - off); memcpy(*slot, b + off, len - off); }
+    };
+    for (const char *d : dirs) {
+        DIR *dir = opendir(d);
+        if (!dir) continue;
+        while (struct dirent *e = readdir(dir)) {
+            if (e->d_type == DT_DIR) continue;
+            char path[PATH_MAX];
+            snprintf(path, sizeof path, "%s/%s", d, e->d_name);
+            struct stat st;
+            if (stat(path, &st)) continue;
+            bool rom = st.st_size == 0x300000 || st.st_size == 0x300200 || st.st_size == 0x100000 || st.st_size == 0x100200;
+            bool zip = st.st_size > 1000 && st.st_size < 0x500000 && strlen(e->d_name) > 4 && !strcasecmp(e->d_name + strlen(e->d_name) - 4, ".zip");
+            if (!rom && !zip) continue;
+            size_t len;
+            unsigned char *b = readFile(path, &len);
+            if (b && rom) offer(b, len);
+            else if (b && smz_is_zip(b, len)) {
+                for (int i = 0;; i++) {
+                    size_t k;
+                    unsigned char *img = smz_zip_entry(b, len, i, &k);
+                    if (!img) break;
+                    offer(img, k);
+                    free(img);
+                }
+            }
+            free(b);
+        }
+        closedir(dir);
+        if (*sm && *z3) return true;
+    }
+    return *sm && *z3;
+}
+
+static int listSprites(const char *dir, char names[][32], int max)
+{
+    int n = 0;
+    DIR *d = opendir(dir);
+    if (!d) return 0;
+    while (struct dirent *e = readdir(d)) {
+        size_t l = strlen(e->d_name);
+        if (l > 4 && l < 36 && !strcasecmp(e->d_name + l - 4, ".rdc") && n < max) { memcpy(names[n], e->d_name, l - 4); names[n][l - 4] = 0; n++; }
+    }
+    closedir(d);
+    return n;
+}
+
+static int listPlandos(const char *dir, char names[][32], int max)
+{
+    int n = 0;
+    DIR *d = opendir(dir);
+    if (!d) return 0;
+    while (struct dirent *e = readdir(d)) {
+        size_t l = strlen(e->d_name);
+        bool yml = l > 4 && !strcasecmp(e->d_name + l - 4, ".yml"), yaml = l > 5 && !strcasecmp(e->d_name + l - 5, ".yaml");
+        if ((yml || yaml) && l < 32 && n < max) { memcpy(names[n], e->d_name, l + 1); n++; }
+    }
+    closedir(d);
+    return n;
+}
+
+struct Preview { char key[48]; int w, h; unsigned char *rgba; };
+static Preview previews[40];
+static int previewNext;
+
+/* the .pv picture of a sprite ("link/<name>"), loaded once and kept; w == 0 when there is none */
+static const Preview *getPreview(const char *key)
+{
+    for (auto &p : previews) if (p.key[0] && !strcmp(p.key, key)) return p.w ? &p : NULL;
+    Preview &p = previews[previewNext];
+    previewNext = (previewNext + 1) % (int)(sizeof previews / sizeof previews[0]);
+    free(p.rgba);
+    p.rgba = NULL; p.w = p.h = 0;
+    snprintf(p.key, sizeof p.key, "%s", key);
+    char path[160];
+    snprintf(path, sizeof path, SPRITE_DIR "/%s.pv", key);
+    size_t len = 0;
+    unsigned char *d = readFile(path, &len);
+    int w, h;
+    const unsigned char *px;
+    if (d && smz_preview_parse(d, len, &w, &h, &px)) {   // a missing, empty or truncated file leaves the cell blank
+        p.rgba = (unsigned char *)malloc((size_t)w * h * 4);
+        if (p.rgba) { memcpy(p.rgba, px, (size_t)w * h * 4); p.w = w; p.h = h; }
+    }
+    free(d);
+    return p.w ? &p : NULL;
+}
+
+static void drawPreview(const UiCmd *c)
+{
+    const Preview *p = getPreview(c->text);
+    if (!p) return;
+    int dw = p->w, dh = p->h;
+    if (dw > c->w || dh > c->h) {   /* shrink to fit, keeping the aspect */
+        if (dw * c->h > dh * c->w) { dh = dh * c->w / dw; dw = c->w; } else { dw = dw * c->h / dh; dh = c->h; }
+        if (dw < 1) dw = 1;
+        if (dh < 1) dh = 1;
+    }
+    int ox = c->x + (c->w - dw) / 2, oy = c->y + (c->h - dh) / 2;
+    for (int y = 0; y < dh; y++) {
+        const unsigned char *row = p->rgba + (size_t)(y * p->h / dh) * p->w * 4;
+        int x = 0;
+        while (x < dw) {   /* horizontal runs of one colour become one rectangle */
+            const unsigned char *px = row + (size_t)(x * p->w / dw) * 4;
+            int x2 = x + 1;
+            while (x2 < dw && !memcmp(row + (size_t)(x2 * p->w / dw) * 4, px, 4)) x2++;
+            if (px[3] >= 128) ui3dsDrawRect(ox + x, oy + y, ox + x2, oy + y + 1, (px[0] << 16) | (px[1] << 8) | px[2]);
+            x = x2;
+        }
+    }
+}
+
+static void drawUi(SmzUi *u)
+{
+    ui_draw(u);
+    for (int i = 0; i < u->cmd_count; i++) {
+        const UiCmd *c = &u->cmd[i];
+        int color = PALETTE[c->color < 9 ? c->color : 3];
+        if (c->kind == 0) {
+            ui3dsDrawRect(c->x, c->y, c->x + c->w, c->y + c->h, color);
+        } else if (c->kind == 2) {
+            drawPreview(c);
+        } else {
+            int x0 = c->x, x1 = UI_W;
+            int align = HALIGN_LEFT;
+            if (c->align == 1) { x0 = c->x - 160; x1 = c->x + 160; align = HALIGN_CENTER; }
+            if (c->align == 2) { x0 = 0; x1 = c->x; align = HALIGN_RIGHT; }
+            ui3dsDrawStringWithNoWrapping(settings3DS.SecondScreen, x0, c->y, x1, c->y + 14, color, align, c->text);
+        }
+    }
+    impl3dsFlushScreen(settings3DS.SecondScreen, false, false);
+    gfxScreenSwapBuffers(settings3DS.SecondScreen, false);
+    gpu3dsWaitForVBlank(settings3DS.SecondScreen);
+}
+
+static void refreshSlots(SmzUi *u)
+{
+    for (int i = 0; i < UI_SLOTS; i++) {
+        char path[96], sum[64];
+        snprintf(path, sizeof path, RUN_DIR "/slot%d.run", i);
+        SmzRun r;
+        if (smz_run_load(path, &r) == 0) { smz_run_summary(&r, sum, sizeof sum); ui_set_slot(u, i, 1, r.name, sum); ui_set_slot_stats(u, i, r.zelda_cleared, r.zelda_total, r.metroid_cleared, r.metroid_total, r.play_ms, r.game, r.boss_mask, r.crystal_mask); ui_set_slot_online(u, i, smzOnlineSlotKind(i)); }
+        else ui_set_slot(u, i, 0, "", "");
+    }
+}
+
+struct GenJob {
+    const SmzUi *ui;
+    int32_t seedIfRandom;
+    unsigned char *sm, *z3, *link, *samus, *rom;
+    size_t linkLen, samusLen;
+    char json[4096], seedText[16];
+    char hints[SMZ_HOST_HELP_COUNT * SMZ_HOST_HELP_TEXT];
+    int rc;
+};
+
+static void genThread(void *arg)
+{
+    GenJob *j = (GenJob *)arg;
+    j->rc = smz_host_generate(j->ui, j->seedIfRandom, j->sm, j->z3, j->link, j->linkLen, j->samus, j->samusLen, loadIps, NULL,
+                              j->rom, j->json, sizeof j->json, j->seedText, sizeof j->seedText, j->hints);
+}
+
+static bool generateRun(SmzUi *u, int slot, char *message, size_t cap)
+{
+    GenJob job;
+    memset(&job, 0, sizeof job);
+    if (!findBaseRoms(&job.sm, &job.z3)) {
+        snprintf(message, cap, "%s", wrongRom[0] ? wrongRom : "Put both ROMs (or a zip) in " SMZ_DIR "/base");
+        free(job.sm); free(job.z3);
+        return false;
+    }
+    job.ui = u;
+    job.seedIfRandom = (int32_t)((osGetTime() ^ (u64)svcGetSystemTick() * 2654435761ull) & 0x7FFFFFFF);
+    char link[32], samus[32], path[128];
+    smz_host_sprites(u, link, samus);
+    if (link[0]) { snprintf(path, sizeof path, SPRITE_DIR "/link/%s.rdc", link); job.link = readFile(path, &job.linkLen); }
+    if (samus[0]) { snprintf(path, sizeof path, SPRITE_DIR "/samus/%s.rdc", samus); job.samus = readFile(path, &job.samusLen); }
+    // a plando file replaces the generated seed and the settings it carries
+    char plando[32], perr[160] = "";
+    smz_host_plando_name(u, plando);
+    if (plando[0]) {
+        size_t plen = 0;
+        snprintf(path, sizeof path, SMZ_DIR "/plando/%s", plando);
+        unsigned char *yaml = readFile(path, &plen);
+        if (!yaml || smz_host_set_plando((const char *)yaml, plen, perr, sizeof perr)) {
+            snprintf(message, cap, "Plando: %.40s", yaml ? perr : "cannot read the file");
+            free(yaml); free(job.sm); free(job.z3); free(job.link); free(job.samus);
+            return false;
+        }
+        free(yaml);
+    } else smz_host_set_plando(NULL, 0, perr, sizeof perr);
+    job.rom = (unsigned char *)malloc(SMZ_HOST_ROM_SIZE);
+    bool ok = false;
+    if (job.rom) {
+        Thread t = threadCreate(genThread, &job, 512 * 1024, 0x30, -2, false);
+        if (t) { threadJoin(t, U64_MAX); threadFree(t); }
+        else genThread(&job);
+        if (job.rc == 0) {
+            char name[96];
+            smz_run_rom_name(job.json, job.seedText, name, sizeof name);
+            mkdir(SMZ_DIR, 0777); mkdir(RUN_DIR, 0777); mkdir(SMZ_DIR "/saves", 0777); mkdir(SMZ_DIR "/savestates", 0777);
+            SmzRun r;
+            memset(&r, 0, sizeof r);
+            snprintf(r.name, sizeof r.name, "%s", ui_run_label(u)[0] ? ui_run_label(u) : "Run");
+            snprintf(r.seed, sizeof r.seed, "%s", job.seedText);
+            snprintf(r.rom_path, sizeof r.rom_path, RUN_DIR "/%s", name);
+            snprintf(r.settings, sizeof r.settings, "%s", job.json);
+            r.created = (int64_t)time(NULL) * 1000;
+            r.zelda_total = 216; r.metroid_total = 100;
+            FILE *f = fopen(r.rom_path, "wb");
+            if (f) { ok = fwrite(job.rom, 1, SMZ_HOST_ROM_SIZE, f) == SMZ_HOST_ROM_SIZE; fclose(f); }
+            if (ok) {
+                // the helps of the run: "mode count used given" and then the hints that may be asked for
+                int mode = u->value[UIO_HELP], count = u->value[UIO_HELPS];
+                char helpPath[300];
+                snprintf(helpPath, sizeof helpPath, "%.250s.help", r.rom_path);
+                FILE *h = fopen(helpPath, "wb");
+                if (h) {
+                    fprintf(h, "%d %d 0 0\n", mode, count);
+                    for (int i = 0; i < SMZ_HOST_HELP_COUNT; i++) fprintf(h, "%s\n", mode == 2 ? "" : job.hints + i * SMZ_HOST_HELP_TEXT);
+                    fclose(h);
+                }
+                snprintf(path, sizeof path, RUN_DIR "/slot%d.run", slot);
+                ok = smz_run_save(path, &r) == 0;
+                if (ok) smzOnlineMarkRun(slot, ui_online_now(u), ui_run_weekly(u) ? 3 : ui_run_monthly(u) ? 2 : 1);
+            }
+            if (!ok) snprintf(message, cap, "Cannot write to " RUN_DIR);
+        } else {
+            snprintf(message, cap, "Generation failed (%d)", job.rc);
+        }
+    }
+    free(job.rom); free(job.link); free(job.samus); free(job.sm); free(job.z3);
+    return ok;
+}
+
+static void deleteRun(int slot)
+{
+    char path[96];
+    snprintf(path, sizeof path, RUN_DIR "/slot%d.run", slot);
+    SmzRun r;
+    if (smz_run_load(path, &r) == 0 && r.rom_path[0]) remove(r.rom_path);
+    remove(path);
+}
+
+#define SAVED_FILE SMZ_DIR "/saved_customs.txt"
+
+static void loadSavedCustoms(SmzUi *u)
+{
+    size_t len = 0;
+    unsigned char *data = readFile(SAVED_FILE, &len);
+    if (!data) { ui_saved_load(u, NULL); return; }
+    char *text = (char *)malloc(len + 1);
+    if (text) { memcpy(text, data, len); text[len] = 0; ui_saved_load(u, text); free(text); }
+    free(data);
+}
+
+static void storeSavedCustoms(SmzUi *u)
+{
+    static char buf[UI_MAX_SAVED * (UI_SPEC_LEN + 40)];
+    if (!ui_saved_dirty(u) || ui_saved_text(u, buf, sizeof buf) < 0) return;
+    mkdir(SMZ_DIR, 0777);
+    FILE *f = fopen(SAVED_FILE, "wb");
+    if (f) { fwrite(buf, 1, strlen(buf), f); fclose(f); }
+}
+
+bool smz3RunMenu(char *romPathOut, size_t cap)
+{
+    static SmzUi ui;
+    static char linkNames[UI_MAX_SPRITES][32], samusNames[UI_MAX_SPRITES][32];
+    ui_init(&ui);
+    const char *list[UI_MAX_SPRITES];
+    int n = listSprites(SPRITE_DIR "/link", linkNames, UI_MAX_SPRITES - 1);
+    for (int i = 0; i < n; i++) list[i] = linkNames[i];
+    ui_set_sprites(&ui, 0, list, n);
+    n = listSprites(SPRITE_DIR "/samus", samusNames, UI_MAX_SPRITES - 1);
+    for (int i = 0; i < n; i++) list[i] = samusNames[i];
+    ui_set_sprites(&ui, 1, list, n);
+    static char plandoNames[UI_MAX_SPRITES][32];
+    n = listPlandos(SMZ_DIR "/plando", plandoNames, UI_MAX_SPRITES - 1);
+    for (int i = 0; i < n; i++) list[i] = plandoNames[i];
+    ui_set_sprites(&ui, 2, list, n);
+    loadSavedCustoms(&ui);
+    ui_player_enable(&ui, 1);
+    {
+        char profile[96];
+        if (smzOnlineProfileLoad(profile, sizeof profile)) ui_player_load(&ui, profile);
+    }
+    smzOnlineStartup();
+    ui_ladder_enable(&ui, 1);
+    refreshSlots(&ui);
+
+    bool chosen = false;
+    char note[64] = "";
+    while (aptMainLoop()) {
+        hidScanInput();
+        u32 down = hidKeysDown();
+        UiButton b;
+        bool have = true;
+        if (down & KEY_DUP) b = BTN_UP;
+        else if (down & KEY_DDOWN) b = BTN_DOWN;
+        else if (down & KEY_DLEFT) b = BTN_LEFT;
+        else if (down & KEY_DRIGHT) b = BTN_RIGHT;
+        else if (down & KEY_A) b = BTN_A;
+        else if (down & KEY_B) {
+            if (ui.screen == UI_SLOTS_SCREEN) break;
+            b = BTN_B;
+        }
+        else if (down & KEY_L) b = BTN_L;
+        else if (down & KEY_R) b = BTN_R;
+        else have = false;
+        if (have) ui_input(&ui, b);
+        if (down & KEY_TOUCH) {
+            touchPosition t;
+            hidTouchRead(&t);
+            ui_touch(&ui, t.px, t.py);
+        }
+        storeSavedCustoms(&ui);
+        {
+            char label[16];
+            int seed, days;
+            if (smzOnlineTakeMonthly(label, &seed, &days)) ui_set_monthly(&ui, label, seed, days);
+            if (smzOnlineTakeWeekly(label, &seed, &days)) ui_set_weekly(&ui, label, seed, days);
+            static char ladderJson[16384];
+            for (int t = 0; t < 3; t++) {
+                int st = smzOnlineTakeLadder(t, ladderJson, sizeof ladderJson);
+                if (st) ui_ladder_load_json(&ui, t, st == 1 ? ladderJson : NULL);
+            }
+            if (ui_player_dirty(&ui)) { char profile[96]; ui_player_text(&ui, profile, sizeof profile); smzOnlineProfileSave(profile); }
+        }
+        if (ui.action != ACT_NONE) {
+            int act = ui.action, slot = ui.action_slot;
+            ui.action = ACT_NONE;
+            if (act == ACT_LADDER) smzOnlineRequestLadders();
+            else if (act == ACT_DELETE) { deleteRun(slot); refreshSlots(&ui); }
+            else if (act == ACT_CONTINUE) {
+                char path[96];
+                SmzRun r;
+                snprintf(path, sizeof path, RUN_DIR "/slot%d.run", slot);
+                if (smz_run_load(path, &r) == 0) {
+                    // The run's screen shape picks the scaling: wide fills the 400x240 screen, pixel is 8:7, original is 4:3.
+                    settings3DS.ScreenStretch = strstr(r.settings, "\"screenShape\":\"wide\"") ? Setting::ScreenStretch::Full
+                        : strstr(r.settings, "\"screenShape\":\"pixel\"") ? Setting::ScreenStretch::CrtAspect
+                        : Setting::ScreenStretch::Aspect_4_3;
+                    settings3dsApplyScreenStretch();
+                    mkdir(SMZ_DIR "/saves", 0777); mkdir(SMZ_DIR "/savestates", 0777); snprintf(romPathOut, cap, "%s", r.rom_path); gPlaySlot = slot; chosen = true; break; }
+            } else if (act == ACT_GENERATE) {
+                ui_busy(&ui, "Generating the seed ...");
+                drawUi(&ui);
+                if (!generateRun(&ui, slot, note, sizeof note)) { ui_idle(&ui); ui_busy(&ui, note); drawUi(&ui); svcSleepThread(2500000000LL); }
+                ui_idle(&ui);
+                refreshSlots(&ui);
+            }
+        }
+        drawUi(&ui);
+    }
+    return chosen;
+}
+
+// ---- tracker panel on the second screen while a run is played (software drawn once per second, like the menu)
+
+static void trackerLine(int y, int color, const char *fmt, ...) __attribute__((format(printf, 3, 4)));
+static void trackerLine(int y, int color, const char *fmt, ...)
+{
+    char text[96];
+    va_list ap;
+    va_start(ap, fmt);
+    vsnprintf(text, sizeof text, fmt, ap);
+    va_end(ap);
+    ui3dsDrawStringWithNoWrapping(settings3DS.SecondScreen, 12, y, 308, y + 14, color, HALIGN_LEFT, text);
+}
+
+void smz3TrackerFrame(void)
+{
+    static u64 startedAt = 0;
+    if (strncmp(Memory.ROMFilename, RUN_DIR "/", sizeof RUN_DIR) != 0 || !Memory.RAM || !Memory.SRAM) return;
+    // debug aid: sdmc:/SMZ3/debug_poke.txt, lines "w <hex offset> <hex value>" (WRAM) or "s ..." (SRAM) are OR-ed into memory
+    if (FILE *dbg = fopen(SMZ_DIR "/debug_poke.txt", "r")) {
+        char kind;
+        unsigned off, val;
+        while (fscanf(dbg, " %c %x %x", &kind, &off, &val) == 3) {
+            if (kind == 'w' && off < 0x20000) Memory.RAM[off] |= (u8)val;
+            if (kind == 's' && off < 0x20000) Memory.SRAM[off] |= (u8)val;
+        }
+        fclose(dbg);
+    }
+    smz3_summary sum;
+    smz3_summarize(Memory.RAM, 0x20000, Memory.SRAM, 0x20000, &sum);
+    if (sum.started && !startedAt) startedAt = osGetTime();
+    if (!sum.started) startedAt = 0;
+    // play time, proof of run and the online ladder: the shared tracker reads the same memory as the other frontends
+    static SmzTracker trk;
+    static SmzProof proof;
+    static int curSlot = -1, calls = 0, proofDirty = 0, queued = 0;
+    static u64 lastMs = 0, nextToken = 0;
+    if (gPlaySlot != curSlot) {
+        curSlot = gPlaySlot;
+        SmzRun r0;
+        char rp[96];
+        snprintf(rp, sizeof rp, RUN_DIR "/slot%d.run", curSlot);
+        memset(&r0, 0, sizeof r0);
+        if (curSlot >= 0 && smz_run_load(rp, &r0) == 0) smz_tracker_reset(&trk, r0.play_ms, r0.save_ms, r0.save_zelda, r0.save_metroid);
+        else smz_tracker_reset(&trk, 0, 0, 0, 0);
+        size_t pn = 0;
+        char *pt = (char *)readFile(smzOnlineProofPath(curSlot), &pn);
+        if (pt) { char *z = (char *)realloc(pt, pn + 1); if (z) { z[pn] = 0; pt = z; } }
+        smz_proof_parse(&proof, pt ? pt : "");
+        free(pt);
+        lastMs = osGetTime();
+        calls = proofDirty = queued = 0;
+        nextToken = 0;
+    }
+    u64 nowMs = osGetTime();
+    int dt = (int)(nowMs - lastMs);
+    lastMs = nowMs;
+    if (dt < 0 || dt > 3000) dt = 1000;   // a pause in between is not play time
+    smz_tracker_tick(&trk, Memory.RAM, 0x20000, Memory.SRAM, 0x20000, dt, 1);
+    int online = curSlot >= 0 ? smzOnlineSlotKind(curSlot) : 0;
+    if (online && trk.started && smz_proof_note(&proof, trk.cleared, SMZ_TRK_MAX_LOCS, trk.base_ms + trk.pending_ms)) proofDirty = 1;
+    // debug aid: sdmc:/SMZ3/debug_token.txt asks for the run's token even before the game has started
+    if (online) if (FILE *dt = fopen(SMZ_DIR "/debug_token.txt", "r")) { fclose(dt); remove(SMZ_DIR "/debug_token.txt"); smzOnlineEnsureToken(curSlot); }
+    if (online && trk.started && trk.running && nowMs >= nextToken) { nextToken = nowMs + 60000; smzOnlineEnsureToken(curSlot); }
+    if (curSlot >= 0 && (++calls % 10 == 0 || trk.game == 3)) {   // the run's file keeps the play time and the progress
+        char rp[96];
+        SmzRun r1;
+        snprintf(rp, sizeof rp, RUN_DIR "/slot%d.run", curSlot);
+        if (smz_run_load(rp, &r1) == 0 && trk.started) {
+            r1.play_ms = trk.base_ms + trk.pending_ms;
+            r1.last_played = (int64_t)time(NULL) * 1000;
+            r1.game = (int)trk.game;
+            r1.zelda_cleared = (int)trk.zelda_cleared; r1.metroid_cleared = (int)trk.metroid_cleared;
+            r1.boss_mask = trk.boss_mask; r1.crystal_mask = trk.crystal_mask;
+            if (trk.save_ms > 0) { r1.save_ms = trk.save_ms; r1.save_zelda = trk.save_zelda; r1.save_metroid = trk.save_metroid; }
+            if (smz_run_save(rp, &r1) == 0) smz_tracker_commit(&trk);
+            if (online && proofDirty) {
+                static char ptxt[SMZ_PROOF_MAX * 24];
+                size_t pl = smz_proof_format(&proof, ptxt, sizeof ptxt);
+                FILE *pf = fopen(smzOnlineProofPath(curSlot), "wb");
+                if (pf) { fwrite(ptxt, 1, pl, pf); fclose(pf); proofDirty = 0; }
+            }
+            if (online && trk.game == 3 && !queued && strstr(r1.settings, "\"defaultRules\":true")) {
+                queued = 1;
+                smzOnlineQueueFinish(curSlot, r1.play_ms, atoi(r1.seed));
+            }
+        }
+    }
+    long long sec = (trk.base_ms + trk.pending_ms) / 1000;
+    if (gfxGetScreenFormat(settings3DS.SecondScreen) != GSP_RGB565_OES) gfxSetScreenFormat(settings3DS.SecondScreen, GSP_RGB565_OES);
+    ui3dsDrawRect(0, 0, 320, 240, PALETTE[0]);
+    ui3dsDrawRect(0, 0, 320, 28, PALETTE[1]);
+    trackerLine(7, PALETTE[5], "SMZ3 tracker");
+    const char *game = !sum.started ? "Waiting for a file" : sum.game == SMZ3_GAME_ZELDA ? "A Link to the Past" : sum.game == SMZ3_GAME_METROID ? "Super Metroid" : "Credits";
+    trackerLine(44, PALETTE[3], "%s", game);
+    trackerLine(70, PALETTE[3], "Zelda    %u / %u", sum.zelda_cleared, sum.zelda_total);
+    trackerLine(92, PALETTE[3], "Metroid  %u / %u", sum.metroid_cleared, sum.metroid_total);
+    trackerLine(122, PALETTE[4], "%lld:%02lld:%02lld", sec / 3600, sec / 60 % 60, sec % 60);
+    // debug aid: with sdmc:/SMZ3/debug_panel.txt present the panel also shows where Samus is (room, x, y, missiles),
+    // which is how a blind input route can be followed on an emulator whose picture is garbled
+    if (FILE *dp = fopen(SMZ_DIR "/debug_panel.txt", "r")) {
+        fclose(dp);
+        const u8 *r = Memory.RAM;
+        trackerLine(150, PALETTE[4], "room %04X", r[0x79B] | r[0x79C] << 8);
+        trackerLine(172, PALETTE[4], "x %u y %u", r[0xAF6] | r[0xAF7] << 8, r[0xAFA] | r[0xAFB] << 8);
+        trackerLine(194, PALETTE[4], "m%u i%04X e%04X s%u", r[0x9C6] | r[0x9C7] << 8, r[0x9A2] | r[0x9A3] << 8, r[0x9A4] | r[0x9A5] << 8, r[0x9D2] | r[0x9D3] << 8);
+        if (FILE *st = fopen(SMZ_DIR "/debug_state.txt", "w")) {   // the same numbers for a script that reads the SD card
+            fprintf(st, "%u %u %u %u %u %u %u %u %u %u %u %u %u %u\n", r[0x79B] | r[0x79C] << 8, r[0xAF6] | r[0xAF7] << 8, r[0xAFA] | r[0xAFB] << 8,
+                    r[0x9C6] | r[0x9C7] << 8, sum.metroid_cleared, sum.zelda_cleared, r[0x9D2] | r[0x9D3] << 8,
+                    Memory.SRAM[0x33FE], r[0xA0] | r[0xA1] << 8, r[0x22] | r[0x23] << 8, r[0x20] | r[0x21] << 8, r[0x1B],
+                    r[0xA1C] | r[0xA1D] << 8, sum.zelda_cleared + sum.metroid_cleared);
+            fclose(st);
+        }
+    }
+    // debug aid: sdmc:/SMZ3/debug_dump.txt asks for one dump of the whole WRAM to ram.bin (then the flag is removed)
+    if (FILE *dd = fopen(SMZ_DIR "/debug_dump.txt", "r")) {
+        fclose(dd);
+        if (FILE *rb = fopen(SMZ_DIR "/ram.bin", "wb")) { fwrite(Memory.RAM, 1, 0x20000, rb); fclose(rb); }
+        if (FILE *rg = fopen(SMZ_DIR "/regs.txt", "w")) {   // CPU registers, to see where a hung game is stuck
+            fprintf(rg, "PB %02X PC %04X DB %02X P %04X A %04X X %04X Y %04X S %04X D %04X\n", Registers.PB, Registers.PC, Registers.DB,
+                    Registers.P.W, Registers.A.W, Registers.X.W, Registers.Y.W, Registers.S.W, Registers.D.W);
+            fclose(rg);
+        }
+        if (FILE *sr = fopen(SMZ_DIR "/sram.bin", "wb")) { fwrite(Memory.SRAM, 1, 0x8000, sr); fclose(sr); }
+        remove(SMZ_DIR "/debug_dump.txt");
+    }
+    impl3dsFlushScreen(settings3DS.SecondScreen, false, false);
+    gfxScreenSwapBuffers(settings3DS.SecondScreen, false);
+}
+
+// ---- helps of the run being played (the pause menu asks for them)
+
+bool smz3IsRun(void) { return strncmp(Memory.ROMFilename, RUN_DIR "/", sizeof RUN_DIR) == 0; }
+
+// Monthly and weekly runs allow no save states of any kind.
+bool smz3NoStates(void) { return smz3IsRun() && gPlaySlot >= 0 && smzOnlineSlotKind(gPlaySlot) >= 2; }
+
+// Gives the next hint (a help is spent in the limited mode). The text is for a dialog.
+void smz3AskHelp(char *out, size_t cap)
+{
+    char path[320];
+    snprintf(path, sizeof path, "%.300s.help", Memory.ROMFilename);
+    FILE *f = fopen(path, "rb");
+    if (!f) { snprintf(out, cap, "This run has no helps."); return; }
+    int mode = 2, count = 0, used = 0, given = 0;
+    static char hints[SMZ_HOST_HELP_COUNT][SMZ_HOST_HELP_TEXT];
+    if (fscanf(f, "%d %d %d %d\n", &mode, &count, &used, &given) != 4) mode = 2;
+    for (int i = 0; i < SMZ_HOST_HELP_COUNT; i++) {
+        hints[i][0] = 0;
+        if (!fgets(hints[i], SMZ_HOST_HELP_TEXT, f)) break;
+        hints[i][strcspn(hints[i], "\r\n")] = 0;
+    }
+    fclose(f);
+    if (mode == 2) { snprintf(out, cap, "This run has no helps."); return; }
+    if (mode == 1 && used >= count) { snprintf(out, cap, "No helps left (0 of %d).", count); return; }
+    if (given >= SMZ_HOST_HELP_COUNT || !hints[given][0]) { snprintf(out, cap, "No more hints."); return; }
+    int index = given;
+    given++;
+    if (mode == 1) used++;
+    f = fopen(path, "wb");
+    if (f) {
+        fprintf(f, "%d %d %d %d\n", mode, count, used, given);
+        for (int i = 0; i < SMZ_HOST_HELP_COUNT; i++) fprintf(f, "%s\n", hints[i]);
+        fclose(f);
+    }
+    if (mode == 1) snprintf(out, cap, "%s (helps left: %d of %d)", hints[index], count - used, count);
+    else snprintf(out, cap, "%s", hints[index]);
+}
