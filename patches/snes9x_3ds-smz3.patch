+// The game has ended: the card when it ends now, only the details for a run finished before.
+static void cardBegin()
+{
+    cardState = finishedBefore ? 2 : 1;
+    cardStart = osGetTime();
+    cardMs = daily && dailyDoneMs > 1 ? dailyDoneMs : runMs();
+    if (finishedBefore) { cardZ = finalRun.zelda_cleared; cardZT = finalRun.zelda_total; cardM = finalRun.metroid_cleared; cardMT = finalRun.metroid_total; }
+    else { cardZ = trk.zelda_cleared; cardZT = trk.zelda_total; cardM = trk.metroid_cleared; cardMT = trk.metroid_total; }
+    cardLastT = 0; cardTicks = cardRows = 0; cardLanded = cardBurst = finishedBefore;
+    if (finishedBefore) cardTicks = 1000;
+    memset(part, 0, sizeof part);
+    dirty = true;
+}
+
+// A press before the buttons: straight to the end, without the sounds on the way.
+static bool cardSkip()
+{
+    if (cardT() >= T_BUTTONS) return false;
+    cardStart = osGetTime() - (u64)(T_BUTTONS * 1000);
+    cardTicks = 1000; cardRows = CARD_ROWS; cardLanded = cardBurst = true;
+    dirty = true;
+    return true;
+}
+
+static void fmtTime(int64_t ms, char *out, size_t cap)
+{
+    long long s = ms / 1000;
+    snprintf(out, cap, "%lld:%02lld:%02lld.%02lld", s / 3600, s / 60 % 60, s % 60, (long long)(ms % 1000 / 10));
+}
+
+static int pct(unsigned a, unsigned b) { return b ? (int)(100.0 * a / b + 0.5) : 0; }
+
+// sounds on ndsp channels 1 to 3 (the SNES plays on 0), one each so the rows don't cut the fanfare, synthesized once
+enum { SFX_TICK, SFX_ROW, SFX_FANFARE, SFX_COUNT };
+#define SFX_RATE 22050
+static ndspWaveBuf sfxBuf[SFX_COUNT];
+static bool sfxReady;
+
+static void sfxNote(s16 *out, int n, float at, float len, float hz, float vol)
+{
+    int i0 = (int)(at * SFX_RATE), i1 = (int)((at + len) * SFX_RATE);
+    for (int i = i0 < 0 ? 0 : i0; i < i1 && i < n; i++) {
+        float t = (float)(i - i0) / SFX_RATE, env = fminf(1, t * 200) * expf(-t * 3.2f / len);
+        float v = out[i] + 32767 * vol * env * (sinf(2 * (float)M_PI * hz * t) + 0.3f * sinf(4 * (float)M_PI * hz * t));
+        out[i] = (s16)(v > 32767 ? 32767 : v < -32767 ? -32767 : v);
+    }
+}
+
+static void sfxInit()
+{
+    if (sfxReady || snd3DS.audioType != 2) return;
+    static const float LEN[SFX_COUNT] = {0.03f, 0.16f, 2.0f};
+    for (int k = 0; k < SFX_COUNT; k++) {
+        int n = (int)(LEN[k] * SFX_RATE);
+        s16 *p = (s16 *)linearAlloc(n * 2);
+        if (!p) return;
+        memset(p, 0, n * 2);
+        if (k == SFX_TICK) sfxNote(p, n, 0, 0.03f, 1500, 0.10f);
+        if (k == SFX_ROW) { sfxNote(p, n, 0, 0.08f, 880, 0.14f); sfxNote(p, n, 0.07f, 0.09f, 1320, 0.14f); }
+        if (k == SFX_FANFARE) {   // C5 E5 G5 C6, then the chord held
+            static const float ARP[] = {523.25f, 659.25f, 783.99f, 1046.5f}, CHORD[] = {261.63f, 329.63f, 392.0f, 523.25f, 659.25f};
+            for (int i = 0; i < 4; i++) sfxNote(p, n, i * 0.07f, 0.25f, ARP[i], 0.12f);
+            for (float hz : CHORD) sfxNote(p, n, 0.30f, 1.6f, hz, 0.07f);
+        }
+        DSP_FlushDataCache(p, n * 2);
+        memset(&sfxBuf[k], 0, sizeof sfxBuf[k]);
+        sfxBuf[k].data_vaddr = p;
+        sfxBuf[k].nsamples = n;
+    }
+    for (int k = 0; k < SFX_COUNT; k++) {
+        float mix[12] = {1, 1};
+        ndspChnReset(1 + k);
+        ndspChnSetInterp(1 + k, NDSP_INTERP_LINEAR);
+        ndspChnSetRate(1 + k, SFX_RATE);
+        ndspChnSetFormat(1 + k, NDSP_FORMAT_MONO_PCM16);
+        ndspChnSetMix(1 + k, mix);
+    }
+    sfxReady = true;
+}
+
+static void sfxPlay(int k)
+{
+    sfxInit();
+    if (!sfxReady) return;
+    ndspChnWaveBufClear(1 + k);
+    sfxBuf[k].status = NDSP_WBUF_FREE;
+    ndspChnWaveBufAdd(1 + k, &sfxBuf[k]);
+}
+
+// The sounds follow the timeline, once a frame.
+static void cardSounds()
+{
+    float t = cardT();
+    if (t >= T_COUNT && t < T_LAND && (int)((t - T_COUNT) / 0.11f) > cardTicks) { cardTicks = (int)((t - T_COUNT) / 0.11f); sfxPlay(SFX_TICK); }
+    if (t >= T_LAND && !cardLanded) { cardLanded = true; sfxPlay(SFX_FANFARE); }
+    if (t >= T_ROWS + cardRows && cardRows < CARD_ROWS) { cardRows++; sfxPlay(SFX_ROW); }
+}
+
+// the game screen's layer: drawn in RGBA8, uploaded as RGBA4 and blended over the game
+static u8 cv[CV_H][CV_W][4];
+static int cvW = CV_W;
+
+static void cvPut(int x, int y, int rgb, int a)
+{
+    if (x < 0 || y < 0 || x >= cvW || y >= CV_H || a <= 0) return;
+    u8 *d = cv[y][x];
+    if (a > 255) a = 255;
+    int da = d[3] * (255 - a) / 255, oa = a + da;
+    if (!oa) return;
+    d[0] = (u8)((((rgb >> 16) & 255) * a + d[0] * da) / oa);
+    d[1] = (u8)((((rgb >> 8) & 255) * a + d[1] * da) / oa);
+    d[2] = (u8)(((rgb & 255) * a + d[2] * da) / oa);
+    d[3] = (u8)oa;
+}
+
+static void cvRect(float x0, float y0, float x1, float y1, int rgb, int a)
+{
+    for (int y = (int)fmaxf(0, y0); y < (int)fminf(CV_H, y1); y++)
+        for (int x = (int)fmaxf(0, x0); x < (int)fminf(cvW, x1); x++) cvPut(x, y, rgb, a);
+}
+
+static void cvQuad(const float *xy, int rgb, int a)   // convex, corners in order
+{
+    float x0 = xy[0], x1 = xy[0], y0 = xy[1], y1 = xy[1];
+    for (int k = 1; k < 4; k++) { x0 = fminf(x0, xy[k * 2]); x1 = fmaxf(x1, xy[k * 2]); y0 = fminf(y0, xy[k * 2 + 1]); y1 = fmaxf(y1, xy[k * 2 + 1]); }
+    for (int y = (int)y0; y <= (int)y1; y++)
+        for (int x = (int)x0; x <= (int)x1; x++) {
+            int pos = 0, neg = 0;
+            for (int k = 0; k < 4; k++) {
+                const float *p = xy + k * 2, *q = xy + (k + 1) % 4 * 2;
+                float c = (q[0] - p[0]) * (y + 0.5f - p[1]) - (q[1] - p[1]) * (x + 0.5f - p[0]);
+                if (c > 0) pos++; else if (c < 0) neg++;
+            }
+            if (!pos || !neg) cvPut(x, y, rgb, a);
+        }
+}
+
+static void cvRing(float cx, float cy, float r, float th, int rgb, int a)
+{
+    for (int y = (int)(cy - r - 1); y <= (int)(cy + r + 1); y++)
+        for (int x = (int)(cx - r - 1); x <= (int)(cx + r + 1); x++) {
+            float d = sqrtf((x + 0.5f - cx) * (x + 0.5f - cx) + (y + 0.5f - cy) * (y + 0.5f - cy));
+            if (d <= r && d >= r - th) cvPut(x, y, rgb, a);
+        }
+}
+
+static void cvDisc(float cx, float cy, float r, int rgb, int a) { cvRing(cx, cy, r, r, rgb, a); }
+
+// Text through the UI's font (13 to 32 px high). align 0 left, 1 centre, 2 right of x. Returns its width.
+static int cvText(float x, float y, int h, int rgb, int a, const char *s, int align = 0)
+{
+    enum { BW = 512 };
+    static u16 buf[BW * 32];
+    if (h > 32) h = 32;
+    memset(buf, 0, BW * h * 2);
+    int w = ui3dsDrawStringToTexture(buf, s, 0, 0, BW, h, (u32)rgb << 8, h);
+    int ox = (int)(x - (align == 1 ? w / 2 : align == 2 ? w : 0)), oy = (int)y;
+    for (int yy = 0; yy < h; yy++)
+        for (int xx = 0; xx < w; xx++) {
+            int a4 = buf[yy * BW + xx] & 15;
+            if (a4) cvPut(ox + xx, oy + yy, rgb, a4 * 17 * a / 255);
+        }
+    return w;
+}
+
+static void cvButton(float x, float y, const char *key, const char *label, int a)
+{
+    cvDisc(x + 7, y + 7, 7.5f, 0x2A3442, a);
+    cvText(x + 7, y + 1, 13, 0xFFE07A, a, key, 1);
+    cvText(x + 18, y + 1, 13, 0xE8ECF2, a, label);
+}
+
+static void burst(float x, float y, int n, float speed)
+{
+    for (int i = 0; i < PARTS && n > 0; i++) {
+        if (part[i].on) continue;
+        float a = -(float)M_PI / 2 + (frand() - 0.5f) * 2.6f, v = speed * (0.45f + 0.55f * frand());
+        part[i] = {x, y, cosf(a) * v, sinf(a) * v, frand() * 6.3f, (frand() - 0.5f) * 14, 0.6f + 0.6f * frand(), frand() * 6.3f, rand() % 6, true};
+        n--;
+    }
+}
+
+static void rain()
+{
+    for (int i = 0; i < PARTS; i++) {
+        if (part[i].on) continue;
+        part[i] = {frand() * cvW, -8, (frand() - 0.5f) * 14, 20 + frand() * 27, frand() * 6.3f, (frand() - 0.5f) * 8, 0.5f + 0.5f * frand(), frand() * 6.3f, rand() % 6, true};
+        return;
+    }
+}
+
+static void drawParts(float dt)
+{
+    for (Part &p : part) {
+        if (!p.on) continue;
+        p.vy += 173 * dt;
+        p.vx *= 1 - 1.6f * dt;
+        if (p.vy > 57) p.vy = 57;   // paper falls slowly once it has opened
+        p.x += (p.vx + sinf(p.flutter + p.y / 13) * 10) * dt;
+        p.y += p.vy * dt;
+        p.rot += p.vrot * dt;
+        if (p.y > CV_H + 10) { p.on = false; continue; }
+        float w = 3.4f * p.size, h = 1.9f * p.size * fabsf(cosf(p.rot * 1.7f)) + 0.5f;   // the spin shows its edge
+        float c = cosf(p.rot), s = sinf(p.rot), xy[8];
+        const float cx[4] = {-w, w, w, -w}, cy[4] = {-h, -h, h, h};
+        for (int k = 0; k < 4; k++) { xy[k * 2] = p.x + cx[k] * c - cy[k] * s; xy[k * 2 + 1] = p.y + cx[k] * s + cy[k] * c; }
+        cvQuad(xy, CONFETTI[p.color], 255);
+    }
+}
+
+// 14 slow rays around (cx, cy), fading outward; the angle and distance of each pixel are worked out once
+static void drawRays(float cx, float cy, float t, float a)
+{
+    enum { N = 14, STEPS = 1024 };
+    static u16 ang[CV_H][CV_W];
+    static u16 dist[CV_H][CV_W];
+    static float atX = -1, atY = -1;
+    if (atX != cx || atY != cy) {
+        atX = cx; atY = cy;
+        for (int y = 0; y < CV_H; y++)
+            for (int x = 0; x < CV_W; x++) {
+                float dx = x + 0.5f - cx, dy = y + 0.5f - cy, an = atan2f(dy, dx);
+                ang[y][x] = (u16)((int)((an < 0 ? an + 2 * (float)M_PI : an) / (2 * (float)M_PI) * STEPS) % STEPS);
+                dist[y][x] = (u16)fminf(65535, sqrtf(dx * dx + dy * dy));
+            }
+    }
+    static u8 lit[STEPS];
+    float turn = t * 0.12f / (2 * (float)M_PI) * STEPS, per = (float)STEPS / N, wide = per / 2 * 0.55f;
+    for (int i = 0; i < STEPS; i++) { float p = fmodf(i - turn + STEPS * 4, per); lit[i] = p < wide; }
+    int a0 = (int)(70 * a);
+    for (int y = 0; y < CV_H; y++)
+        for (int x = 0; x < cvW; x++)
+            if (lit[ang[y][x]] && dist[y][x] < CV_W) cvPut(x, y, 0xF2A33A, a0 * (CV_W - dist[y][x]) / CV_W);
+}
+
+static void cardLadder(char *out, size_t cap)
+{
+    const char *where = "Played offline: not on a ladder";
+    char res[160];
+    if (daily) where = smzDailyResult(res, sizeof res) ? res : "Sending the time ...";
+    else if (curSlot >= 0 && smzOnlineSlotKind(curSlot)) where = "The time goes to the ladder";
+    snprintf(out, cap, "%s", where);
+}
+
+static void cardRender()
+{
+    float t = cardT(), dt = fminf(0.05f, fmaxf(0, t - cardLastT));
+    cardLastT = t;
+    cvW = settings3DS.GameScreenWidth < CV_W ? settings3DS.GameScreenWidth : CV_W;
+    memset(cv, 0, sizeof cv);
+    float mx = cvW / 2.0f, cw = 300, ch = 150, cy0 = (CV_H - ch) / 2;
+    float pop = backOut((t - T_CARD) / 0.45f), cy = cy0 + (1 - pop) * 20, in = clamp01((t - T_CARD) / 0.3f);
+
+    cvRect(0, 0, cvW, CV_H, 0x000000, (int)(185 * clamp01(t / 0.3f)));
+    if (t >= T_CARD) drawRays(mx, cy0 + 40, t, in * (0.7f + 0.3f * sinf(t * 2.2f)));
+    if (t >= T_TITLE && t < T_LAND && frand() < 0.25f) rain();
+    if (t >= T_LAND && frand() < 0.4f) rain();
+    drawParts(dt);   // behind the card, so the numbers stay readable
+
+    // the card, dropping in with a little overshoot
+    float glow = 0.5f + 0.5f * sinf(t * 3.4f), sc = 0.86f + 0.14f * pop, w = cw * sc, h = ch * sc, x = mx - w / 2, y = cy + (ch - h) / 2;
+    if (in > 0) {
+        cvRect(x - 2, y - 2, x + w + 2, y + h + 2, 0xF2A33A, (int)((80 + 110 * glow) * in));
+        cvRect(x, y, x + w, y + h, 0x10161F, (int)(255 * in));
+        cvRect(x, y, x + w, y + 1, 0xFFE07A, (int)(255 * in));
+    }
+
+    // the title, letter by letter
+    const char *title = daily ? "CHALLENGE COMPLETE" : "RUN COMPLETE";
+    int th = 17, tw = ui3dsGetStringWidth(title, 0, 0xffff, th);
+    float tx = mx - tw / 2.0f;
+    for (int i = 0; title[i]; i++) {
+        char one[2] = {title[i], 0};
+        float lp = clamp01((t - T_TITLE - i * 0.035f) / 0.22f), ls = 1 + 0.9f * (1 - backOut(lp));
+        int lx = i ? ui3dsGetStringWidth(title, 0, i - 1, th) : 0, lw = ui3dsGetStringWidth(one, 0, 0xffff, th), lh = (int)(th * ls + 0.5f);
+        if (lp > 0 && title[i] != ' ') cvText(tx + lx + lw / 2.0f, cy + 10 - (lh - th) / 2.0f, lh, 0xF2A33A, (int)(255 * lp), one, 1);
+    }
+
+    // the final time counting up, then a punch, a ring and the fanfare when it lands
+    if (t >= T_LAND && !cardBurst) { cardBurst = true; burst(mx - 122, cy + 50, 60, 300); burst(mx + 122, cy + 50, 60, 300); }
+    char ts[40];
+    fmtTime(t >= T_LAND ? cardMs : (int64_t)(cardMs * easeOut((t - T_COUNT) / (T_LAND - T_COUNT))), ts, sizeof ts);
+    float punch = t >= T_LAND ? 1 + 0.18f * expf(-(t - T_LAND) * 7) : 1;
+    int nh = (int)(26 * punch + 0.5f);
+    if (t >= T_COUNT) cvText(mx, cy + 36 - (nh - 26) / 2.0f, nh, 0xE8ECF2, (int)(255 * clamp01((t - T_COUNT) / 0.2f)), ts, 1);
+    if (t >= T_LAND && t < T_LAND + 0.7f) {
+        float rp = (t - T_LAND) / 0.7f;
+        cvRing(mx, cy + 49, 20 + 100 * easeOut(rp), 2 * (1 - rp) + 1, 0xFFE07A, (int)(200 * (1 - rp)));
+    }
+    if (t >= T_LAND) {
+        int a = (int)(255 * clamp01((t - T_LAND) / 0.4f));
+        char lad[160];
+        cardLadder(lad, sizeof lad);
+        cvText(mx, cy + 70, 13, 0x8793A6, a, runName, 1);
+        cvText(mx, cy + 88, 13, daily || (curSlot >= 0 && smzOnlineSlotKind(curSlot)) ? 0x4FC3F7 : 0x8793A6, a, lad, 1);
+    }
+    if (t >= T_BUTTONS) {
+        int a = (int)(255 * clamp01((t - T_BUTTONS) / 0.3f));
+        float by = cy + ch - 26 + (1 - easeOut((t - T_BUTTONS) / 0.3f)) * 4;
+        int w1 = 18 + ui3dsGetStringWidth("Main menu"), w2 = 18 + ui3dsGetStringWidth("Watch the credits"), bx = (int)(mx - (w1 + 24 + w2) / 2.0f);
+        cvButton(bx, by, "A", "Main menu", a);
+        cvButton(bx + w1 + 24, by, "B", "Watch the credits", a);
+    }
+    if (t < 0.35f) cvRect(0, 0, cvW, CV_H, 0xFFFAEB, (int)(150 * (1 - t / 0.35f)));
+}
+
+static bool cardTexReady, cardTexFailed;
+static u16 *cardUpload;
+
+void smz3CardSync(void)
+{
+    if (cardState != 1 || !smz3IsRun() || cardTexFailed) return;
+    static int frame;
+    if (++frame & 1 && cardTexReady) return;   // the layer moves at 30 fps
+    SGPUTexture *texture = &GPU3DS.textures[UI_SMZ3_CARD];
+    if (!cardTexReady) {
+        cardUpload = (u16 *)linearAlloc(512 * 256 * 2);
+        if (!cardUpload || !C3D_TexInitVRAM(&texture->tex, 512, 256, GPU_RGBA4)) { cardTexFailed = true; return; }
+        texture->id = UI_SMZ3_CARD;
+        C3D_TexSetFilter(&texture->tex, GPU_NEAREST, GPU_NEAREST);
+        texture->scale[3] = 1.0f / texture->tex.width;
+        texture->scale[2] = 1.0f / texture->tex.height;
+        texture->scale[1] = texture->scale[0] = 0;
+        cardTexReady = true;
+    }
+    cardRender();
+    for (int y = 0; y < CV_H; y++) {
+        u16 *d = cardUpload + y * 512;
+        for (int x = 0; x < CV_W; x++) { const u8 *s = cv[y][x]; d[x] = (u16)((s[0] >> 4) << 12 | (s[1] >> 4) << 8 | (s[2] >> 4) << 4 | s[3] >> 4); }
+    }
+    C3D_Tex *tex = &texture->tex;
+    GSPGPU_FlushDataCache(cardUpload, tex->size);
+    C3D_SyncDisplayTransfer((u32 *)cardUpload, GX_BUFFER_DIM(tex->width, tex->height), (u32 *)tex->data, GX_BUFFER_DIM(tex->width, tex->height),
+        GX_TRANSFER_OUT_TILED(1) | GX_TRANSFER_FLIP_VERT(1) | GX_TRANSFER_IN_FORMAT(tex->fmt) | GX_TRANSFER_OUT_FORMAT(tex->fmt));
+}
+
+void smz3CardDraw(float xOffset)
+{
+    if (cardState != 1 || !cardTexReady || !smz3IsRun()) return;
+    float x0 = (settings3DS.GameScreenWidth - cvW) / 2.0f + xOffset;
+    gpu3dsAddSimpleQuadVertexes(x0, 0, x0 + cvW, CV_H, 0, 0, cvW, CV_H, 0, 0xFFFFFFFF);
+    SVertexList *list = &GPU3DS.vertices[VBO_SCREEN];
+    GPU3DS.currentRenderState.textureBind = UI_SMZ3_CARD;
+    GPU3DS.currentRenderState.textureEnv = TEX_ENV_MODULATE_COLOR;
+    GPU3DS.currentRenderState.alphaBlending = ALPHA_BLENDING_ENABLED;
+    gpu3dsDraw(list, NULL, list->count);
+}
+
+// this screen while the card is up: the details one by one, then the two ways on
+#define CARD_BTN_Y 196
+static int fadeTo(int rgb, float a, int bg = 0x0B0F15)
+{
+    a = clamp01(a);
+    int r = (int)(((bg >> 16) & 255) + (((rgb >> 16) & 255) - ((bg >> 16) & 255)) * a), g = (int)(((bg >> 8) & 255) + (((rgb >> 8) & 255) - ((bg >> 8) & 255)) * a);
+    int b = (int)((bg & 255) + ((rgb & 255) - (bg & 255)) * a);
+    return r << 16 | g << 8 | b;
+}
+
+static void drawCardDetails()
+{
+    float t = cardT();
+    fill(0, 0, 320, 240, 0x0B0F15);
+    const char *title = daily ? "CHALLENGE COMPLETE" : "RUN COMPLETE";
+    int tw = ui3dsGetStringWidth(title, 0, 0xffff, 20);
+    bigText((320 - tw) / 2, 8, 20, 0xF2A33A, title);
+    fill(40, 33, 280, 34, 0x2A3442);
+    unsigned all = cardZ + cardM, allTotal = cardZT + cardMT;
+    for (int r = 0; r < CARD_ROWS; r++) {
+        float rt = t - T_ROWS - r, rp = easeOut(rt / 0.35f), fillP = easeOut(rt / 0.7f);
+        if (rt < 0) continue;
+        int y = 44 + r * 36 + (int)((1 - rp) * 10), dim = fadeTo(0x8793A6, rp), txt = fadeTo(0xE8ECF2, rp);
+        char v[64];
+        if (r == 0) {
+            text(16, y + 5, dim, "TIME");
+            fmtTime((int64_t)(cardMs * fillP), v, sizeof v);
+            int w = ui3dsGetStringWidth(v, 0, 0xffff, 20);
+            bigText(304 - w, y, 20, txt, v);
+        } else if (r == 1) {
+            text(16, y + 5, dim, "COMPLETION");
+            snprintf(v, sizeof v, "%d%%", (int)(pct(all, allTotal) * fillP + 0.5f));
+            int w = ui3dsGetStringWidth(v, 0, 0xffff, 20);
+            bigText(304 - w, y, 20, fadeTo(0xFFE07A, rp), v);
+        } else {
+            unsigned got = r == 2 ? cardZ : cardM, of = r == 2 ? cardZT : cardMT;
+            text(16, y, dim, r == 2 ? "ZELDA" : "METROID");
+            snprintf(v, sizeof v, "%u/%u   %d%%", got, of, pct(got, of));
+            text(304, y, txt, v, HALIGN_RIGHT);
+            fill(16, y + 17, 304, y + 23, fadeTo(0x1D2430, rp));
+            int bw = (int)(288 * fillP * (of ? (float)got / of : 0));
+            if (bw > 0) fill(16, y + 17, 16 + bw, y + 23, fadeTo(r == 2 ? 0x5BD46A : 0xFF8A3D, rp));
+        }
+    }
+    if (t >= T_BUTTONS && cardState != 1) {   // the credits: one way out
+        float bp = easeOut((t - T_BUTTONS) / 0.3f);
+        int y = CARD_BTN_Y + (int)((1 - bp) * 6);
+        fill(80, y, 240, y + 32, fadeTo(0xF2A33A, bp));
+        text(80, y + 9, fadeTo(0x10161F, bp, fadeTo(0xF2A33A, bp)), "Back to menu", HALIGN_CENTER, 240);
+    } else if (t >= T_BUTTONS) {
+        float bp = easeOut((t - T_BUTTONS) / 0.3f);
+        int y = CARD_BTN_Y + (int)((1 - bp) * 6);
+        fill(12, y, 156, y + 32, fadeTo(0xF2A33A, bp));
+        text(12, y + 9, fadeTo(0x10161F, bp, fadeTo(0xF2A33A, bp)), "Main menu", HALIGN_CENTER, 156);
+        fill(164, y, 308, y + 32, fadeTo(0x1D2430, bp));
+        fill(164, y, 308, y + 1, fadeTo(0x4A5568, bp));
+        text(164, y + 9, fadeTo(0xE8ECF2, bp), "Watch the credits", HALIGN_CENTER, 308);
+    }
+}
