+static void drawItems(int y0, int y1)
+{
+    const int cols = 9;
+    int n = smz3_inventory_count < SMZ_TRK_MAX_INV ? (int)smz3_inventory_count : SMZ_TRK_MAX_INV, rows = (n + cols - 1) / cols;
+    int cell = (y1 - y0 - 6) / rows;
+    if (cell > 34) cell = 34;
+    int left = (320 - cell * cols) / 2, top = y0 + (y1 - y0 - cell * rows) / 2;
+    for (int i = 0; i < n; i++) {
+        const smz3_inv_item &it = smz3_inventory_items[i];
+        int cx = left + i % cols * cell, cy = top + i / cols * cell, level = trk.started ? trk.inventory[i] : 0;
+        fill(cx + 1, cy + 1, cx + cell - 1, cy + cell - 1, theme.panel);
+        drawIcon(getIcon(it.icon), cx + 2, cy + 2, cell - 4, cell - 4, level > 0 ? 256 : 52);
+        if (level > 0 && (countedItem(it.name) || (levelItem(it.name) && level > 1))) {
+            char s[12];
+            snprintf(s, sizeof s, "%d", level);
+            text(cx + cell - 1, cy + cell - 14, 0x000000, s, HALIGN_RIGHT);
+            text(cx + cell - 2, cy + cell - 15, theme.text, s, HALIGN_RIGHT);
