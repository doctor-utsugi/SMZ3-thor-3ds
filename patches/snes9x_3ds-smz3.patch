+/* The menu's wallpaper, also what covers a screen change: dark, with spores rising like in Brinstar (NativeMenuScreen.kt).
+ * Only from left[row] rightwards on each 2-pixel row when left is given. */
+static void fillDisc(float cx, float cy, float r, int color, float alpha = 1.0f);
+
+static void drawBackdrop(const int *left = NULL)
+{
+    struct Spore { float x, y, speed, size, sway; int color; };
+    static Spore spores[42];
+    static bool made;
+    if (!made) {
+        unsigned seed = 11;
+        auto rnd = [&seed]() { seed = seed * 1664525u + 1013904223u; return (seed >> 8) / 16777216.0f; };
+        for (Spore &s : spores) {
+            s.x = rnd(); s.y = rnd(); s.speed = 1 + (int)(rnd() * 3); s.size = rnd(); s.sway = 1 + (int)(rnd() * 4);
+            s.color = rnd() < 0.5f ? 0x4CC38A : 0x4FC3F7;
+        }
+        made = true;
+    }
+    for (int y = 0; y < 240; y += 2) {
+        int c = 0x0A0E15, x0 = left ? left[y / 2] : 0;
+        if (x0 >= UI_W) continue;
+        if (y < 90) { float f = 1 - y / 90.0f; c = mixC(c, 0x2A2112, f * f * 0.9f); }
+        else if (y >= 170) { float f = (y - 170) / 70.0f; c = mixC(c, 0x0F2A2C, f * f * 0.8f); }
+        ui3dsDrawRect(x0, y, UI_W, y + 2, c);
+        for (int i = 0; i <= 20; i++) {   // faint blue columns, strongest in the middle
+            float d = fabsf(i * 16 - 160) / 160.0f;
+            if (i * 16 >= x0) ui3dsDrawRect(i * 16, y, i * 16 + 1, y + 2, 0x4FC3F7, 0.05f * (1 - d * d));
+        }
+    }
+    float drift = (float)(osGetTime() % 60000) / 60000.0f;
+    for (const Spore &s : spores) {   // whole laps and sways per loop, so the loop restarts without a jump
+        float y = 1 - fmodf(s.y + drift * s.speed, 1.0f);
+        float x = s.x * UI_W + sinf((drift * s.sway + s.y) * 6.2831853f) * 9;
+        int row = (int)(y * UI_H) / 2;
+        if (left && (row < 0 || row >= 120 || x < left[row] + 6)) continue;
+        float fade = fminf(1, fminf(y * 6, (1 - y) * 6)), r = 0.6f + 0.9f * s.size;
+        fillDisc(x, y * UI_H, r * 4, s.color, 0.07f * fade);
+        fillDisc(x, y * UI_H, r < 1 ? 1 : r, s.color, (0.25f + 0.4f * s.size) * fade);
+    }
+}
