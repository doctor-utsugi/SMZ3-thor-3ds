+static bool isBase(const unsigned char *rom, size_t len, bool *isSm)
+{
+    if (len == 0x300200 || len == 0x100200) { rom += 0x200; len -= 0x200; }
+    if (len != 0x300000 && len != 0x100000) return false;
+    char title[22];
+    memcpy(title, rom + 0x7FC0, 21);
+    title[21] = 0;
+    for (char *p = title; *p; p++) if (*p >= 'a' && *p <= 'z') *p -= 32;
+    *isSm = strstr(title, "METROID") != NULL;
+    return *isSm ? len == 0x300000 : (strstr(title, "ZELDA") != NULL && len == 0x100000);
+}
+
+static char wrongRom[48];   // set when a base ROM was found but it is not the revision the patches need
+
+// Finds the user's own Super Metroid and ALttP ROMs in the usual folders. Returns headerless copies (malloc). Only the exact
+// revisions the patches were written for are taken: with another A Link to the Past revision the patched Zelda code is
+// misaligned and the game crashes when Samus enters a portal.
+static bool findBaseRoms(unsigned char **sm, unsigned char **z3)
+{
+    wrongRom[0] = 0;
+    static const char *dirs[] = {SMZ_DIR "/base", "sdmc:/roms/snes", "sdmc:/roms", "sdmc:/ROMs", "sdmc:/"};
+    *sm = *z3 = NULL;
+    // keeps a copy of the image when it is one of the two exact revisions the patches were written for
+    auto offer = [&](const unsigned char *b, size_t len) {
+        bool sm_ = false;
+        if (!isBase(b, len, &sm_)) return;
+        size_t off = (len & 0x1FF) ? 0x200 : 0;
+        unsigned char **slot = sm_ ? sm : z3;
+        char md5[33];
+        smz_md5_hex(b + off, len - off, md5);
+        if (strcmp(md5, sm_ ? SMZ_MD5_SM : SMZ_MD5_Z3)) {
+            if (!wrongRom[0]) snprintf(wrongRom, sizeof wrongRom, sm_ ? "Super Metroid ROM must be (JU), md5 21f3e98d" : "ALttP ROM must be Japanese v1.0 (03a63945)");
+        } else if (!*slot) { *slot = (unsigned char *)malloc(len - off); memcpy(*slot, b + off, len - off); }
+    };
+    for (const char *d : dirs) {
+        DIR *dir = opendir(d);
+        if (!dir) continue;
+        while (struct dirent *e = readdir(dir)) {
+            if (e->d_type == DT_DIR) continue;
+            char path[PATH_MAX];
+            snprintf(path, sizeof path, "%s/%s", d, e->d_name);
+            struct stat st;
+            if (stat(path, &st)) continue;
+            bool rom = st.st_size == 0x300000 || st.st_size == 0x300200 || st.st_size == 0x100000 || st.st_size == 0x100200;
+            bool zip = st.st_size > 1000 && st.st_size < 0x500000 && strlen(e->d_name) > 4 && !strcasecmp(e->d_name + strlen(e->d_name) - 4, ".zip");
+            if (!rom && !zip) continue;
+            size_t len;
+            unsigned char *b = readFile(path, &len);
+            if (b && rom) offer(b, len);
+            else if (b && smz_is_zip(b, len)) {
+                for (int i = 0;; i++) {
+                    size_t k;
+                    unsigned char *img = smz_zip_entry(b, len, i, &k);
+                    if (!img) break;
+                    offer(img, k);
+                    free(img);
+                }
+            }
+            free(b);
+        }
+        closedir(dir);
+        if (*sm && *z3) return true;
+    }
+    return *sm && *z3;
+}
+
+static int listSprites(const char *dir, char names[][32], int max)
+{
+    int n = 0;
+    DIR *d = opendir(dir);
+    if (!d) return 0;
+    while (struct dirent *e = readdir(d)) {
+        size_t l = strlen(e->d_name);
+        if (l > 4 && l < 36 && !strcasecmp(e->d_name + l - 4, ".rdc") && n < max) { memcpy(names[n], e->d_name, l - 4); names[n][l - 4] = 0; n++; }
+    }
+    closedir(d);
+    return n;
+}
