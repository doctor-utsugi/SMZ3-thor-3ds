     return nullptr;
 }
 
+JNIEXPORT jboolean JNICALL Java_com_swordfish_libretrodroid_LibretroDroid_writeMemory(
+    JNIEnv* env,
+    jclass obj,
+    jint id,
+    jint offset,
+    jbyteArray bytes
+) {
+    try {
+        jsize length = env->GetArrayLength(bytes);
+        jbyte* data = env->GetByteArrayElements(bytes, nullptr);
+        bool ok = LibretroDroid::getInstance().writeMemory(id, offset, (const int8_t*) data, length);
+        env->ReleaseByteArrayElements(bytes, data, JNI_ABORT);
+        return ok;
+
+    } catch (std::exception &exception) {
+        LOGE("Error in writeMemory: %s", exception.what());
+        JavaUtils::throwRetroException(env, ERROR_SERIALIZATION);
+    }
+
+    return false;
+}
+
+JNIEXPORT jbyteArray JNICALL Java_com_swordfish_libretrodroid_LibretroDroid_readMemory(
+    JNIEnv* env,
+    jclass obj,
+    jint id,
+    jint offset,
+    jint length
+) {
+    try {
+        auto data = LibretroDroid::getInstance().readMemory(id, offset, length);
+
+        jbyteArray result = env->NewByteArray(data.size());
+        env->SetByteArrayRegion(result, 0, data.size(), (jbyte *) data.data());
+
+        return result;
+
+    } catch (std::exception &exception) {
+        LOGE("Error in readMemory: %s", exception.what());
+        JavaUtils::throwRetroException(env, ERROR_SERIALIZATION);
+    }
+
+    return nullptr;
+}
