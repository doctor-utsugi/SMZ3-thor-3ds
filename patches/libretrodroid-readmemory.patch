+std::vector<int8_t> LibretroDroid::readMemory(unsigned id, size_t offset, size_t length) {
+    std::lock_guard<std::mutex> lock(coreLock);
+
+    size_t size = core->retro_get_memory_size(id);
+    auto* data = (int8_t*) core->retro_get_memory_data(id);
+
+    if (data == nullptr || offset >= size) {
+        return {};
+    }
+
+    length = std::min(length, size - offset);
+    return std::vector<int8_t>(data + offset, data + offset + length);
+}
+
+bool LibretroDroid::writeMemory(unsigned id, size_t offset, const int8_t* bytes, size_t length) {
+    std::lock_guard<std::mutex> lock(coreLock);
+
+    size_t size = core->retro_get_memory_size(id);
+    auto* data = (int8_t*) core->retro_get_memory_data(id);
+
+    if (data == nullptr || offset >= size || length > size - offset) {
+        return false;
+    }
+
+    std::copy(bytes, bytes + length, data + offset);
+    return true;
+}
